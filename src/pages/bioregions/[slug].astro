---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";

export async function getStaticPaths() {
  const all = await getCollection("bioregions");
  return all.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as any;
const data = entry.data;

// Use the dedicated short narrative from Notion when available.
const bioDescription = data.shortNarrative || data.intro;
---

<BaseLayout title={`${data.name} — BWL portfolio`}>
  <a class="back-link" href={import.meta.env.BASE_URL} aria-label="Back to all bioregions">← All bioregions</a>
  <FlowDiagram
    bioregionName={data.name}
    bioregionDescription={bioDescription}
    bioregionCountry={data.country}
    bioregionImageUrl={data.imageUrl}
    bioregionImageFile={data.imageFile}
    shifts={data.criticalShifts}
    innovations={data.systemicInnovations}
  />
</BaseLayout>

<style>
  .back-link {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
    color: var(--bwl-primary);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(32, 64, 79, 0.12);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .back-link:hover {
    background: var(--bwl-primary);
    color: #fff;
    border-color: var(--bwl-primary);
  }
</style>
