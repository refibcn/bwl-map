---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";

export async function getStaticPaths() {
  const all = await getCollection("bioregions");
  return all.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as any;
const data = entry.data;

// Short, display-friendly bioregion descriptions (1–2 lines in the diagram).
// Fallback to the full Notion intro if no override is defined yet.
const shortDescriptions: Record<string, string> = {
  "oltenia-ro":
    "Carpathian foothills weaving culture and ecosystems.",
  "oltenia-de-sub-munte":
    "Carpathian foothills weaving culture and ecosystems.",
};
// Match by route slug or name for resilience.
const bioDescription =
  shortDescriptions[data.slug] ||
  shortDescriptions[data.name?.toLowerCase().replace(/\s+/g, "-")] ||
  data.intro;
---

<BaseLayout title={`${data.name} — BWL portfolio`}>
  <FlowDiagram
    bioregionName={data.name}
    bioregionDescription={bioDescription}
    shifts={data.criticalShifts}
    innovations={data.systemicInnovations}
  />
</BaseLayout>
