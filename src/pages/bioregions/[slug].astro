---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";

export async function getStaticPaths() {
  const all = await getCollection("bioregions");
  return all.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as any;
const data = entry.data;

// Use the dedicated short narrative from Notion when available.
const bioDescription = data.shortNarrative || data.intro;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout title={`${data.name} — BWL portfolio`}>
  <a class="back-link" href={base} aria-label="Back to the map">← Bioregions</a>
  <nav class="view-switch" aria-label="Layout view">
    <a class="active" href={`${base}bioregions/${data.slug}/`}>Horizontal</a>
    <a href={`${base}bioregions/${data.slug}/vertical/`}>Vertical</a>
  </nav>
  <FlowDiagram
    bioregionName={data.name}
    bioregionSlug={data.slug}
    bioregionDescription={bioDescription}
    bioregionCountry={data.country}
    bioregionImageUrl={data.imageUrl}
    bioregionImageFile={data.imageFile}
    shifts={data.criticalShifts}
    innovations={data.systemicInnovations}
  />
</BaseLayout>

<style>
  .back-link {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
    color: var(--bwl-primary);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(32, 64, 79, 0.12);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .back-link:hover {
    background: var(--bwl-primary);
    color: #fff;
    border-color: var(--bwl-primary);
  }

  .view-switch {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 20;
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    box-shadow: 0 1px 4px rgba(32, 64, 79, 0.12);
    font-family: var(--font-body);
  }
  .view-switch a {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-strong);
    padding: 6px 12px;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .view-switch a:hover { background: rgba(32, 64, 79, 0.08); }
  .view-switch a.active {
    background: var(--bwl-primary);
    color: #fff;
  }
</style>
