---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CriticalShiftsMap from "../../components/CriticalShiftsMap.astro";
import { buildShiftPages } from "../../lib/shift-pages";

const [bioEntries, shiftEntries] = await Promise.all([
  getCollection("bioregions"),
  getCollection("shifts"),
]);
const shifts = buildShiftPages(
  bioEntries.map((b) => b.data),
  shiftEntries.map((s) => s.data)
);
---

<BaseLayout title="Critical shifts — BWL Map">
  <main>
    <CriticalShiftsMap shifts={shifts} />
  </main>
</BaseLayout>

<style is:global>
  /* Full-bleed landscape: keep the page background the same sky colour as the
     illustration so overscroll / browser zoom never reveals white around it. */
  body { background: #a9d5d4; }
</style>
