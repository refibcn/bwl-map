---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShiftDiagram from "../../components/ShiftDiagram.astro";
import { buildShiftPages } from "../../lib/shift-pages";

export async function getStaticPaths() {
  const [bioEntries, shiftEntries] = await Promise.all([
    getCollection("bioregions"),
    getCollection("shifts"),
  ]);
  const shifts = buildShiftPages(
    bioEntries.map((b) => b.data),
    shiftEntries.map((s) => s.data)
  );
  return shifts.map((s) => ({
    params: { slug: s.slug },
    props: { shift: s },
  }));
}

const { shift } = Astro.props as any;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout title={`${shift.name} — Critical shift`}>
  <a class="back-link" href={`${base}critical-shifts/`} aria-label="Back to all critical shifts">← Critical shifts</a>
  <nav class="view-switch" aria-label="Layout view">
    <a class="active" href={`${base}critical-shifts/${shift.slug}/`}>Horizontal</a>
    <a href={`${base}critical-shifts/${shift.slug}/vertical/`}>Vertical</a>
  </nav>
  <ShiftDiagram shift={shift} bioregions={shift.bioregions} innovations={shift.innovations} />
  {shift.bioregions.length === 0 && (
    <p class="empty-note">
      No published systemic innovations for this critical shift yet — the page will fill in as bioregions link their work.
    </p>
  )}
</BaseLayout>

<style>
  .back-link {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
    color: var(--bwl-primary);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(32, 64, 79, 0.12);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .back-link:hover {
    background: var(--bwl-primary);
    color: #fff;
    border-color: var(--bwl-primary);
  }

  .view-switch {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 20;
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    box-shadow: 0 1px 4px rgba(32, 64, 79, 0.12);
    font-family: var(--font-body);
  }
  .view-switch a {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-strong);
    padding: 6px 12px;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .view-switch a:hover { background: rgba(32, 64, 79, 0.08); }
  .view-switch a.active {
    background: var(--bwl-primary);
    color: #fff;
  }

  .empty-note {
    max-width: 1080px;
    margin: 2rem auto 0;
    padding: 0 1.5rem;
    text-align: center;
    color: var(--mist);
    font-family: var(--font-body);
    font-size: 14px;
  }
</style>
