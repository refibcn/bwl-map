---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EuropeMap from "../components/EuropeMap.astro";
import { buildMapRegions } from "../lib/map-regions";

const all = await getCollection("bioregions");
const regions = buildMapRegions(all.map((b) => b.data));
---

<BaseLayout title="BWL Map — Bioregions of Europe">
  <main>
    <EuropeMap regions={regions} />
  </main>
</BaseLayout>

<style is:global>
  /* The landing is all-ocean: keep the page background blue so overscroll /
     browser zoom never reveals white around the map. */
  body { background: #8da5af; }
</style>
