---
import BaseLayout from "../layouts/BaseLayout.astro";
import RidgeLine from "../components/RidgeLine.astro";

const bioregions = [
  { name: "Oltenia de Sub Munte", country: "Romania", href: "bioregions/oltenia-de-sub-munte", ready: true },
  { name: "Living Delta", country: "Netherlands", ready: false },
  { name: "Colina", country: "France", ready: false },
  { name: "Laconia", country: "Greece", ready: false },
  { name: "Vistula River", country: "Poland", ready: false },
  { name: "Cilento", country: "Italy", ready: false },
];
---

<BaseLayout title="BWL Map">
  <div class="wrap" style="padding-top:4rem;padding-bottom:5rem">
    <p class="eyebrow">Bioregional Weaving Labs</p>
    <h1 style="font-size:36px;margin:0.5rem 0 1.5rem">Portfolio map</h1>
    <RidgeLine variant={1} />
    <div style="margin-top:2rem;display:grid;gap:10px">
      {bioregions.map((b) => (
        b.ready ? (
          <a class="innovation-card" href={b.href} style="display:flex;justify-content:space-between;align-items:center">
            <span class="name" style="margin:0">{b.name}</span>
            <span style="font-size:13px;color:var(--ink-soft)">{b.country}</span>
          </a>
        ) : (
          <div class="innovation-card untagged" style="display:flex;justify-content:space-between;align-items:center">
            <span class="name" style="margin:0">{b.name}</span>
            <span class="badge" style="background:var(--stone-deep);color:var(--ink-soft)">Coming soon</span>
          </div>
        )
      ))}
    </div>
  </div>
</BaseLayout>
