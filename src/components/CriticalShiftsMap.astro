---
/**
 * Critical shifts landing — full-screen illustrated landscape with the
 * critical shifts positioned as clickable pills on the element of the scene
 * they relate to (coordinates from data/critical-shift-positions.json), plus
 * a permanent left side panel listing every shift (it cannot be closed).
 */
import positionsData from "../data/critical-shift-positions.json";
import { normalizeName } from "../data/map-positions";
import { shiftColor } from "../lib/shift-pages";
import type { ShiftPageData } from "../lib/shift-pages";

interface Props {
  shifts: ShiftPageData[];
}
const { shifts } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";

type ShiftPosition = (typeof positionsData.positions)[number];

// Position lookup by slug first, then by normalized name, so markers survive
// slug/name drift between Notion and the positions file.
const bySlug = new Map(positionsData.positions.map((p) => [p.slug, p]));
const byName = new Map(positionsData.positions.map((p) => [normalizeName(p.name), p]));
const emojiBySlug = new Map(positionsData.positions.map((p) => [p.slug, p.emoji]));

// Shifts that have a mapped position get a marker on the landscape; the
// panel list still shows every shift.
const positioned = shifts
  .map((shift, i) => ({ shift, i, pos: bySlug.get(shift.slug) ?? byName.get(normalizeName(shift.name)) }))
  .filter((x): x is { shift: ShiftPageData; i: number; pos: ShiftPosition } => x.pos !== undefined);
---

<div class="cs-map" id="csMap">
  <div class="cs-layout">
    <div class="cs-hero-block">
      <p class="cs-eyebrow">Bioregional Weaving Labs</p>
      <h1 class="cs-hero-title hero-title">
        Weaving Communities of Action,<br />
        Rooted in Place
      </h1>
      <p class="hero-intro">
        We weave resilient Communities of Action rooted in their <strong>bioregions</strong>, helping them drive
        <strong>Critical Shifts</strong> — the systemic changes that strengthen the ecological, social, cultural,
        and economic fabric of a place.
      </p>
    </div>

    <div class="cs-toggle-block">
      <div class="cs-divider"></div>
      <nav class="view-toggle-big" aria-label="Views">
        <a href={base}>Bioregions</a>
        <a class="active" href={`${base}critical-shifts/`}>Critical shifts</a>
      </nav>
    </div>

    <div class="cs-stage-col">
      <div class="cs-stage" data-image-ratio={positionsData.image.width / positionsData.image.height}>
        <img
          class="cs-landscape"
          src={`${base}critical-shifts-landscape.png`}
          alt="Illustrated bioregional landscape with critical shift markers on the features they relate to"
          draggable="false"
        />
        <div class="cs-markers">
          {positioned.map(({ shift: s, pos, i }) => (
            <a
              class="cs-marker"
              href={`${base}critical-shifts/${s.slug}/`}
              style={`--i:${i};--z:${3 + Math.round(pos.y / 10)};--accent:${shiftColor(s.slug)}`}
              data-ix={pos.x}
              data-iy={pos.y}
              title={s.name}
              aria-label={s.name}
            >
              <span class="cs-marker-circle" aria-hidden="true">{s.emoji ?? pos.emoji}</span>
              <span class="cs-marker-label">{s.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="cs-list-block">
      <div class="cs-list-wrap">
        <div class="cs-list">
          {shifts.map((s) => (
            <a class="cs-row" href={`${base}critical-shifts/${s.slug}/`} style={`--accent:${shiftColor(s.slug)}`}>
              <span class="cs-row-emoji" aria-hidden="true">{s.emoji ?? emojiBySlug.get(s.slug) ?? ""}</span>
              <span class="cs-row-main">
                <span class="cs-row-name">{s.name}</span>
                <span class="cs-row-desc">{s.shift}</span>
              </span>
              <span class="cs-row-count">
                {s.bioregions.length} {s.bioregions.length === 1 ? "bioregion" : "bioregions"}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const map = document.getElementById("csMap");

  function play() {
    map?.classList.add("is-loaded");
  }
  if (document.readyState === "complete") requestAnimationFrame(play);
  else window.addEventListener("load", () => requestAnimationFrame(play));

  // ---- marker glue: pin markers to a fixed spot IN THE IMAGE, not the
  // stage box. The stage fills its column edge-to-edge (item 10) using
  // object-fit:cover, which crops the image whenever the stage's aspect
  // ratio differs from the image's own — so a marker positioned by simple
  // %-of-stage would visibly drift off its intended scene feature as the
  // viewport is resized. Instead each marker stores its position as a
  // percentage of the FULL image (data-ix/data-iy), and this script
  // converts that into the correct %-of-stage position given the current
  // cover-crop window, exactly like a real cover-fit background image. */
  const stage = document.querySelector<HTMLElement>(".cs-stage");
  const markers = document.querySelectorAll<HTMLElement>(".cs-marker");
  const imageRatio = Number(stage?.dataset.imageRatio) || 1;

  function placeMarkers() {
    if (!stage || !markers.length) return;
    const rect = stage.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const stageRatio = rect.width / rect.height;

    // Fraction of the image's own width/height that's actually visible
    // inside the stage once object-fit:cover crops it, and how far that
    // visible window is inset from each edge (symmetric — object-position
    // is centered).
    // Always fit to width — the full image is visible left-to-right; height
    // is derived from its own aspect ratio and centered vertically, so a
    // tall/narrow stage crops (or letterboxes) top/bottom instead of ever
    // cropping the sides. (Unlike a real cover-fit, this never switches to
    // fitting by height.)
    const visibleW = 1;
    const visibleH = imageRatio / stageRatio;
    const cropLeft = 0;
    const cropTop = (1 - visibleH) / 2;

    markers.forEach((m) => {
      const ix = parseFloat(m.dataset.ix || "0") / 100;
      const iy = parseFloat(m.dataset.iy || "0") / 100;
      const x = ((ix - cropLeft) / visibleW) * 100;
      const y = ((iy - cropTop) / visibleH) * 100;
      m.style.setProperty("--x", x.toFixed(3) + "%");
      m.style.setProperty("--y", y.toFixed(3) + "%");
    });
  }
  placeMarkers();
  window.addEventListener("resize", placeMarkers);
  window.addEventListener("load", placeMarkers);
  if (stage) new ResizeObserver(placeMarkers).observe(stage);
</script>

<style>
  .cs-map {
    --cs-sky: #a9d5d4; /* the illustration's sky colour — letterbox blends in */
    --cs-ground: #2c545b; /* the illustration's ground colour — bottom edge blends in */
    --cs-card-bg: #f9f9f3; /* paper-raised */
    --cs-shadow: rgba(20, 40, 30, 0.28);
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    overflow: hidden;
    font-family: var(--font-body);
    background: var(--cs-sky);
  }

  /* Desktop: a 2-column grid — the hero block and the shift list stack in
     the left column (hero on top, list filling the rest and scrolling
     internally), the stage spans all three rows on the right. Using grid
     (not flex) here, specifically so the hero, toggle and list can become
     independent grid areas: on mobile the layout switches to a single flex
     column and re-orders hero → toggle → stage → list, which needs them to
     be separable in the first place. */
  .cs-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 4fr);
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "hero stage" "toggle stage" "list stage";
    width: 100%;
    height: 100%;
  }

  /* Landscape column: the stage fills the whole column edge-to-edge (flush
     right and flush against the side panel); the image is sized to always
     fit its full width, so markers (positioned in % of the stage) stay
     glued to the scene at every size. The source PNG has its own baked-in
     edge feather at the top and bottom, so it does the actual fading —
     the stage background just needs to be the right flat colour behind
     each half (sky behind the top, ground behind the bottom; a hard split,
     no gradient of its own) for that feather to read as a colour fade
     instead of fading to whatever's behind it. Left/right are a hard,
     sharp cut (the source PNG was cropped to remove its feathered
     left/right border). */
  .cs-stage-col {
    grid-area: stage;
    min-width: 0;
    display: flex;
  }
  .cs-stage {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden; /* clips the image when fitting its full width makes it taller than the stage */
    background: linear-gradient(to bottom, var(--cs-sky) 80%, var(--cs-ground) 80%);
  }
  .cs-landscape {
    display: block;
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: auto;
    transform: translateY(-50%);
    user-select: none;
    pointer-events: none;
  }
  /* -------- side panel (left): title, then the view toggle, then the shift
     list — split into three grid areas (see .cs-layout) so mobile can put
     the stage between them. */
  .cs-hero-block {
    grid-area: hero;
    max-width: 520px;
    background: var(--cs-card-bg);
    border-right: 1px solid rgba(32, 64, 79, 0.18);
    padding: 28px 32px 0;
  }
  .cs-toggle-block {
    grid-area: toggle;
    max-width: 520px;
    background: var(--cs-card-bg);
    border-right: 1px solid rgba(32, 64, 79, 0.18);
    padding: 0 32px;
  }
  .cs-list-block {
    grid-area: list;
    max-width: 520px;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--cs-card-bg);
    border-right: 1px solid rgba(32, 64, 79, 0.18);
    padding: 0 32px 32px;
  }
  .cs-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mist);
  }
  .cs-hero-title {
    margin-top: 6px;
  }
  .cs-divider {
    height: 1px;
    background: rgba(32, 64, 79, 0.14);
    margin: 18px 0 16px;
  }
  /* the list scrolls internally so the panel always fits the screen height */
  .cs-list-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    background: rgba(32, 64, 79, 0.05);
    border: 1px solid rgba(32, 64, 79, 0.08);
    border-radius: 14px;
    padding: 14px;
  }
  .cs-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cs-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 10px 12px;
    background: #fff;
    border: 1px solid rgba(32, 64, 79, 0.12);
    border-left: 4px solid var(--accent, var(--bwl-secondary));
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .cs-row:hover {
    border-color: var(--bwl-primary);
    border-left-color: var(--accent, var(--bwl-secondary));
    /* opaque, not translucent — a translucent fill here would let the
       .cs-list-wrap background behind it bleed through instead of giving
       a subtle wash on top of the row's own white */
    background: #f5f6f7;
  }
  .cs-row-emoji {
    flex-shrink: 0;
    font-size: 16px;
    line-height: 1;
  }
  .cs-row-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cs-row-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.25;
    color: #20404f;
  }
  .cs-row-desc {
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 1.35;
    color: var(--mist);
  }
  .cs-row-count {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--mist);
    border: 1px solid rgba(32, 64, 79, 0.15);
    border-radius: 999px;
    padding: 4px 9px;
    white-space: nowrap;
  }

  /* the panel is permanent — it cannot be hidden */

  /* -------- positioned cards on the landscape -------- */
  /* Same marker language as the bioregions map: a colour-ringed circle
     (emoji instead of a photo — shifts don't have one) glued exactly to
     its --x/--y point, with a solid-colour, all-caps name pill underneath.
     The pill never truncates — it always shows the full name. */
  .cs-markers { position: absolute; inset: 0; }
  .cs-marker {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    display: block;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    /* lower markers on the landscape sit above higher ones, like map pins */
    z-index: var(--z, 3);
  }
  .cs-marker:hover,
  .cs-marker:focus-visible { z-index: 60; }

  .cs-marker-circle {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    line-height: 1;
    background: var(--accent, var(--bwl-secondary));
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.9),
      inset 0 2px 3px rgba(255, 255, 255, 0.35),
      0 3px 10px rgba(20, 40, 30, 0.4);
    transition: transform 0.25s ease;
  }
  .cs-marker:hover .cs-marker-circle,
  .cs-marker:focus-visible .cs-marker-circle {
    transform: scale(1.15);
  }

  /* name label pill under each marker — mirrors .bwc-label on the
     bioregions map: solid accent background, white all-caps text, no
     max-width/ellipsis so the full name always shows. */
  .cs-marker-label {
    position: absolute;
    /* the circle's white halo (box-shadow) already reads as ~3px beyond its
       own edge, and hovering grows the circle further — this gap is sized
       so the label only meets the halo once it's grown on hover, not at rest */
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fffff0;
    background: var(--accent, var(--bwl-secondary));
    padding: 4px 7px;
    border-radius: 5px;
    box-shadow: 0 3px 8px rgba(20, 40, 30, 0.28);
    pointer-events: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .cs-marker:hover .cs-marker-label,
  .cs-marker:focus-visible .cs-marker-label {
    box-shadow: 0 6px 14px rgba(20, 40, 30, 0.28);
    transform: translateX(-50%) translateY(1px);
  }

  /* subtle entrance: fade the scene in, pop markers in order. Both start
     visible by default so the page stays fully usable even without JS. */
  .cs-map.is-loaded .cs-stage { animation: cs-fade-in 0.8s ease; }
  .cs-map.is-loaded .cs-marker {
    animation: cs-pop-in 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.4) both;
    animation-delay: calc(0.25s + var(--i) * 0.07s);
  }
  @keyframes cs-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes cs-pop-in {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
    70% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-map * { animation: none !important; }
  }

  /* -------- responsive -------- */
  /* small screens: hero first, then the landscape, then the toggle/list —
     a single flex column with explicit order, so the stage can sit between
     the pieces of what's one continuous panel on desktop. The divider is
     dropped entirely on mobile — the toggle sits close enough under the
     paragraph that it doesn't need one. The stage's aspect-ratio matches
     the (now-cropped) source image exactly, so it's always fully "fitted"
     — no crop, no gap/letterbox above or below (this value must stay in
     sync with EuropeMap.astro's own mobile .bwc-stage aspect-ratio, so both
     maps render at the same height). */
  @media (max-width: 900px) {
    .cs-map { height: auto; min-height: 100dvh; display: block; overflow: visible; }
    .cs-layout { display: flex; flex-direction: column; }
    .cs-hero-block {
      order: 1;
      max-width: none;
      border-right: none;
      padding: 20px 24px 0;
    }
    .cs-toggle-block {
      order: 2;
      max-width: none;
      border-right: none;
      border-bottom: 1px solid rgba(32, 64, 79, 0.18);
      padding: 12px 24px 4px;
    }
    .cs-divider { display: none; }
    .cs-stage-col { order: 3; flex: none; position: relative; width: 100%; }
    .cs-stage { width: 100%; height: auto; aspect-ratio: 956 / 572; }
    .cs-list-block {
      order: 4;
      flex: none;
      max-width: none;
      border-right: none;
      border-top: 1px solid rgba(32, 64, 79, 0.18);
      padding: 16px 24px 24px;
    }
  }

  /* on phones, labels hide and only the emoji circle remains, so the scene
     stays readable */
  @media (max-width: 560px) {
    .cs-marker { width: 36px; height: 36px; }
    .cs-marker-circle { font-size: 16px; }
    .cs-marker-label { display: none; }
  }
</style>
