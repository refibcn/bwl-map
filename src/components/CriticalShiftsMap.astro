---
/**
 * Critical shifts landing — full-screen illustrated landscape with the
 * critical shifts positioned as clickable pills on the element of the scene
 * they relate to (coordinates from data/critical-shift-positions.json), plus
 * a collapsible left side panel listing every shift. Panel behaviour mirrors
 * the bioregion panel on the landing page: open by default, ✕ hides it, a
 * floating "☰ Critical shifts" button brings it back (landscape goes full
 * width while hidden).
 */
import positionsData from "../data/critical-shift-positions.json";
import { normalizeName } from "../data/map-positions";
import { shiftColor } from "../lib/shift-pages";
import type { ShiftPageData } from "../lib/shift-pages";

interface Props {
  shifts: ShiftPageData[];
}
const { shifts } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";

type ShiftPosition = (typeof positionsData.positions)[number];

// Position lookup by slug first, then by normalized name, so markers survive
// slug/name drift between Notion and the positions file.
const bySlug = new Map(positionsData.positions.map((p) => [p.slug, p]));
const byName = new Map(positionsData.positions.map((p) => [normalizeName(p.name), p]));
const emojiBySlug = new Map(positionsData.positions.map((p) => [p.slug, p.emoji]));

// Shifts that have a mapped position get a marker on the landscape; the
// panel list still shows every shift.
const positioned = shifts
  .map((shift, i) => ({ shift, i, pos: bySlug.get(shift.slug) ?? byName.get(normalizeName(shift.name)) }))
  .filter((x): x is { shift: ShiftPageData; i: number; pos: ShiftPosition } => x.pos !== undefined);
---

<div class="cs-map" id="csMap">
  <div class="cs-layout">
    <aside class="cs-panel">
      <button class="cs-close" type="button" aria-label="Hide the critical shifts panel">✕</button>
      <p class="cs-eyebrow">Bioregional Weaving Labs</p>
      <h1 class="cs-hero-title">Critical shifts</h1>
      <p class="cs-hero-subtitle">
        The systemic shifts the portfolio works on — see which bioregions and innovations address each one,
        or tap the landscape.
      </p>
      <div class="cs-divider"></div>
      <h2 class="cs-list-title">All critical shifts ({shifts.length})</h2>
      <div class="cs-list-wrap">
        <div class="cs-list">
          {shifts.map((s) => (
            <a class="cs-row" href={`${base}critical-shifts/${s.slug}/`}>
              <span class="cs-row-emoji" aria-hidden="true">{s.emoji ?? emojiBySlug.get(s.slug) ?? ""}</span>
              <span class="cs-row-name">{s.name}</span>
              <span class="cs-row-count">
                {s.bioregions.length} {s.bioregions.length === 1 ? "bioregion" : "bioregions"}
              </span>
            </a>
          ))}
        </div>
      </div>
    </aside>

    <div class="cs-stage-col">
      <div class="cs-stage" style={`aspect-ratio:${positionsData.image.aspectRatio}`}>
        <img
          class="cs-landscape"
          src={`${base}critical-shifts-landscape.png`}
          alt="Illustrated bioregional landscape with critical shift markers on the features they relate to"
          draggable="false"
        />
        <div class="cs-markers">
          {positioned.map(({ shift: s, pos, i }) => (
            <a
              class="cs-marker"
              href={`${base}critical-shifts/${s.slug}/`}
              style={`--x:${pos.x}%;--y:${pos.y}%;--i:${i};--z:${3 + Math.round(pos.y / 10)};--accent:${shiftColor(s.slug)}`}
              title={s.name}
              aria-label={s.name}
            >
              <span class="cs-marker-emoji" aria-hidden="true">{s.emoji ?? pos.emoji}</span>
              <span class="cs-marker-name">{s.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <button class="cs-reopen" type="button" hidden>☰ Critical shifts</button>
</div>

<script>
  const map = document.getElementById("csMap");

  function play() {
    map?.classList.add("is-loaded");
  }
  if (document.readyState === "complete") requestAnimationFrame(play);
  else window.addEventListener("load", () => requestAnimationFrame(play));

  // Collapsible side panel: ✕ hides it (landscape goes full width), the
  // floating ☰ button brings it back. Always open by default on page load.
  const closeBtn = map?.querySelector<HTMLButtonElement>(".cs-close");
  const reopenBtn = map?.querySelector<HTMLButtonElement>(".cs-reopen");
  let hidden = false;

  function applyPanel() {
    map?.classList.toggle("panel-hidden", hidden);
    if (reopenBtn) reopenBtn.hidden = !hidden;
  }
  closeBtn?.addEventListener("click", () => {
    hidden = true;
    applyPanel();
  });
  reopenBtn?.addEventListener("click", () => {
    hidden = false;
    applyPanel();
  });
  applyPanel();
</script>

<style>
  .cs-map {
    --cs-sky: #a9d5d4; /* the illustration's sky colour — letterbox blends in */
    --cs-card-bg: #f9f9f3; /* paper-raised */
    --cs-shadow: rgba(20, 40, 30, 0.28);
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    overflow: hidden;
    font-family: var(--font-body);
    background: var(--cs-sky);
  }

  .cs-map * { box-sizing: border-box; margin: 0; padding: 0; }

  .cs-layout {
    display: flex;
    align-items: stretch;
    gap: 24px;
    width: 100%;
    padding: 24px;
  }

  /* Landscape column: the stage is sized to the image's own aspect ratio and
     centred, so the markers (positioned in % of the stage) stay glued to the
     scene at every size — the contain-fit is exact, no inner letterboxing. */
  .cs-stage-col {
    flex: 4 1 0;
    min-width: 0;
    display: flex;
  }
  .cs-stage {
    position: relative;
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: auto;
  }
  .cs-landscape {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

  /* -------- side panel (left): title + shift list -------- */
  .cs-panel {
    flex: 1 1 0;
    min-width: 320px;
    max-width: 400px;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--cs-card-bg);
    border: 1px solid rgba(32, 64, 79, 0.18);
    border-radius: 18px;
    padding: 28px 32px 32px;
    box-shadow: 0 18px 40px var(--cs-shadow);
  }
  .cs-close {
    align-self: flex-end;
    width: 28px;
    height: 28px;
    margin-bottom: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(32, 64, 79, 0.18);
    border-radius: 50%;
    background: #fffff0;
    color: #20404f;
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .cs-close:hover {
    background: #20404f;
    color: #fff;
    border-color: #20404f;
  }
  .cs-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mist);
  }
  .cs-hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.15;
    color: #20404f;
    margin-top: 6px;
  }
  .cs-hero-subtitle {
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--mist);
  }
  .cs-divider {
    height: 1px;
    background: rgba(32, 64, 79, 0.14);
    margin: 18px 0 16px;
  }
  .cs-list-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    color: #20404f;
    margin-bottom: 12px;
  }

  /* the list scrolls internally so the panel always fits the screen height */
  .cs-list-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    background: rgba(32, 64, 79, 0.05);
    border: 1px solid rgba(32, 64, 79, 0.08);
    border-radius: 14px;
    padding: 14px;
  }
  .cs-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cs-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 10px 12px;
    background: #fffff0;
    border: 1px solid rgba(32, 64, 79, 0.12);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .cs-row:hover {
    border-color: var(--bwl-secondary);
    background: #fff;
  }
  .cs-row-emoji {
    flex-shrink: 0;
    font-size: 16px;
    line-height: 1;
  }
  .cs-row-name {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.25;
    color: #20404f;
  }
  .cs-row-count {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--mist);
    border: 1px solid rgba(32, 64, 79, 0.15);
    border-radius: 999px;
    padding: 4px 9px;
    white-space: nowrap;
  }

  /* panel hidden: the landscape takes the whole width */
  .cs-map.panel-hidden .cs-panel { display: none; }
  .cs-map.panel-hidden .cs-layout { gap: 0; }

  /* floating button to bring the panel back (same style family as the
     bioregion pages' back-link) */
  .cs-reopen {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    border: 2px solid rgba(32, 64, 79, 0.38);
    background: var(--paper-raised);
    color: var(--bwl-primary);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(32, 64, 79, 0.16);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .cs-reopen:hover {
    background: var(--bwl-primary);
    color: #fff;
    border-color: var(--bwl-primary);
  }
  .cs-reopen[hidden] { display: none; }

  /* -------- positioned cards on the landscape -------- */
  .cs-markers { position: absolute; inset: 0; }
  .cs-marker {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 200px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 240, 0.97);
    border: 1px solid rgba(32, 64, 79, 0.3);
    border-left: 5px solid var(--accent, var(--bwl-secondary));
    box-shadow: 0 4px 14px rgba(20, 40, 30, 0.28);
    color: #20404f;
    font-family: var(--font-body);
    text-align: left;
    text-decoration: none;
    user-select: none;
    /* lower cards on the landscape sit above higher ones, like map pins */
    z-index: var(--z, 3);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .cs-marker:hover,
  .cs-marker:focus-visible {
    z-index: 60;
    transform: translate(-50%, -50%) scale(1.05);
    background: #fff;
    border-color: var(--bwl-secondary);
    box-shadow: 0 10px 24px rgba(20, 40, 30, 0.4);
  }
  .cs-marker-emoji {
    flex-shrink: 0;
    font-size: 19px;
    line-height: 1.2;
  }
  .cs-marker-name {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.25;
  }

  /* subtle entrance: fade the scene in, pop markers in order. Both start
     visible by default so the page stays fully usable even without JS. */
  .cs-map.is-loaded .cs-stage { animation: cs-fade-in 0.8s ease; }
  .cs-map.is-loaded .cs-marker {
    animation: cs-pop-in 0.45s ease backwards;
    animation-delay: calc(0.25s + var(--i) * 0.07s);
  }
  @keyframes cs-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes cs-pop-in { from { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .cs-map * { animation: none !important; }
  }

  /* -------- responsive -------- */
  /* small screens: the panel becomes a full-width top drawer overlaying the
     landscape, which stays full-bleed and visible behind it */
  @media (max-width: 900px) {
    .cs-layout { display: block; padding: 0; }
    .cs-stage-col { position: absolute; inset: 0; }
    .cs-stage { width: 100%; }
    .cs-panel {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 30;
      flex: none;
      width: 100%;
      max-width: none;
      max-height: 72dvh;
      border-radius: 0 0 18px 18px;
      padding: 20px 24px 24px;
    }
    .cs-reopen { top: 12px; left: 12px; }
  }

  /* on phones, cards shrink to emoji chips so the scene stays readable */
  @media (max-width: 560px) {
    .cs-marker { padding: 8px 10px; gap: 0; }
    .cs-marker-emoji { font-size: 18px; }
    .cs-marker-name { display: none; }
  }
</style>
