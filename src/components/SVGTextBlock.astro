---
interface Props {
  lines: string[];
  x: number;
  y: number;
  lineHeight: string;
  anchor?: "start" | "middle" | "end";
  style: string;
}

const { lines, x, y, lineHeight, anchor = "start", style } = Astro.props;
---

<text x={x} y={y} text-anchor={anchor} style={style}>
  {lines.map((line, i) => (
    <tspan x={x} dy={i === 0 ? 0 : lineHeight}>
      {line}
    </tspan>
  ))}
</text>
