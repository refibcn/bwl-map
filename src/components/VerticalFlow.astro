---
/**
 * Vertical flow diagram — TEST layout for bioregions with many systemic
 * innovations (e.g. Vistula). Strict three-band structure, top to bottom:
 *
 *   1. bioregion card (image on the LEFT of the card)
 *   2. all critical shifts in ONE horizontal row (compact cards)
 *   3. all systemic innovations in ONE OR TWO horizontal rows
 *      (image on TOP of each project card)
 *
 * Each innovation appears once and is connected to every shift it belongs
 * to (solid = primary shift, dashed = the others). Hovering a shift
 * highlights all its innovations wherever they sit; hovering an innovation
 * highlights all its shifts + the bioregion.
 */
import SVGTextBlock from "./SVGTextBlock.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth, capLines } from "../lib/text";

interface Shift {
  slug: string;
  name: string;
  emoji: string | null;
  leveragePoint: string;
}

interface Innovation {
  slug: string;
  name: string;
  description: string;
  tags: string[];
  notionUrl: string | null;
  imageUrl: string | null;
  imageFile: string | null;
}

interface Props {
  shifts: Shift[];
  innovations: Innovation[];
  bioregionName: string;
  bioregionDescription: string;
  bioregionImageUrl?: string | null;
  bioregionImageFile?: string | null;
  bioregionCountry?: string | null;
}

const {
  shifts,
  innovations,
  bioregionName,
  bioregionDescription,
  bioregionImageUrl = null,
  bioregionImageFile = null,
  bioregionCountry = "",
} = Astro.props as Props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

function resolveImageSource(file: string | null | undefined, url: string | null | undefined): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

const PALETTE = [
  "#20404F", "#E2AD4F", "#5C8A7A", "#C78A1D",
  "#4A7C6F", "#8B5A2B", "#3D6B66", "#D4A84B",
];

// --- canvas ---
const W = 1700;
const margin = { top: 90, right: 60, bottom: 60, left: 60 };

// --- bioregion card (top, image on the left) ---
const bioW = 720;
const bioImg = 180;
const bioH = 180;
const bioX = W / 2;
const bioLeft = bioX - bioW / 2;
const bioTop = margin.top;
const bioBottom = bioTop + bioH;
const bioTextX = bioLeft + bioImg + 26;
const bioTextW = bioW - bioImg - 26 - 24;
const bioImageSrc = resolveImageSource(bioregionImageFile, bioregionImageUrl);

const bioNameLines = capLines(wrapToWidth(bioregionName || "", bioTextW, 20, "display"), 2);
const bioCountryLines = capLines(wrapToWidth(bioregionCountry || "", bioTextW, 10, "display"), 1);
const bioDescLines = capLines(wrapToWidth(bioregionDescription || "", bioTextW, 9.5, "body"), 6);
const bioTextHeight =
  bioNameLines.length * 24 +
  (bioCountryLines.length ? 6 + bioCountryLines.length * 12 : 0) +
  (bioDescLines.length ? 8 + bioDescLines.length * 12.5 : 0);
const bioTextTop = bioTop + (bioH - bioTextHeight) / 2;
const bioNameY = bioTextTop + 24 * 0.8;
const bioCountryY = bioNameY + bioNameLines.length * 24 + 6;
const bioDescY = bioCountryY + bioCountryLines.length * 12 + 8;

// --- critical shifts: ONE horizontal row, compact cards ---
const shiftIndexBySlug = new Map(shifts.map((s, i) => [s.slug, i]));
// Shrink the cards so ALL shifts fit in a single row (Orne has 12).
const csCount = shifts.length;
const csGap = csCount > 9 ? 8 : 12;
const csW = Math.min(150, Math.floor((W - margin.left - margin.right - (csCount - 1) * csGap) / csCount));
const csCards = shifts.map((s, i) => {
  // Full database text — names and leverage points are wrapped to the card
  // width but never truncated.
  const nameLines = wrapToWidth(`${s.emoji || ""} ${s.name}`.trim(), csW - 24, 12, "display");
  const leverageLines = wrapToWidth(s.leveragePoint || "", csW - 24, 8.5, "body");
  return { ...s, nameLines, leverageLines, color: PALETTE[i % PALETTE.length] };
});
// Shift cards share the row height of the tallest one (full text fits).
const csH = Math.max(96, ...csCards.map((c) => 26 + c.nameLines.length * 14 + 3 + c.leverageLines.length * 11 + 14));
const csRowW = csCards.length * csW + Math.max(0, csCards.length - 1) * csGap;
const csStartX = (W - csRowW) / 2;
const csTop = bioBottom + 115;
const csBottom = csTop + csH;
const csX = (i: number) => csStartX + i * (csW + csGap) + csW / 2;

// --- systemic innovations: ONE or TWO horizontal rows ---
const sisW = 180;
const sisImgH = 84;
const sisCardH = 176;
const sisGap = 12;

// Order innovations by their primary shift (so each shift's fan stays local),
// untagged ones last.
const orderedInnovations = [...innovations].sort((a, b) => {
  const ia = a.tags.length ? shiftIndexBySlug.get(a.tags[0]) ?? 999 : 999;
  const ib = b.tags.length ? shiftIndexBySlug.get(b.tags[0]) ?? 999 : 999;
  return ia - ib;
});

const sisCards = orderedInnovations.map((inv) => {
  const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
  // Full database text — names and descriptions are wrapped but never cut.
  const nameLines = wrapToWidth(inv.name || "", sisW - 24, 12, "display");
  const descLines = wrapToWidth(inv.description || "", sisW - 24, 9, "body");
  const contentH = sisImgH + 8 + nameLines.length * 14 + 3 + descLines.length * 12 + 16;
  return { ...inv, hasImage, nameLines, descLines, cardH: Math.max(sisCardH, contentH) };
});

const perLine = Math.max(1, Math.floor((W - margin.left - margin.right + sisGap) / (sisW + sisGap)));
const rowCount = Math.ceil(sisCards.length / perLine);
// Each row is as tall as its tallest card; rows stack below each other.
const rowHeights: number[] = [];
for (let r = 0; r < rowCount; r++) {
  const count = Math.min(perLine, sisCards.length - r * perLine);
  rowHeights.push(Math.max(...sisCards.slice(r * perLine, r * perLine + count).map((c) => c.cardH)));
}
let yCum = csBottom + 95;
const rowYs = rowHeights.map((h) => {
  const y = yCum;
  yCum += h + 16;
  return y;
});
// Rows of cards are CENTRED on the canvas: a short last row (e.g. 7 of 8)
// sits centred instead of hugging the left edge.
const sisPositions = sisCards.map((_, j) => {
  const row = Math.floor(j / perLine);
  const count = Math.min(perLine, sisCards.length - row * perLine);
  const rowWidth = count * sisW + (count - 1) * sisGap;
  const startX = margin.left + (W - margin.left - margin.right - rowWidth) / 2;
  return {
    x: startX + (j % perLine) * (sisW + sisGap),
    y: rowYs[row],
  };
});
const sisBottom = rowYs.length ? rowYs[rowYs.length - 1] + rowHeights[rowHeights.length - 1] : csBottom + 95;
const height = sisBottom + margin.bottom;

// --- bus tree: bioregion → shifts ---
const busY = bioBottom + 55;
const busLeft = margin.left + 40;
const busRight = W - margin.right - 40;

const csBySlug = new Map(csCards.map((c) => [c.slug, c]));

function curve(x1: number, y1: number, x2: number, y2: number, strength = 0.5) {
  const dx = x2 - x1;
  const mx = x1 + dx * strength;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width={W}
    height="auto"
    viewBox={`0 0 ${W} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Vertical layout test — {bioregionName}</title>
    <desc>
      {bioregionName} on top, its critical shifts in a row, then the systemic innovations in horizontal rows.
    </desc>

    <defs>
      <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#20404f" flood-opacity="0.08" />
      </filter>
    </defs>

    {/* Bus tree: bioregion → shifts */}
    <path class="conn conn-bio-bus" data-from="bio" data-to="bio" d={`M${bioX},${bioBottom} L${bioX},${busY} L${busLeft},${busY} L${busRight},${busY}`} fill="none" stroke="#20404f" stroke-width="2.5" opacity="0.35" stroke-linejoin="round" />
    {csCards.map((s, i) => (
      <path
        class={`conn conn-drop conn-drop-${s.slug}`}
        data-from="bio"
        data-to={`cs:${s.slug}`}
        d={`M${csX(i)},${busY} L${csX(i)},${csTop}`}
        fill="none"
        stroke={s.color}
        stroke-width="2.5"
        opacity="0.4"
      />
    ))}

    {/* Innovations → their shifts (solid = primary, dashed = other tags) */}
    {sisCards.map((inv, j) => {
      const fromX = sisPositions[j].x + sisW / 2;
      const fromY = sisPositions[j].y;
      return inv.tags.map((t, k) => {
        const csIdx = shiftIndexBySlug.get(t);
        if (csIdx === undefined) return null;
        const primary = k === 0;
        return (
          <path
            class={`conn ${primary ? "conn-cs-sis" : "conn-cross"}`}
            data-from={`sis:${inv.slug}`}
            data-to={`cs:${t}`}
            d={curve(fromX, fromY, csX(csIdx), csBottom, 0.5)}
            fill="none"
            stroke={csBySlug.get(t)!.color}
            stroke-width={primary ? 2.5 : 2}
            opacity={primary ? 0.45 : 0.3}
          />
        );
      });
    })}

    {/* Bioregion card */}
    <g class="card bio-card" data-el="bio" data-root="bio" tabindex="0">
      <rect x={bioLeft} y={bioTop} width={bioW} height={bioH} rx="18" fill="var(--paper-raised)" stroke="var(--bwl-primary)" stroke-width="2" filter="url(#softShadow)" />
      {bioImageSrc && (
        <image
          x={bioLeft}
          y={bioTop}
          width={bioImg}
          height={bioH}
          href={bioImageSrc}
          clip-path="inset(0px round 18px 0 0 18px)"
          preserveAspectRatio="xMidYMid slice"
        />
      )}
      <rect x={bioLeft} y={bioTop} width={bioW} height={bioH} rx="18" fill="none" stroke="var(--bwl-primary)" stroke-width="2" />
      <SVGTextBlock
        lines={bioNameLines}
        x={bioTextX}
        y={bioNameY}
        lineHeight="1.2em"
        anchor="start"
        style="font-family:var(--font-display);font-size:20px;font-weight:bold;fill:var(--bwl-primary);"
      />
      {bioCountryLines.length > 0 && (
        <SVGTextBlock
          lines={bioCountryLines}
          x={bioTextX}
          y={bioCountryY}
          lineHeight="1.2em"
          anchor="start"
          style="font-family:var(--font-display);font-size:10px;font-weight:bold;fill:var(--bwl-secondary);letter-spacing:0.1em;text-transform:uppercase;"
        />
      )}
      <SVGTextBlock
        lines={bioDescLines}
        x={bioTextX}
        y={bioDescY}
        lineHeight="1.3em"
        anchor="start"
        style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
      />
    </g>

    {/* Critical shift cards (one row) */}
    {csCards.map((s, i) => {
      const x = csStartX + i * (csW + csGap);
      const nameY = csTop + 12 + 14 * 0.8;
      const leverageY = nameY + s.nameLines.length * 14 + 3;
      return (
        <g class={`card cs-card cs-${s.slug}`} data-el={`cs:${s.slug}`} tabindex="0">
          <rect x={x} y={csTop} width={csW} height={csH} rx="10" fill="var(--paper-raised)" stroke={s.color} stroke-width="2" filter="url(#softShadow)" />
          <SVGTextBlock
            lines={s.nameLines}
            x={x + 12}
            y={nameY}
            lineHeight="1.2em"
            style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={s.leverageLines}
            x={x + 12}
            y={leverageY}
            lineHeight="1.3em"
            style="font-family:var(--font-body);font-size:8.5px;fill:var(--bwl-text);opacity:0.85;"
          />
        </g>
      );
    })}

    {/* Systemic innovation cards (image on top) */}
    {sisCards.map((inv, j) => {
      const { x, y } = sisPositions[j];
      const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
      const nameY = y + sisImgH + 8 + 14 * 0.8;
      const descY = nameY + inv.nameLines.length * 14 + 3;
      return (
        <g class="card sis-card" data-el={`sis:${inv.slug}`} tabindex="0">
          <rect x={x} y={y} width={sisW} height={inv.cardH} rx="10" fill="#ffffff" stroke="var(--line-strong)" stroke-width="1.5" filter="url(#softShadow)" />
          {sisImageSrc && (
            <image
              x={x}
              y={y}
              width={sisW}
              height={sisImgH}
              href={sisImageSrc}
              clip-path="inset(0px round 10px 10px 0 0)"
              preserveAspectRatio="xMidYMid slice"
            />
          )}
          <rect x={x} y={y} width={sisW} height={inv.cardH} rx="10" fill="none" stroke="var(--line-strong)" stroke-width="1.5" />
          <SVGTextBlock
            lines={inv.nameLines}
            x={x + 12}
            y={nameY}
            lineHeight="1.15em"
            anchor="start"
            style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={inv.descLines}
            x={x + 12}
            y={descY}
            lineHeight="1.3em"
            anchor="start"
            style="font-family:var(--font-body);font-size:9px;fill:var(--bwl-text);opacity:0.85;"
          />
          {inv.notionUrl && (
            <a href={inv.notionUrl} target="_blank" rel="noopener">
              <g>
                <circle cx={x + sisW - 15} cy={y + 20} r="8" fill="var(--bwl-secondary)" opacity="0.15" />
                <text x={x + sisW - 15} y={y + 23} text-anchor="middle" font-size="10" fill="var(--bwl-primary)" font-family="var(--font-body)" font-weight="bold">↗</text>
              </g>
            </a>
          )}
        </g>
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    function activateEl(elId: string) {
      svg!.classList.add("has-active");
      const match = new Set([elId]);
      svg!.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
        const from = path.dataset.from;
        const to = path.dataset.to;
        if (from === elId || to === elId) {
          if (from) match.add(from);
          if (to) match.add(to);
        }
      });
      if (elId.startsWith("sis:")) {
        const root = svg!.querySelector<SVGElement>("[data-root]");
        if (root?.dataset.el) match.add(root.dataset.el);
      }
      svg!.querySelectorAll<SVGElement>(".card, .conn").forEach((el) => {
        if (el.classList.contains("conn")) {
          const from = el.dataset.from;
          const to = el.dataset.to;
          el.classList.toggle("active", !!from && !!to && match.has(from) && match.has(to));
        } else {
          el.classList.toggle("active", !!el.dataset.el && match.has(el.dataset.el));
        }
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    svg.querySelectorAll<SVGGElement>(".bio-card, .cs-card, .sis-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activateEl(g.dataset.el!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activateEl(g.dataset.el!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activateEl(path.dataset.from!));
      path.addEventListener("mouseleave", deactivate);
    });
  })();
</script>

<style>
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .flow-wrap svg {
    display: block;
    width: auto;
    height: auto;
    margin: 0 auto;
    background: var(--paper);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
