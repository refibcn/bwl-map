---
/**
 * Vertical flow diagram — TEST layout for bioregions with many systemic
 * innovations (e.g. Vistula). Strict three-band structure, top to bottom:
 *
 *   1. bioregion card (image on the LEFT of the card)
 *   2. all critical shifts in ONE horizontal row (compact cards)
 *   3. all systemic innovations in ONE OR TWO horizontal rows
 *      (image on TOP of each project card)
 *
 * Each innovation appears once and is connected to every shift it belongs
 * to (solid = primary shift, dashed = the others). Hovering a shift
 * highlights all its innovations wherever they sit; hovering an innovation
 * highlights all its shifts + the bioregion.
 */
import FlowCard from "./FlowCard.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth } from "../lib/text";
import { shiftColor } from "../lib/shift-pages";

// See FlowDiagram.astro for the full rationale: wrapToWidth's word-wrap
// simulation is the only SAFE line-count estimate to size a box off (a
// naive length÷width division under-predicts real line counts and causes
// real overflow); a STANDARD floor on top keeps typical-length cards a
// consistent height instead of one that only reflects the estimate's own
// per-string quirks. Not every card below needs the floor — several of
// this file's rows/grids already size every card in a row/line to
// whichever one needs the most room, which is already consistent by
// construction — but the safe wrapToWidth-based line count matters
// everywhere a field previously had no cap at all ("never truncated").
function estimateLineCount(lines: string[], standardLines: number, maxLines: number): number {
  return Math.min(Math.max(standardLines, lines.length), maxLines);
}

interface Shift {
  slug: string;
  name: string;
  emoji: string | null;
  leveragePoint: string;
}

interface Innovation {
  slug: string;
  name: string;
  description: string;
  tags: string[];
  notionUrl: string | null;
  externalUrl: string | null;
  imageUrl: string | null;
  imageFile: string | null;
}

interface Props {
  shifts: Shift[];
  innovations: Innovation[];
  bioregionName: string;
  bioregionSlug: string;
  bioregionDescription: string;
  bioregionImageUrl?: string | null;
  bioregionImageFile?: string | null;
  bioregionCountry?: string | null;
}

const {
  shifts,
  innovations,
  bioregionName,
  bioregionSlug,
  bioregionDescription,
  bioregionImageUrl = null,
  bioregionImageFile = null,
  bioregionCountry = "",
} = Astro.props as Props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

function resolveImageSource(file: string | null | undefined, url: string | null | undefined): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

// --- canvas ---
const W = 1700;
const margin = { top: 90, right: 60, bottom: 60, left: 60 };

// --- bioregion card (top, image on the left) ---
const bioW = 540; // 720 * 0.75 — narrower than the original tuning
const bioImg = 180;
const bioH = 180;
const bioX = W / 2;
const bioLeft = bioX - bioW / 2;
const bioTop = margin.top;
const bioBottom = bioTop + bioH;
const bioImageSrc = resolveImageSource(bioregionImageFile, bioregionImageUrl);
// The bio card's height (180) is a fixed constant here, not content-driven
// — these are just the max-lines caps for CSS line-clamp, tuned so the
// worst case still fits comfortably within that fixed box.
const BIO_NAME_MAX_LINES = 2;
const BIO_COUNTRY_MAX_LINES = 1;
const BIO_DESC_MAX_LINES = 6;

// --- critical shifts: ONE horizontal row, compact cards ---
const shiftIndexBySlug = new Map(shifts.map((s, i) => [s.slug, i]));
// Shrink the cards so ALL shifts fit in a single row (Orne has 12).
const csCount = shifts.length;
const csGap = csCount > 9 ? 8 : 12;
const csW = Math.min(150, Math.floor((W - margin.left - margin.right - (csCount - 1) * csGap) / csCount));
// These two fields had no max-lines cap at all before this migration —
// see FlowDiagram.astro for why an unbounded field can't have a
// predictable card height. All cards in this row already share the
// tallest one's height (no standard-floor needed — that's already
// consistent by construction), just a safe cap.
const CS_NAME_MAX_LINES = 3;
const CS_LEVERAGE_MAX_LINES = 5;
const csCards = shifts.map((s) => {
  const nameLineCount = Math.min(
    wrapToWidth(`${s.emoji || ""} ${s.name}`.trim(), csW - 24, 12, "display").length,
    CS_NAME_MAX_LINES
  );
  const leverageLineCount = Math.min(
    wrapToWidth(s.leveragePoint || "", csW - 24, 8.5, "body").length,
    CS_LEVERAGE_MAX_LINES
  );
  return { ...s, nameLineCount, leverageLineCount, color: shiftColor(s.slug) };
});
// Shift cards share the row height of the tallest one (full text fits).
const csH = Math.max(96, ...csCards.map((c) => 26 + c.nameLineCount * 14 + 3 + c.leverageLineCount * 11 + 14));
const csRowW = csCards.length * csW + Math.max(0, csCards.length - 1) * csGap;
const csStartX = (W - csRowW) / 2;
const csTop = bioBottom + 115;
const csBottom = csTop + csH;
const csX = (i: number) => csStartX + i * (csW + csGap) + csW / 2;

// --- systemic innovations: ONE or TWO horizontal rows ---
const sisW = 180;
// 180x135 = 4:3 image box: landscape sources (1.33-1.5) fit with minimal
// crop; portrait sources (0.75-0.8) keep most of the photo (the old 180x84
// strip zoomed portraits into a 36%-visible sliver)
const sisImgH = 135;
const sisCardH = 176;
const sisGap = 12;

// Order innovations by their primary shift (so each shift's fan stays local),
// untagged ones last.
const orderedInnovations = [...innovations].sort((a, b) => {
  const ia = a.tags.length ? shiftIndexBySlug.get(a.tags[0]) ?? 999 : 999;
  const ib = b.tags.length ? shiftIndexBySlug.get(b.tags[0]) ?? 999 : 999;
  return ia - ib;
});

// Same "was never capped" situation as the cs-card fields above — each
// card still grows to its own real content height (unchanged design), just
// with a safe upper bound instead of an unbounded one.
const SIS_NAME_MAX_LINES = 3;
const SIS_DESC_MAX_LINES = 6;
const sisCards = orderedInnovations.map((inv) => {
  const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
  const nameLineCount = Math.min(wrapToWidth(inv.name || "", sisW - 24, 12, "display").length, SIS_NAME_MAX_LINES);
  const descLineCount = Math.min(
    wrapToWidth(inv.description || "", sisW - 24, 9, "body").length,
    SIS_DESC_MAX_LINES
  );
  const contentH = sisImgH + 8 + nameLineCount * 14 + 3 + descLineCount * 12 + 16;
  return { ...inv, hasImage, nameLineCount, descLineCount, cardH: Math.max(sisCardH, contentH) };
});

const perLine = Math.max(1, Math.floor((W - margin.left - margin.right + sisGap) / (sisW + sisGap)));
const rowCount = Math.ceil(sisCards.length / perLine);
// Each row is as tall as its tallest card; rows stack below each other.
const rowHeights: number[] = [];
for (let r = 0; r < rowCount; r++) {
  const count = Math.min(perLine, sisCards.length - r * perLine);
  rowHeights.push(Math.max(...sisCards.slice(r * perLine, r * perLine + count).map((c) => c.cardH)));
}
let yCum = csBottom + 95;
const rowYs = rowHeights.map((h) => {
  const y = yCum;
  yCum += h + 16;
  return y;
});
// Rows of cards are CENTRED on the canvas: a short last row (e.g. 7 of 8)
// sits centred instead of hugging the left edge.
const sisPositions = sisCards.map((_, j) => {
  const row = Math.floor(j / perLine);
  const count = Math.min(perLine, sisCards.length - row * perLine);
  const rowWidth = count * sisW + (count - 1) * sisGap;
  const startX = margin.left + (W - margin.left - margin.right - rowWidth) / 2;
  return {
    x: startX + (j % perLine) * (sisW + sisGap),
    y: rowYs[row],
  };
});
const sisBottom = rowYs.length ? rowYs[rowYs.length - 1] + rowHeights[rowHeights.length - 1] : csBottom + 95;
const height = sisBottom + margin.bottom;

// --- bus tree: bioregion → shifts ---
const busY = bioBottom + 55;
const busLeft = margin.left + 40;
const busRight = W - margin.right - 40;

const csBySlug = new Map(csCards.map((c) => [c.slug, c]));

// SI → shift connectors all share ONE horizontal bus line — row 1's original
// height — instead of each row computing its own midpoint. Without this, a
// second (or third) row's bus would land at a different height that often
// falls inside an earlier row's card band, reading as a line hidden behind
// cards. Every row's vertical segment still threads up through the gaps
// between earlier rows' cards exactly as before (that part already works —
// cards paint after connectors, so a card only occludes a line where they
// geometrically overlap); it now just jogs horizontally at the same shared
// height as row 1, merging into a single visible bus regardless of row count.
const sisBusY = (csBottom + rowYs[0]) / 2;

function ortho(x1: number, y1: number, x2: number, y2: number, busY: number) {
  // Straight 90-degree elbow: up/down to the bus height, then across, then
  // straight into the target — no curves.
  return `M${x1},${y1} L${x1},${busY} L${x2},${busY} L${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width={W}
    height="auto"
    viewBox={`0 0 ${W} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Vertical layout test — {bioregionName}</title>
    <desc>
      {bioregionName} on top, its critical shifts in a row, then the systemic innovations in horizontal rows.
    </desc>


    {/* Bus tree: bioregion → shifts */}
    <path class="conn conn-bio-bus" data-from="bio" data-to="bio" d={`M${bioX},${bioBottom} L${bioX},${busY} L${busLeft},${busY} L${busRight},${busY}`} fill="none" stroke="#20404f" stroke-width="2.5" opacity="0.35" stroke-linejoin="round" />
    {csCards.map((s, i) => (
      <path
        class={`conn conn-drop conn-drop-${s.slug}`}
        data-from="bio"
        data-to={`cs:${s.slug}`}
        d={`M${csX(i)},${busY} L${csX(i)},${csTop}`}
        fill="none"
        stroke={s.color}
        stroke-width="2.5"
        opacity="0.4"
      />
    ))}

    {/* Innovations → their shifts (solid = primary, dashed = other tags) */}
    {sisCards.map((inv, j) => {
      const fromX = sisPositions[j].x + sisW / 2;
      const fromY = sisPositions[j].y;
      return inv.tags.map((t, k) => {
        const csIdx = shiftIndexBySlug.get(t);
        if (csIdx === undefined) return null;
        const primary = k === 0;
        return (
          <path
            class={`conn ${primary ? "conn-cs-sis" : "conn-cross"}`}
            data-from={`sis:${inv.slug}`}
            data-to={`cs:${t}`}
            d={ortho(fromX, fromY, csX(csIdx), csBottom, sisBusY)}
            fill="none"
            stroke={csBySlug.get(t)!.color}
            stroke-width={primary ? 2.5 : 2}
            opacity={primary ? 0.45 : 0.3}
          />
        );
      });
    })}

    {/* Bioregion card — this is the page's own subject, so it was never a
        link before. Send it to the real bioregion page on the BWL website
        (external), same convention used for the systemic-innovation image
        links. */}
    <FlowCard
      x={bioLeft}
      y={bioTop}
      width={bioW}
      height={bioH}
      kind="bio"
      imagePosition="left"
      imageSrc={bioImageSrc}
      imageSize={bioImg}
      title={bioregionName}
      titleMaxLines={BIO_NAME_MAX_LINES}
      titleSize={20}
      subtitle={bioregionCountry || null}
      subtitleMaxLines={BIO_COUNTRY_MAX_LINES}
      body={bioregionDescription}
      bodyMaxLines={BIO_DESC_MAX_LINES}
      bodySize={9.5}
      href={`https://bioregionalweavinglabs.org/bioregions/${bioregionSlug}/`}
      external
      dataEl="bio"
      dataRoot
    />

    {/* Critical shift cards (one row) — clickable, like the horizontal view */}
    {csCards.map((s, i) => (
      <FlowCard
        x={csStartX + i * (csW + csGap)}
        y={csTop}
        width={csW}
        height={csH}
        kind="cs"
        imagePosition="none"
        title={`${s.emoji || ""} ${s.name}`.trim()}
        titleMaxLines={CS_NAME_MAX_LINES}
        body={s.leveragePoint || null}
        bodyMaxLines={CS_LEVERAGE_MAX_LINES}
        bodySize={8.5}
        href={`${base}critical-shifts/${s.slug}/`}
        dataEl={`cs:${s.slug}`}
        borderColor={s.color}
        radius={10}
        paddingX={12}
        paddingY={12}
      />
    ))}

    {/* Systemic innovation cards (image on top) — image + external-link
        badge share one clickable region (the whole image, not just the
        small badge); the text is deliberately not part of that link. */}
    {sisCards.map((inv, j) => {
      const { x, y } = sisPositions[j];
      const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
      return (
        <FlowCard
          x={x}
          y={y}
          width={sisW}
          height={inv.cardH}
          kind="sis"
          imagePosition={sisImageSrc ? "top" : "none"}
          imageSrc={sisImageSrc}
          imageSize={sisImgH}
          imageHref={inv.externalUrl}
          imageExternal
          title={inv.name}
          titleMaxLines={SIS_NAME_MAX_LINES}
          body={inv.description || null}
          bodyMaxLines={SIS_DESC_MAX_LINES}
          bodySize={9}
          dataEl={`sis:${inv.slug}`}
          paddingX={12}
          paddingY={8}
        />
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    function activateEl(elId: string) {
      svg!.classList.add("has-active");
      const match = new Set([elId]);
      svg!.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
        const from = path.dataset.from;
        const to = path.dataset.to;
        if (from === elId || to === elId) {
          if (from) match.add(from);
          if (to) match.add(to);
        }
      });
      if (elId.startsWith("sis:")) {
        const root = svg!.querySelector<HTMLElement>("[data-root]");
        if (root?.dataset.el) match.add(root.dataset.el);
      }
      // Cards are now real HTML elements (rendered via <foreignObject>, not
      // raw SVG <g>) — this selector still matches both them and the SVG
      // .conn <path> lines, so the type here covers both (plain `Element`
      // doesn't have `.dataset`, only the HTML/SVG-specific interfaces do).
      svg!.querySelectorAll<HTMLElement | SVGElement>(".card, .conn").forEach((el) => {
        if (el.classList.contains("conn")) {
          const from = el.dataset.from;
          const to = el.dataset.to;
          el.classList.toggle("active", !!from && !!to && match.has(from) && match.has(to));
        } else {
          el.classList.toggle("active", !!el.dataset.el && match.has(el.dataset.el));
        }
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<HTMLElement | SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    // Cards are real HTML (an <a> when the whole card links, a <div>
    // otherwise) rendered inside <foreignObject> — HTMLElement covers both.
    svg.querySelectorAll<HTMLElement>(".bio-card, .cs-card, .sis-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activateEl(g.dataset.el!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activateEl(g.dataset.el!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activateEl(path.dataset.from!));
      path.addEventListener("mouseleave", deactivate);
    });
  })();
</script>

<style is:global>
  /* is:global (not scoped): the .card elements this CSS targets are now
     rendered by the separate FlowCard.astro component (inside a
     <foreignObject>), so they carry FlowCard's own scoping attribute, not
     this file's — a normal scoped selector here would silently never match
     them (same class of bug already hit once this session with MapLibre's
     JS-created markers needing is:global for the same reason). */
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* short diagrams (few cards) are centred vertically on the page */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flow-wrap svg {
    display: block;
    width: auto;
    height: auto;
    margin: 0 auto;
    background: var(--paper-raised);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
