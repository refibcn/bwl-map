---
/**
 * Vertical flow diagram — TEST layout for bioregions with many systemic
 * innovations (e.g. Vistula).
 *
 * Structure (top to bottom):
 *   1. bioregion card (image on the LEFT of the card)
 *   2. an orthogonal "bus" tree: a horizontal line from the bioregion, with
 *      vertical drops down to every critical shift
 *   3. shift groups: each critical shift card with its systemic innovations
 *      flowing horizontally to its right (image on TOP of each project card);
 *      groups wrap into new rows when they overflow the canvas width.
 *
 * Connectors stay short and local (shift → its own projects), so the diagram
 * stays readable with many shifts and projects. Hover highlighting behaves
 * like the horizontal FlowDiagram.
 */
import SVGTextBlock from "./SVGTextBlock.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth, capLines } from "../lib/text";

interface Shift {
  slug: string;
  name: string;
  emoji: string | null;
  leveragePoint: string;
}

interface Innovation {
  slug: string;
  name: string;
  description: string;
  tags: string[];
  notionUrl: string | null;
  imageUrl: string | null;
  imageFile: string | null;
}

interface Props {
  shifts: Shift[];
  innovations: Innovation[];
  bioregionName: string;
  bioregionDescription: string;
  bioregionImageUrl?: string | null;
  bioregionImageFile?: string | null;
  bioregionCountry?: string | null;
}

const {
  shifts,
  innovations,
  bioregionName,
  bioregionDescription,
  bioregionImageUrl = null,
  bioregionImageFile = null,
  bioregionCountry = "",
} = Astro.props as Props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

function resolveImageSource(file: string | null | undefined, url: string | null | undefined): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

const PALETTE = [
  "#20404F", "#E2AD4F", "#5C8A7A", "#C78A1D",
  "#4A7C6F", "#8B5A2B", "#3D6B66", "#D4A84B",
];

// --- canvas ---
const W = 1600;
const margin = { top: 90, right: 60, bottom: 60, left: 60 };

// --- bioregion card (top, image on the left) ---
const bioW = 720;
const bioImg = 180;
const bioH = 180;
const bioX = W / 2;
const bioLeft = bioX - bioW / 2;
const bioTop = margin.top;
const bioBottom = bioTop + bioH;
const bioTextX = bioLeft + bioImg + 26;
const bioTextW = bioW - bioImg - 26 - 24;
const bioImageSrc = resolveImageSource(bioregionImageFile, bioregionImageUrl);

const bioNameLines = capLines(wrapToWidth(bioregionName || "", bioTextW, 20, "display"), 2);
const bioCountryLines = capLines(wrapToWidth(bioregionCountry || "", bioTextW, 10, "display"), 1);
const bioDescLines = capLines(wrapToWidth(bioregionDescription || "", bioTextW, 9.5, "body"), 6);
const bioTextHeight =
  bioNameLines.length * 24 +
  (bioCountryLines.length ? 6 + bioCountryLines.length * 12 : 0) +
  (bioDescLines.length ? 8 + bioDescLines.length * 12.5 : 0);
const bioTextTop = bioTop + (bioH - bioTextHeight) / 2;
const bioNameY = bioTextTop + 24 * 0.8;
const bioCountryY = bioNameY + bioNameLines.length * 24 + 6;
const bioDescY = bioCountryY + bioCountryLines.length * 12 + 8;

// --- shift groups: one row per group (shift card + its projects to the right) ---
const csW = 180;
const csH = 104;
const sisW = 200;
const sisImgH = 92;
const sisCardH = 190;
const SIS_GAP = 12;
const CS_SIS_GAP = 34; // space between the shift card and its first project
const GROUP_GAP = 16;  // horizontal space between groups
const ROW_GAP = 28;    // vertical space between wrapped rows

// Per-shift content: an innovation appears in EVERY shift group it is tagged
// with (so each shift card visibly has all its innovations — no hidden
// connections, no crossing lines). Cards that belong to several shifts carry
// an "also in …" note so the sharing stays explicit.
const innovationsByShift = new Map<string, Innovation[]>();
for (const inv of innovations) {
  for (const tag of inv.tags) {
    if (!innovationsByShift.has(tag)) innovationsByShift.set(tag, []);
    innovationsByShift.get(tag)!.push(inv);
  }
}
const shiftNameBySlug = new Map(shifts.map((s) => [s.slug, s.name]));

const csCards = shifts.map((s, i) => {
  const nameLines = capLines(wrapToWidth(`${s.emoji || ""} ${s.name}`.trim(), csW - 32, 12, "display"), 2);
  const leverageLines = capLines(wrapToWidth(s.leveragePoint || "", csW - 32, 9.5, "body"), 2);
  const sis = (innovationsByShift.get(s.slug) || []).map((inv) => {
    const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
    const nameLines = capLines(wrapToWidth(inv.name || "", sisW - 24, 12, "display"), 2);
    const descLines = capLines(wrapToWidth(inv.description || "", sisW - 24, 9.5, "body"), 2);
    const otherTags = inv.tags.filter((t) => t !== s.slug);
    const otherNames = otherTags.map((t) => shiftNameBySlug.get(t) || t);
    const alsoLines = capLines(
      wrapToWidth(`also in: ${otherNames.join(" · ")}`, sisW - 24, 8, "body"),
      1
    );
    return { ...inv, hasImage, nameLines, descLines, alsoLines, otherTags };
  });
  return { ...s, nameLines, leverageLines, sis, color: PALETTE[i % PALETTE.length] };
});

// Biggest groups first: they take a full row, the small ones then pack into
// the remaining space.
csCards.sort((a, b) => b.sis.length - a.sis.length);

// Pack the groups into rows (first-fit bin packing, biggest first): each
// group is one horizontal band — shift card on the left, its projects to the
// right. Groups whose projects overflow the canvas wrap internally into extra
// lines (the row grows to fit the tallest group). Shifts with no projects are
// skipped, like the horizontal diagram hides orphan shifts.
interface GroupPos {
  c: (typeof csCards)[number]; // the shift card data
  cs: { x: number; y: number }; // shift card top-left
  sis: { x: number; y: number }[]; // project card top-lefts
  rowTop: number;
  height: number;
}
const SIS_LINE_GAP = 16;

const availableRow = W - margin.left - margin.right;
const rowsArr: { items: { c: (typeof csCards)[number]; x: number; sisStartX: number; perLine: number; height: number; singleW: number }[]; usedW: number }[] = [];
for (const c of csCards) {
  if (c.sis.length === 0) continue;
  const singleW = csW + CS_SIS_GAP + c.sis.length * (sisW + SIS_GAP) - SIS_GAP;
  let row = rowsArr.find((r) => r.usedW + GROUP_GAP + singleW <= availableRow);
  if (!row) {
    row = { items: [], usedW: 0 };
    rowsArr.push(row);
  }
  const gx = margin.left + row.usedW + (row.items.length ? GROUP_GAP : 0);
  const sisStartX = gx + csW + CS_SIS_GAP;
  const perLine = Math.max(1, Math.floor((W - margin.right - sisStartX + SIS_GAP) / (sisW + SIS_GAP)));
  const lines = Math.ceil(c.sis.length / perLine);
  const groupH = lines * sisCardH + (lines - 1) * SIS_LINE_GAP;
  row.items.push({ c, x: gx, sisStartX, perLine, height: groupH, singleW });
  row.usedW += (row.items.length > 1 ? GROUP_GAP : 0) + singleW;
}

// Assign vertical positions row by row; groups centre vertically in their row.
const groups: GroupPos[] = [];
let gy = bioBottom + 120; // room for the bus + drops
for (const row of rowsArr) {
  const rowH = Math.max(...row.items.map((p) => p.height));
  for (const p of row.items) {
    const sisPos = p.c.sis.map((_, j) => ({
      x: p.sisStartX + (j % p.perLine) * (sisW + SIS_GAP),
      y: gy + (rowH - p.height) / 2 + Math.floor(j / p.perLine) * (sisCardH + SIS_LINE_GAP),
    }));
    groups.push({
      c: p.c,
      cs: { x: p.x, y: gy + (rowH - csH) / 2 },
      sis: sisPos,
      rowTop: gy,
      height: p.height,
    });
  }
  gy += rowH + ROW_GAP;
}
const contentBottom = gy - ROW_GAP;
const height = contentBottom + margin.bottom;

// --- bus tree: bioregion → all shifts ---
const busY = bioBottom + 50;
const busLeft = margin.left + 40;
const busRight = W - margin.right - 40;

function curve(x1: number, y1: number, x2: number, y2: number, strength = 0.5) {
  const dx = x2 - x1;
  const mx = x1 + dx * strength;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width={W}
    height="auto"
    viewBox={`0 0 ${W} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Vertical layout test — {bioregionName}</title>
    <desc>
      {bioregionName} on top, connected to its critical shifts, each with its systemic innovations flowing horizontally.
    </desc>

    <defs>
      <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#20404f" flood-opacity="0.08" />
      </filter>
    </defs>

    {/* Bus tree: bioregion → shifts */}
    <path class="conn conn-bio-bus" data-from="bio" data-to="bio" d={`M${bioX},${bioBottom} L${bioX},${busY} L${busLeft},${busY} L${busRight},${busY}`} fill="none" stroke="#20404f" stroke-width="2.5" opacity="0.35" stroke-linejoin="round" />
    {groups.map((g) => (
      <path
        class={`conn conn-drop conn-drop-${g.c.slug}`}
        data-from="bio"
        data-to={`cs:${g.c.slug}`}
        d={`M${g.cs.x + csW / 2},${busY} L${g.cs.x + csW / 2},${g.cs.y}`}
        fill="none"
        stroke={g.c.color}
        stroke-width="2.5"
        opacity="0.4"
      />
    ))}

    {/* Shift → its systemic innovations */}
    {groups.map((g) =>
      g.sis.map((sp, j) => {
        const inv = g.c.sis[j];
        const csCy = g.cs.y + csH / 2;
        const sisCy = sp.y + sisCardH / 2;
        return (
          <path
            class="conn conn-cs-sis"
            data-from={`cs:${g.c.slug}`}
            data-to={`sis:${inv.slug}`}
            d={curve(g.cs.x + csW, csCy, sp.x, sisCy, 0.45)}
            fill="none"
            stroke={g.c.color}
            stroke-width="2.5"
            opacity="0.45"
          />
        );
      })
    )}

    {/* Bioregion card */}
    <g class="card bio-card" data-el="bio" data-root="bio" tabindex="0">
      <rect x={bioLeft} y={bioTop} width={bioW} height={bioH} rx="18" fill="var(--paper-raised)" stroke="var(--bwl-primary)" stroke-width="2" filter="url(#softShadow)" />
      {bioImageSrc && (
        <image
          x={bioLeft}
          y={bioTop}
          width={bioImg}
          height={bioH}
          href={bioImageSrc}
          clip-path="inset(0px round 18px 0 0 18px)"
          preserveAspectRatio="xMidYMid slice"
        />
      )}
      <rect x={bioLeft} y={bioTop} width={bioW} height={bioH} rx="18" fill="none" stroke="var(--bwl-primary)" stroke-width="2" />
      <SVGTextBlock
        lines={bioNameLines}
        x={bioTextX}
        y={bioNameY}
        lineHeight="1.2em"
        anchor="start"
        style="font-family:var(--font-display);font-size:20px;font-weight:bold;fill:var(--bwl-primary);"
      />
      {bioCountryLines.length > 0 && (
        <SVGTextBlock
          lines={bioCountryLines}
          x={bioTextX}
          y={bioCountryY}
          lineHeight="1.2em"
          anchor="start"
          style="font-family:var(--font-display);font-size:10px;font-weight:bold;fill:var(--bwl-secondary);letter-spacing:0.1em;text-transform:uppercase;"
        />
      )}
      <SVGTextBlock
        lines={bioDescLines}
        x={bioTextX}
        y={bioDescY}
        lineHeight="1.3em"
        anchor="start"
        style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
      />
    </g>

    {/* Critical shift cards */}
    {groups.map((g) => {
      const s = g.c;
      const nameY = g.cs.y + 16 + 14 * 0.8;
      const leverageY = nameY + s.nameLines.length * 14 + 4;
      return (
        <g class={`card cs-card cs-${s.slug}`} data-el={`cs:${s.slug}`} tabindex="0">
          <rect x={g.cs.x} y={g.cs.y} width={csW} height={csH} rx="12" fill="var(--paper-raised)" stroke={s.color} stroke-width="2" filter="url(#softShadow)" />
          <SVGTextBlock
            lines={s.nameLines}
            x={g.cs.x + 16}
            y={nameY}
            lineHeight="1.2em"
            style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={s.leverageLines}
            x={g.cs.x + 16}
            y={leverageY}
            lineHeight="1.3em"
            style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
          />
        </g>
      );
    })}

    {/* Systemic innovation cards (image on top) */}
    {groups.map((g) =>
      g.sis.map((sp, j) => {
        const inv = g.c.sis[j];
        const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
        const nameY = sp.y + sisImgH + 8 + 14 * 0.8;
        const descY = nameY + inv.nameLines.length * 14 + 3;
        const alsoY = descY + inv.descLines.length * 12 + 3;
        return (
          <g class="card sis-card" data-el={`sis:${inv.slug}`} tabindex="0">
            <rect x={sp.x} y={sp.y} width={sisW} height={sisCardH} rx="12" fill="#ffffff" stroke="var(--line-strong)" stroke-width="1.5" filter="url(#softShadow)" />
            {sisImageSrc && (
              <image
                x={sp.x}
                y={sp.y}
                width={sisW}
                height={sisImgH}
                href={sisImageSrc}
                clip-path="inset(0px round 12px 12px 0 0)"
                preserveAspectRatio="xMidYMid slice"
              />
            )}
            <rect x={sp.x} y={sp.y} width={sisW} height={sisCardH} rx="12" fill="none" stroke="var(--line-strong)" stroke-width="1.5" />
            <SVGTextBlock
              lines={inv.nameLines}
              x={sp.x + 12}
              y={nameY}
              lineHeight="1.15em"
              anchor="start"
              style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
            />
            <SVGTextBlock
              lines={inv.descLines}
              x={sp.x + 12}
              y={descY}
              lineHeight="1.3em"
              anchor="start"
              style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
            />
            {inv.otherTags.length > 0 && (
              <SVGTextBlock
                lines={inv.alsoLines}
                x={sp.x + 12}
                y={alsoY}
                lineHeight="1.2em"
                anchor="start"
                style="font-family:var(--font-body);font-size:8px;font-weight:bold;fill:var(--bwl-secondary);"
              />
            )}
            {inv.notionUrl && (
              <a href={inv.notionUrl} target="_blank" rel="noopener">
                <g>
                  <circle cx={sp.x + sisW - 15} cy={sp.y + 22} r="8" fill="var(--bwl-secondary)" opacity="0.15" />
                  <text x={sp.x + sisW - 15} y={sp.y + 25} text-anchor="middle" font-size="10" fill="var(--bwl-primary)" font-family="var(--font-body)" font-weight="bold">↗</text>
                </g>
              </a>
            )}
          </g>
        );
      })
    )}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    function activateEl(elId: string) {
      svg!.classList.add("has-active");
      const match = new Set([elId]);
      svg!.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
        const from = path.dataset.from;
        const to = path.dataset.to;
        if (from === elId || to === elId) {
          if (from) match.add(from);
          if (to) match.add(to);
        }
      });
      if (elId.startsWith("sis:")) {
        const root = svg!.querySelector<SVGElement>("[data-root]");
        if (root?.dataset.el) match.add(root.dataset.el);
      }
      svg!.querySelectorAll<SVGElement>(".card, .conn").forEach((el) => {
        if (el.classList.contains("conn")) {
          const from = el.dataset.from;
          const to = el.dataset.to;
          el.classList.toggle("active", !!from && !!to && match.has(from) && match.has(to));
        } else {
          el.classList.toggle("active", !!el.dataset.el && match.has(el.dataset.el));
        }
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    svg.querySelectorAll<SVGGElement>(".bio-card, .cs-card, .sis-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activateEl(g.dataset.el!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activateEl(g.dataset.el!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activateEl(path.dataset.from!));
      path.addEventListener("mouseleave", deactivate);
    });
  })();
</script>

<style>
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .flow-wrap svg {
    display: block;
    width: auto;
    height: auto;
    margin: 0 auto;
    background: var(--paper);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
