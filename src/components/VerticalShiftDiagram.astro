---
/**
 * Vertical shift diagram — the shift-centric counterpart of VerticalFlow,
 * for critical-shift detail pages. Strict three-band structure, top to
 * bottom:
 *
 *   1. the critical shift card (text only — shifts carry no image today)
 *   2. all bioregions working on it in ONE horizontal row (compact cards,
 *      image on the left of each)
 *   3. all systemic innovations (of those bioregions, tagged with this
 *      shift) in ONE OR TWO horizontal rows (image on TOP of each card)
 *
 * Unlike VerticalFlow (where one innovation can fan out to several shifts),
 * each innovation here belongs to exactly one bioregion, so every SI card
 * has a single connector — no primary/dashed multi-tag branching needed.
 * Hovering the shift card highlights everything; hovering a bioregion
 * highlights its innovations; hovering an innovation highlights its
 * bioregion + the shift.
 */
import FlowCard from "./FlowCard.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth } from "../lib/text";
import { shiftColor } from "../lib/shift-pages";
import type { ShiftBioRef, ShiftInnovationRef } from "../lib/shift-pages";

interface Props {
  shift: {
    name: string;
    emoji: string | null;
    shift: string;
    leveragePoint: string;
    slug: string;
  };
  bioregions: ShiftBioRef[];
  innovations: ShiftInnovationRef[];
}

const { shift, bioregions, innovations } = Astro.props as Props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

function resolveImageSource(file: string | null | undefined, url: string | null | undefined): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

const COLOR = shiftColor(shift.slug);

// --- canvas ---
const W = 1700;
const margin = { top: 90, right: 60, bottom: 60, left: 60 };

// --- critical shift card (top, text only — centred) ---
const shiftW = 560;
const shiftX = W / 2;
const shiftLeft = shiftX - shiftW / 2;
const shiftTop = margin.top;
const shiftTextW = shiftW - 48;
const SHIFT_NAME_MAX_LINES = 2;
const SHIFT_LEVERAGE_MAX_LINES = 3;
const SHIFT_DESC_MAX_LINES = 4;
const shiftNameLineCount = Math.min(
  wrapToWidth(`${shift.emoji || ""} ${shift.name}`.trim(), shiftTextW, 22, "display").length,
  SHIFT_NAME_MAX_LINES
);
const shiftLeverageLineCount = Math.min(
  wrapToWidth(shift.leveragePoint || "", shiftTextW, 11, "body").length,
  SHIFT_LEVERAGE_MAX_LINES
);
const shiftDescLineCount = Math.min(
  wrapToWidth(shift.shift || "", shiftTextW, 11, "body").length,
  SHIFT_DESC_MAX_LINES
);
const shiftNameLineHeight = 26;
const shiftBodyLineHeight = 15;
const shiftTextHeight =
  shiftNameLineCount * shiftNameLineHeight +
  10 +
  shiftLeverageLineCount * shiftBodyLineHeight +
  10 +
  shiftDescLineCount * shiftBodyLineHeight;
const shiftH = Math.max(140, shiftTextHeight + 48);
const shiftBottom = shiftTop + shiftH;

// --- bioregions: ONE horizontal row, compact cards (shrink to fit, like
// VerticalFlow's critical-shift row) — image on the left of each ---
const bioCount = Math.max(1, bioregions.length);
const bioGap = bioCount > 9 ? 8 : 12;
const bioW = Math.min(180, Math.floor((W - margin.left - margin.right - (bioCount - 1) * bioGap) / bioCount));
const BIO_IMG_W = 56;
const BIO_IMG_GAP = 10;
// Same "was never capped" situation as the shift-card fields above.
const BIO_NAME_MAX_LINES = 2;
const BIO_COUNTRY_MAX_LINES = 1;
const bioCards = bioregions.map((b) => {
  const hasImage = !!resolveImageSource(b.imageFile, b.imageUrl);
  const textW = hasImage ? bioW - BIO_IMG_W - BIO_IMG_GAP - 12 : bioW - 24;
  const nameLineCount = Math.min(wrapToWidth(b.name || "", textW, 13, "display").length, BIO_NAME_MAX_LINES);
  const countryLineCount = Math.min(
    wrapToWidth(b.country || "", textW, 9, "display").length,
    BIO_COUNTRY_MAX_LINES
  );
  return { ...b, hasImage, nameLineCount, countryLineCount };
});
const bioH = bioCards.length
  ? Math.max(72, ...bioCards.map((c) => 20 + c.nameLineCount * 15 + (c.countryLineCount ? 4 + c.countryLineCount * 11 : 0) + 14))
  : 72;
const bioRowW = bioCards.length * bioW + Math.max(0, bioCards.length - 1) * bioGap;
const bioStartX = (W - bioRowW) / 2;
const bioTop = shiftBottom + 115;
const bioBottom = bioTop + bioH;
const bioX = (i: number) => bioStartX + i * (bioW + bioGap) + bioW / 2;
const bioIndexBySlug = new Map(bioCards.map((b, i) => [b.slug, i]));

// --- systemic innovations: ONE or TWO horizontal rows (same sizing as
// VerticalFlow) ---
const sisW = 180;
const sisImgH = 135;
const sisCardH = 176;
const sisGap = 12;

// Order innovations by their bioregion (so each bioregion's fan stays
// local), unmatched ones last.
const orderedInnovations = [...innovations].sort((a, b) => {
  const ia = bioIndexBySlug.get(a.bioregionSlug) ?? 999;
  const ib = bioIndexBySlug.get(b.bioregionSlug) ?? 999;
  return ia - ib;
});

// Same "was never capped" situation as the other fields above — each card
// still grows to its own real content height (unchanged design), just with
// a safe upper bound instead of an unbounded one.
const SIS_NAME_MAX_LINES = 3;
const SIS_DESC_MAX_LINES = 6;
const sisCards = orderedInnovations.map((inv) => {
  const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
  const nameLineCount = Math.min(wrapToWidth(inv.name || "", sisW - 24, 12, "display").length, SIS_NAME_MAX_LINES);
  const descLineCount = Math.min(
    wrapToWidth(inv.description || "", sisW - 24, 9, "body").length,
    SIS_DESC_MAX_LINES
  );
  const contentH = sisImgH + 8 + nameLineCount * 14 + 3 + descLineCount * 12 + 16;
  return { ...inv, hasImage, nameLineCount, descLineCount, cardH: Math.max(sisCardH, contentH) };
});

const perLine = Math.max(1, Math.floor((W - margin.left - margin.right + sisGap) / (sisW + sisGap)));
const rowCount = Math.ceil(sisCards.length / perLine);
const rowHeights: number[] = [];
for (let r = 0; r < rowCount; r++) {
  const count = Math.min(perLine, sisCards.length - r * perLine);
  rowHeights.push(Math.max(...sisCards.slice(r * perLine, r * perLine + count).map((c) => c.cardH)));
}
let yCum = bioBottom + 95;
const rowYs = rowHeights.map((h) => {
  const y = yCum;
  yCum += h + 16;
  return y;
});
const sisPositions = sisCards.map((_, j) => {
  const row = Math.floor(j / perLine);
  const count = Math.min(perLine, sisCards.length - row * perLine);
  const rowWidth = count * sisW + (count - 1) * sisGap;
  const startX = margin.left + (W - margin.left - margin.right - rowWidth) / 2;
  return {
    x: startX + (j % perLine) * (sisW + sisGap),
    y: rowYs[row],
  };
});
const sisBottom = rowYs.length ? rowYs[rowYs.length - 1] + rowHeights[rowHeights.length - 1] : bioBottom + 95;
const height = sisBottom + margin.bottom;

// --- bus tree: shift → bioregions ---
const busY = shiftBottom + 55;
const busLeft = margin.left + 40;
const busRight = W - margin.right - 40;

// SI → bioregion connectors all share ONE horizontal bus line (row 1's
// height) — same fix and rationale as VerticalFlow.astro: without it, a
// second row's bus lands at a different height that often falls inside an
// earlier row's card band, reading as a line hidden behind cards.
const sisBusY = (bioBottom + rowYs[0]) / 2;

function ortho(x1: number, y1: number, x2: number, y2: number, busY: number) {
  return `M${x1},${y1} L${x1},${busY} L${x2},${busY} L${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width={W}
    height="auto"
    viewBox={`0 0 ${W} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Vertical layout — {shift.name}</title>
    <desc>
      {shift.name} on top, the bioregions working on it in a row, then their systemic innovations in horizontal rows.
    </desc>


    {/* Bus tree: shift → bioregions */}
    <path class="conn conn-shift-bus" data-from="shift" data-to="shift" d={`M${shiftX},${shiftBottom} L${shiftX},${busY} L${busLeft},${busY} L${busRight},${busY}`} fill="none" stroke={COLOR} stroke-width="2.5" opacity="0.35" stroke-linejoin="round" />
    {bioCards.map((b, i) => (
      <path
        class={`conn conn-drop conn-drop-${b.slug}`}
        data-from="shift"
        data-to={`bio:${b.slug}`}
        d={`M${bioX(i)},${busY} L${bioX(i)},${bioTop}`}
        fill="none"
        stroke={COLOR}
        stroke-width="2.5"
        opacity="0.4"
      />
    ))}

    {/* Innovations → their bioregion (each SI belongs to exactly one) */}
    {sisCards.map((inv, j) => {
      const fromX = sisPositions[j].x + sisW / 2;
      const fromY = sisPositions[j].y;
      const bioIdx = bioIndexBySlug.get(inv.bioregionSlug);
      if (bioIdx === undefined) return null;
      return (
        <path
          class="conn conn-bio-sis"
          data-from={`sis:${inv.slug}`}
          data-to={`bio:${inv.bioregionSlug}`}
          d={ortho(fromX, fromY, bioX(bioIdx), bioBottom, sisBusY)}
          fill="none"
          stroke={COLOR}
          stroke-width="2.5"
          opacity="0.45"
        />
      );
    })}

    {/* Critical shift card */}
    <FlowCard
      x={shiftLeft}
      y={shiftTop}
      width={shiftW}
      height={shiftH}
      kind="shift"
      imagePosition="none"
      title={`${shift.emoji || ""} ${shift.name}`.trim()}
      titleMaxLines={SHIFT_NAME_MAX_LINES}
      titleSize={22}
      subtitle={shift.leveragePoint || null}
      subtitleMaxLines={SHIFT_LEVERAGE_MAX_LINES}
      subtitleSize={11}
      body={shift.shift || null}
      bodyMaxLines={SHIFT_DESC_MAX_LINES}
      bodySize={11}
      dataEl="shift"
      dataRoot
      borderColor={COLOR}
      centered
    />

    {/* Bioregion cards (one row) — clickable, like the horizontal view,
        image on the left when the bioregion has one */}
    {bioCards.map((b, i) => {
      const bioImageSrc = resolveImageSource(b.imageFile, b.imageUrl);
      return (
        <FlowCard
          x={bioStartX + i * (bioW + bioGap)}
          y={bioTop}
          width={bioW}
          height={bioH}
          kind="bio"
          imagePosition={bioImageSrc ? "left" : "none"}
          imageSrc={bioImageSrc}
          imageSize={BIO_IMG_W}
          title={b.name}
          titleMaxLines={BIO_NAME_MAX_LINES}
          titleSize={13}
          subtitle={b.country || null}
          subtitleMaxLines={BIO_COUNTRY_MAX_LINES}
          subtitleSize={9}
          href={`${base}bioregions/${b.slug}/`}
          dataEl={`bio:${b.slug}`}
          radius={10}
          paddingX={10}
          paddingY={8}
        />
      );
    })}

    {/* Systemic innovation cards (image on top) — image + external-link
        badge share one clickable region (the whole image, not just the
        small badge); the text is deliberately not part of that link. */}
    {sisCards.map((inv, j) => {
      const { x, y } = sisPositions[j];
      const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
      return (
        <FlowCard
          x={x}
          y={y}
          width={sisW}
          height={inv.cardH}
          kind="sis"
          imagePosition={sisImageSrc ? "top" : "none"}
          imageSrc={sisImageSrc}
          imageSize={sisImgH}
          imageHref={inv.externalUrl}
          imageExternal
          title={inv.name}
          titleMaxLines={SIS_NAME_MAX_LINES}
          body={inv.description || null}
          bodyMaxLines={SIS_DESC_MAX_LINES}
          bodySize={9}
          dataEl={`sis:${inv.slug}`}
          paddingX={12}
          paddingY={8}
        />
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    function activateEl(elId: string) {
      svg!.classList.add("has-active");
      const match = new Set([elId]);
      svg!.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
        const from = path.dataset.from;
        const to = path.dataset.to;
        if (from === elId || to === elId) {
          if (from) match.add(from);
          if (to) match.add(to);
        }
      });
      // Hovering a systemic innovation also highlights the diagram's root
      // card (the critical shift card here), so the innovation -> bioregion
      // -> root chain lights up end to end.
      if (elId.startsWith("sis:")) {
        const root = svg!.querySelector<HTMLElement>("[data-root]");
        if (root?.dataset.el) match.add(root.dataset.el);
      }
      // Cards are now real HTML elements (rendered via <foreignObject>, not
      // raw SVG <g>) — this selector still matches both them and the SVG
      // .conn <path> lines, so the type here covers both (plain `Element`
      // doesn't have `.dataset`, only the HTML/SVG-specific interfaces do).
      svg!.querySelectorAll<HTMLElement | SVGElement>(".card, .conn").forEach((el) => {
        if (el.classList.contains("conn")) {
          const from = el.dataset.from;
          const to = el.dataset.to;
          el.classList.toggle("active", !!from && !!to && match.has(from) && match.has(to));
        } else {
          el.classList.toggle("active", !!el.dataset.el && match.has(el.dataset.el));
        }
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<HTMLElement | SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    // Cards are real HTML (an <a> when the whole card links, a <div>
    // otherwise) rendered inside <foreignObject> — HTMLElement covers both.
    svg.querySelectorAll<HTMLElement>(".shift-card, .bio-card, .sis-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activateEl(g.dataset.el!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activateEl(g.dataset.el!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activateEl(path.dataset.from!));
      path.addEventListener("mouseleave", deactivate);
    });

    // Open centred on the critical shift card (long pages scroll up/down).
    function centerOnShift() {
      const card = svg!.querySelector<HTMLElement>(".shift-card");
      if (!card) return;
      const r = card.getBoundingClientRect();
      const y = window.scrollY + r.top - (window.innerHeight - r.height) / 2;
      window.scrollTo(0, Math.max(0, y));
    }
    if (document.readyState === "complete") requestAnimationFrame(centerOnShift);
    else window.addEventListener("load", () => requestAnimationFrame(centerOnShift));
  })();
</script>

<style is:global>
  /* is:global (not scoped): the .card elements this CSS targets are now
     rendered by the separate FlowCard.astro component (inside a
     <foreignObject>), so they carry FlowCard's own scoping attribute, not
     this file's — a normal scoped selector here would silently never match
     them (same class of bug already hit once this session with MapLibre's
     JS-created markers needing is:global for the same reason). */
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flow-wrap svg {
    display: block;
    width: auto;
    height: auto;
    margin: 0 auto;
    background: var(--paper-raised);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
