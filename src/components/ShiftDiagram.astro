---
/**
 * Critical-shift diagram — the shift-centric counterpart of FlowDiagram.
 *
 * Columns: critical shift card (left) → bioregion cards working on it
 * (centre) → the systemic innovations of those bioregions tagged with the
 * shift (right). Same connector + hover-highlight behaviour as FlowDiagram.
 */
import FlowCard from "./FlowCard.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth } from "../lib/text";
import { shiftColor } from "../lib/shift-pages";
import type { ShiftBioRef, ShiftInnovationRef } from "../lib/shift-pages";

// Card height still has to be decided ahead of time (SVG has no
// auto-layout). See FlowDiagram.astro for the full rationale — in short:
// wrapToWidth's word-wrap simulation is the only SAFE line-count estimate
// to size a box off (a naive length÷width division under-predicts real
// line counts and causes real overflow), and a STANDARD floor on top of it
// is what keeps typical-length cards a consistent height instead of one
// that only reflects the estimate's own per-string quirks.
function estimateLineCount(lines: string[], standardLines: number, maxLines: number): number {
  return Math.min(Math.max(standardLines, lines.length), maxLines);
}

interface Props {
  shift: {
    name: string;
    emoji: string | null;
    shift: string;
    leveragePoint: string;
    slug: string;
  };
  bioregions: ShiftBioRef[];
  innovations: ShiftInnovationRef[];
}

const { shift, bioregions, innovations } = Astro.props as Props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

function resolveImageSource(file: string | null | undefined, url: string | null | undefined): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

const COLOR = shiftColor(shift.slug);

const COLUMN_GAP = 190;
const margin = { top: 40, right: 150, bottom: 40, left: 150 };
const shiftW = 300;
const bioW = 250;
const sisW = 320;
const width = margin.left + shiftW + COLUMN_GAP + bioW + COLUMN_GAP + sisW + margin.right;
const shiftColLeft = margin.left;
const shiftX = shiftColLeft + shiftW / 2;
const shiftRight = shiftColLeft + shiftW;
const bioColLeft = shiftRight + COLUMN_GAP;
const bioX = bioColLeft + bioW / 2;
const bioRight = bioColLeft + bioW;
const sisX = bioRight + COLUMN_GAP;

// --- Critical shift card (left column) ---
// Only one of these per page, so there's no sibling to be "consistent"
// with — just a safe max-lines cap (via wrapToWidth's line count, not a
// standard floor).
const SHIFT_NAME_MAX_LINES = 2;
const SHIFT_LEVERAGE_MAX_LINES = 5;
const SHIFT_DESC_MAX_LINES = 4;
const shiftNameLineCount = Math.min(
  wrapToWidth(`${shift.emoji || ""} ${shift.name}`.trim(), shiftW - 48, 16, "display").length,
  SHIFT_NAME_MAX_LINES
);
const shiftLeverageLineCount = Math.min(
  wrapToWidth(shift.leveragePoint || "", shiftW - 48, 10, "body").length,
  SHIFT_LEVERAGE_MAX_LINES
);
const shiftDescLineCount = Math.min(
  wrapToWidth(shift.shift || "", shiftW - 48, 10, "body").length,
  SHIFT_DESC_MAX_LINES
);
const shiftNameLineHeight = 20;
const shiftBodyLineHeight = 13.5;
// generous breathing room between title, leverage point and description
const shiftTextHeight =
  shiftNameLineCount * shiftNameLineHeight +
  14 +
  shiftLeverageLineCount * shiftBodyLineHeight +
  12 +
  shiftDescLineCount * shiftBodyLineHeight;
const shiftCardHeight = Math.max(140, shiftTextHeight + 36);

// --- Bioregion cards (centre column) ---
const BIO_IMAGE_H = 110;
const BIO_PAD = 16;
const bioTextWidth = bioW - 32;
const BIO_NAME_MAX_LINES = 2;
const BIO_COUNTRY_MAX_LINES = 1;
const BIO_DESC_MAX_LINES = 4;
const BIO_NAME_STANDARD_LINES = 1;
const BIO_DESC_STANDARD_LINES = 3;
const bioCards = bioregions.map((b) => {
  const nameLineCount = estimateLineCount(
    wrapToWidth(b.name || "", bioTextWidth, 13, "display"),
    BIO_NAME_STANDARD_LINES,
    BIO_NAME_MAX_LINES
  );
  const countryLineCount = b.country
    ? Math.min(wrapToWidth(b.country, bioTextWidth, 9, "display").length, BIO_COUNTRY_MAX_LINES)
    : 0;
  const descLineCount = estimateLineCount(
    wrapToWidth(b.shortNarrative ?? "", bioTextWidth, 9, "body"),
    BIO_DESC_STANDARD_LINES,
    BIO_DESC_MAX_LINES
  );
  const textHeight =
    nameLineCount * 16.5 +
    (countryLineCount ? 4 + countryLineCount * 11 : 0) +
    (descLineCount ? 6 + descLineCount * 12 : 0);
  const cardHeight = BIO_IMAGE_H + textHeight + BIO_PAD * 2;
  return { ...b, nameLineCount, countryLineCount, descLineCount, cardHeight };
});
const bioGap = 18;
const biosHeight = bioCards.reduce((sum, c, i) => sum + c.cardHeight + (i < bioCards.length - 1 ? bioGap : 0), 0);

// --- Systemic innovation cards (right column), uniform height: every card
// shares whichever height the single most-demanding card's real content
// needs (via the fixed-point loop below — the image is always exactly that
// shared height too, squared off by construction, so there's no separate
// "minimum" to get wrong the way FlowDiagram's per-card sizing did). ---
const SIS_TEXT_GAP = 18;
const SIS_TEXT_RIGHT = 12;
const SIS_MIN_IMG = 104;
const SIS_NAME_MAX_LINES = 3;
const SIS_BIO_MAX_LINES = 1;
const SIS_DESC_MAX_LINES = 5;
let sisCardHeight = SIS_MIN_IMG;
let sisCards: any[] = [];
for (let i = 0; i < 5; i++) {
  sisCards = innovations.map((inv) => {
    const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
    const leftInset = hasImage ? sisCardHeight + SIS_TEXT_GAP : 16;
    const textWidth = sisW - leftInset - SIS_TEXT_RIGHT;
    const nameLineCount = Math.min(wrapToWidth(inv.name || "", textWidth, 12, "display").length, SIS_NAME_MAX_LINES);
    const bioLineCount = inv.bioregionName
      ? Math.min(wrapToWidth(inv.bioregionName, textWidth, 8.5, "body").length, SIS_BIO_MAX_LINES)
      : 0;
    const descLineCount = Math.min(
      wrapToWidth(inv.description || "", textWidth, 9.5, "body").length,
      SIS_DESC_MAX_LINES
    );
    // bioregion sits right under the title, description below it
    const textHeight = nameLineCount * 14 + 4 + bioLineCount * 11 + 4 + descLineCount * 12 + 6;
    return { ...inv, hasImage, nameLineCount, descLineCount, bioLineCount, textHeight };
  });
  const next = Math.max(SIS_MIN_IMG, ...sisCards.map((c) => c.textHeight + 36));
  if (next === sisCardHeight) break;
  sisCardHeight = next;
}
sisCards = sisCards.map((c) => ({ ...c, cardHeight: sisCardHeight }));
const sisGap = 16;
const sisHeight = sisCards.reduce((sum, c, i) => sum + c.cardHeight + (i < sisCards.length - 1 ? sisGap : 0), 0);

const contentHeight = Math.max(shiftCardHeight, biosHeight, sisHeight);
const height = contentHeight + margin.top + margin.bottom + 28;

function stackPositions(cards: { cardHeight: number }[], startY: number, gap: number) {
  const positions: number[] = [];
  let y = startY;
  cards.forEach((c, i) => {
    positions.push(y + c.cardHeight / 2);
    y += c.cardHeight + gap;
  });
  return positions;
}

const shiftY = height / 2;
const bioPositions = stackPositions(bioCards, (height - biosHeight) / 2, bioGap);
const sisPositions = stackPositions(sisCards, (height - sisHeight) / 2, sisGap);

function curve(x1: number, y1: number, x2: number, y2: number, strength = 0.5) {
  const dx = x2 - x1;
  const mx = x1 + dx * strength;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width={width}
    height="auto"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Critical shift {shift.name} — bioregions and systemic innovations</title>
    <desc>
      {bioregions.length} bioregions work on this critical shift through {innovations.length} systemic innovations.
    </desc>

    {/* Shift → bioregion lines */}
    {bioPositions.map((_, i) => (
      <path
        class="conn conn-shift-bio"
        data-from="shift"
        data-to={`bio:${bioCards[i].slug}`}
        d={curve(shiftRight, shiftY, bioColLeft, bioPositions[i])}
        fill="none"
        stroke={COLOR}
        stroke-width="3"
        opacity="0.5"
      />
    ))}

    {/* Bioregion → its systemic innovations */}
    {sisPositions.map((_, j) => {
      const inv = sisCards[j];
      const bioIdx = bioCards.findIndex((b) => b.slug === inv.bioregionSlug);
      if (bioIdx < 0) return null;
      return (
        <path
          class="conn conn-bio-sis"
          data-from={`bio:${inv.bioregionSlug}`}
          data-to={`sis:${inv.slug}`}
          d={curve(bioRight, bioPositions[bioIdx], sisX, sisPositions[j])}
          fill="none"
          stroke={COLOR}
          stroke-width="2.5"
          opacity="0.45"
        />
      );
    })}

    {/* Critical shift card */}
    <FlowCard
      x={shiftColLeft}
      y={shiftY - shiftCardHeight / 2}
      width={shiftW}
      height={shiftCardHeight}
      kind="shift"
      imagePosition="none"
      title={`${shift.emoji || ""} ${shift.name}`.trim()}
      titleMaxLines={SHIFT_NAME_MAX_LINES}
      subtitle={shift.leveragePoint || null}
      subtitleMaxLines={SHIFT_LEVERAGE_MAX_LINES}
      body={shift.shift || null}
      bodyMaxLines={SHIFT_DESC_MAX_LINES}
      dataEl="shift"
      dataRoot
      borderColor={COLOR}
    />

    {/* Bioregion cards — smaller/secondary here than on FlowDiagram's own
        bioregion page (this is "which bioregions work on this shift", not
        the page's main subject), hence the smaller radius/font overrides. */}
    {bioCards.map((b, i) => (
      <FlowCard
        x={bioColLeft}
        y={bioPositions[i] - b.cardHeight / 2}
        width={bioW}
        height={b.cardHeight}
        kind="bio"
        imagePosition="top"
        imageSrc={resolveImageSource(b.imageFile, b.imageUrl)}
        imageSize={BIO_IMAGE_H}
        title={b.name}
        titleMaxLines={BIO_NAME_MAX_LINES}
        titleSize={13}
        subtitle={b.country || null}
        subtitleMaxLines={BIO_COUNTRY_MAX_LINES}
        subtitleSize={9}
        body={b.shortNarrative ?? null}
        bodyMaxLines={BIO_DESC_MAX_LINES}
        bodySize={9}
        href={`${base}bioregions/${b.slug}/`}
        dataEl={`bio:${b.slug}`}
        radius={14}
      />
    ))}

    {/* Systemic innovation cards — image + external-link badge share one
        clickable region (the whole image, not just the small badge); the
        text is deliberately not part of that link. Untagged innovations
        (no matching shift tag) get a dashed border instead of solid. */}
    {sisCards.map((inv, j) => {
      const untagged = inv.tags?.length === 0;
      const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
      const imgW = Math.min(inv.cardHeight, sisW);
      return (
        <FlowCard
          x={sisX}
          y={sisPositions[j] - inv.cardHeight / 2}
          width={sisW}
          height={inv.cardHeight}
          kind="sis"
          imagePosition={sisImageSrc ? "left" : "none"}
          imageSrc={sisImageSrc}
          imageSize={imgW}
          imageHref={inv.externalUrl}
          imageExternal
          title={inv.name}
          titleMaxLines={SIS_NAME_MAX_LINES}
          subtitle={inv.bioregionName || null}
          subtitleMaxLines={SIS_BIO_MAX_LINES}
          body={inv.description || null}
          bodyMaxLines={SIS_DESC_MAX_LINES}
          dataEl={`sis:${inv.slug}`}
          borderColor={untagged ? "var(--bwl-muted)" : "var(--line-strong)"}
          dashed={untagged}
        />
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    function activateEl(elId: string) {
      svg!.classList.add("has-active");
      const match = new Set([elId]);
      svg!.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
        const from = path.dataset.from;
        const to = path.dataset.to;
        if (from === elId || to === elId) {
          if (from) match.add(from);
          if (to) match.add(to);
        }
      });
      // Hovering a systemic innovation also highlights the diagram's root card
      // (the critical shift card here), so the innovation -> bioregion -> root
      // chain lights up end to end.
      if (elId.startsWith("sis:")) {
        const root = svg!.querySelector<HTMLElement>("[data-root]");
        if (root?.dataset.el) match.add(root.dataset.el);
      }
      // Cards are now real HTML elements (rendered via <foreignObject>, not
      // raw SVG <g>) — this selector still matches both them and the SVG
      // .conn <path> lines, so the type here covers both (plain `Element`
      // doesn't have `.dataset`, only the HTML/SVG-specific interfaces do).
      svg!.querySelectorAll<HTMLElement | SVGElement>(".card, .conn").forEach((el) => {
        if (el.classList.contains("conn")) {
          const from = el.dataset.from;
          const to = el.dataset.to;
          el.classList.toggle("active", !!from && !!to && match.has(from) && match.has(to));
        } else {
          el.classList.toggle("active", !!el.dataset.el && match.has(el.dataset.el));
        }
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<HTMLElement | SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    // Cards are real HTML (an <a> when the whole card links, a <div>
    // otherwise) rendered inside <foreignObject> — HTMLElement covers both.
    svg.querySelectorAll<HTMLElement>(".shift-card, .bio-card, .sis-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activateEl(g.dataset.el!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activateEl(g.dataset.el!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activateEl(path.dataset.from!));
      path.addEventListener("mouseleave", deactivate);
    });

    // Open centred on the critical shift card (long pages scroll up/down).
    function centerOnShift() {
      const card = svg!.querySelector<HTMLElement>(".shift-card");
      if (!card) return;
      const r = card.getBoundingClientRect();
      const y = window.scrollY + r.top - (window.innerHeight - r.height) / 2;
      window.scrollTo(0, Math.max(0, y));
    }
    if (document.readyState === "complete") requestAnimationFrame(centerOnShift);
    else window.addEventListener("load", () => requestAnimationFrame(centerOnShift));
  })();
</script>

<style is:global>
  /* is:global (not scoped): the .card elements this CSS targets are now
     rendered by the separate FlowCard.astro component (inside a
     <foreignObject>), so they carry FlowCard's own scoping attribute, not
     this file's — a normal scoped selector here would silently never match
     them (same class of bug already hit once this session with MapLibre's
     JS-created markers needing is:global for the same reason). */
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* short diagrams (few cards) are centred vertically on the page */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flow-wrap svg {
    display: block;
    width: auto; /* fixed px width from the width attribute: browser zoom scales it */
    height: auto;
    margin: 0 auto;
    background: var(--paper-raised);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
