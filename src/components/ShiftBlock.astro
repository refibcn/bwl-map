---
import InnovationCard from "./InnovationCard.astro";
import RidgeLine from "./RidgeLine.astro";

interface Shift {
  slug: string;
  name: string;
  shift: string;
  leveragePoint: string;
  systemicBarrier: string;
}

interface Props {
  shift: Shift;
  innovations: any[];
  shiftNames: Record<string, string>;
  variant: 1 | 2;
}

const { shift, innovations, shiftNames, variant } = Astro.props as Props;
---

<section id={shift.slug} class="shift-block">
  <RidgeLine variant={variant} />
  <p class="eyebrow">Critical shift</p>
  <h2 class="shift-name">{shift.name}</h2>
  <p class="shift-desc">{shift.shift}</p>
  <dl class="shift-meta">
    <div>
      <dt>Leverage point</dt>
      <dd>{shift.leveragePoint}</dd>
    </div>
    <div>
      <dt>Systemic barrier</dt>
      <dd>{shift.systemicBarrier}</dd>
    </div>
  </dl>
  <p class="eyebrow" style="margin-bottom:10px">
    {innovations.length} linked systemic innovation{innovations.length === 1 ? "" : "s"}
  </p>
  <div class="innovation-grid">
    {innovations.map((innovation) => (
      <InnovationCard innovation={innovation} currentShiftSlug={shift.slug} shiftNames={shiftNames} />
    ))}
  </div>
</section>
