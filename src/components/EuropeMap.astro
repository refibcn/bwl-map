---
/**
 * BWL map landing — w1-style Europe map (natural proportions) with clickable
 * region markers (photo circles, no pop-ups) and a left side panel holding
 * the brand block (logo + title) and the bioregion list. The panel can be
 * collapsed (map goes full width) via the ✕ and reopened with a floating
 * "☰ Bioregions" button styled like the bioregion pages' back-link.
 *
 * Markers are positioned by the same projection used to generate the land
 * geometry (src/lib/map-projection.ts), so they sit on the actual spots.
 */
import europeMap from "../data/europe-map.json";
import { notionImageUrl } from "../lib/images";
import type { MapRegion } from "../lib/map-regions";

interface Props {
  regions: MapRegion[];
}

const { regions } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const W = europeMap.width;
const H = europeMap.height;
// Deduplicate path strings: several countries share land paths in the 50m
// set (e.g. San Marino is a hole in Italy) — a Set shrinks the SVG.
const paths = [...new Set(europeMap.countries.flatMap((c) => c.d))];
---

<div class="bwc-hero" id="bwcHero">
  <div class="bwc-layout">
    <aside class="bio-panel">
      <button class="bio-close" type="button" aria-label="Hide the bioregions panel">✕</button>
      <img class="bwl-logo" src={`${base}bwl-logo.jpg`} alt="Bioregional Weaving Labs" />
      <h1 class="bio-hero-title">
        Weaving Communities of Action,<br />
        Rooted in Place
      </h1>
      <p class="bio-hero-subtitle">Explore a bioregion by clicking on the map</p>
      <div class="bio-divider"></div>
      <h2 class="bio-title">Bioregions</h2>
      <div class="bio-list-wrap">
        <div class="bio-list">
          {regions.map((r) => (
            <a class="bio-row" href={`${base}bioregions/${r.slug}/`}>
              <span class="bio-name">{r.name}</span>
              <span class="bio-country">{r.country}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>

    <div class="bwc-stage-col">
      <div class="bwc-stage" style={`aspect-ratio:${W}/${H}`}>
        <svg
          class="bwc-map"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label="Map of Europe with bioregion markers"
          preserveAspectRatio="xMidYMid meet"
        >
          <defs>
            <filter id="bwc-shadow" x="-10%" y="-10%" width="130%" height="140%">
              <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#20404f" flood-opacity="0.28" />
            </filter>
          </defs>
          <g class="land" filter="url(#bwc-shadow)">
            {paths.map((d) => <path d={d} />)}
          </g>
        </svg>

        <div class="bwc-markers">
          {regions.map((r, i) => {
            const img = notionImageUrl(r.imageFile) ?? r.imageUrl ?? undefined;
            return (
              <a
                class="bwc-marker"
                href={`${base}bioregions/${r.slug}/`}
                style={`--x:${r.x.toFixed(3)}%;--y:${r.y.toFixed(3)}%;--i:${i};--ring:${r.ring}`}
                aria-label={r.name}
              >
                {img ? (
                  <span class="bwc-ring-img"><img src={img} alt="" loading="lazy" /></span>
                ) : (
                  <span class="bwc-dot"></span>
                )}
                <span class="bwc-label">{r.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <button class="bio-reopen" type="button" hidden>☰ Bioregions</button>
</div>

<script>
  const hero = document.getElementById("bwcHero");

  function play() {
    hero?.classList.add("is-loaded");
  }
  if (document.readyState === "complete") requestAnimationFrame(play);
  else window.addEventListener("load", () => requestAnimationFrame(play));

  // Collapsible side panel: ✕ hides it (map goes full width), the floating
  // ☰ button brings it back. ALWAYS open by default on every page load —
  // the closed state is not persisted.
  const closeBtn = hero?.querySelector<HTMLButtonElement>(".bio-close");
  const reopenBtn = hero?.querySelector<HTMLButtonElement>(".bio-reopen");
  let hidden = false;

  function applyPanel() {
    hero?.classList.toggle("panel-hidden", hidden);
    if (reopenBtn) reopenBtn.hidden = !hidden;
  }
  closeBtn?.addEventListener("click", () => {
    hidden = true;
    applyPanel();
  });
  reopenBtn?.addEventListener("click", () => {
    hidden = false;
    applyPanel();
  });
  applyPanel();
</script>

<style>
  /* ================================================================
     Palette (w1-derived) — kept local to the hero.
     ================================================================ */
  .bwc-hero {
    --bwc-ocean: #8da5af;      /* light blue-grey sea            */
    --bwc-land: #e9e6d5;       /* warm cream land                */
    --bwc-title: #20404f;      /* headline colour                */
    --bwc-subtitle: #0a1419;
    --bwc-card-bg: #f9f9f3;
    --bwc-shadow: rgba(20, 40, 30, 0.28);
    --bwc-font-head: "Besley", Georgia, "Times New Roman", serif;
    --bwc-font-body: "Lato", Helvetica, Arial, sans-serif;
  }

  .bwc-hero * { box-sizing: border-box; margin: 0; padding: 0; }

  .bwc-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow: hidden;
    font-family: var(--bwc-font-body);
    background: var(--bwc-ocean);
  }

  /* side panel (left) + map (right): the map fills the whole column width. */
  .bwc-layout {
    display: flex;
    align-items: stretch;
    gap: 24px;
    width: 100%;
    padding: 24px;
  }
  .bwc-stage-col {
    flex: 4 1 0;
    min-width: 0;
    display: flex;
  }
  .bwc-stage {
    position: relative;
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: auto auto auto 0; /* left-flush with the panel, vertically centred */
  }

  .bwc-map {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .land path { fill: var(--bwc-land); }

  /* -------- side panel (left): brand block + bioregion list -------- */
  .bio-panel {
    flex: 1 1 0;
    min-width: 320px;
    max-width: 400px;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--bwc-card-bg);
    border: 1px solid rgba(32, 64, 79, 0.18);
    border-radius: 18px;
    padding: 28px 54px 36px;
    box-shadow: 0 18px 40px var(--bwc-shadow);
  }
  .bio-close {
    align-self: flex-end;
    width: 28px;
    height: 28px;
    margin-bottom: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(32, 64, 79, 0.18);
    border-radius: 50%;
    background: #fffff0;
    color: var(--bwc-title);
    font-size: 11px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .bio-close:hover {
    background: var(--bwc-title);
    color: #fff;
    border-color: var(--bwc-title);
  }
  .bwl-logo {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(32, 64, 79, 0.25);
    margin-bottom: 14px;
  }
  .bio-hero-title {
    font-family: var(--bwc-font-head);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.18;
    color: var(--bwc-title);
  }
  .bio-hero-subtitle {
    margin-top: 10px;
    font-family: var(--bwc-font-body);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    color: #0a1419;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 6px;
    padding: 8px 12px;
  }
  .bio-divider {
    height: 1px;
    background: rgba(32, 64, 79, 0.14);
    margin: 22px 0 20px;
  }
  .bio-title {
    font-family: var(--bwc-font-head);
    font-weight: 700;
    font-size: 19px;
    color: var(--bwc-title);
    margin-bottom: 14px;
  }

  /* the list sits in its own inset container; it scrolls internally so the
     panel always fits the screen height (and the map can fill the rest) */
  .bio-list-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    background: rgba(32, 64, 79, 0.05);
    border: 1px solid rgba(32, 64, 79, 0.08);
    border-radius: 14px;
    padding: 0 36px;
    background: transparent;
    border-color: transparent;
  }
  .bio-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bio-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 20px 52px;
    background: #fffff0;
    border: 1px solid rgba(32, 64, 79, 0.12);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .bio-row:hover {
    border-color: var(--bwl-secondary);
    background: #fff;
  }
  .bio-name {
    font-family: var(--bwc-font-head);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.35;
    color: var(--bwc-title);
  }
  .bio-country {
    flex-shrink: 0;
    font-family: var(--bwc-font-body);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6d7a6b;
    border: 1px solid rgba(32, 64, 79, 0.15);
    border-radius: 999px;
    padding: 4px 10px;
  }

  /* panel hidden: map takes the whole width */
  .bwc-hero.panel-hidden .bio-panel { display: none; }
  .bwc-hero.panel-hidden .bwc-layout { gap: 0; }

  /* floating button to bring the panel back — styled exactly like the
     bioregion pages' "← Map" back-link, top-LEFT like it */
  .bio-reopen {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    border: 2px solid rgba(32, 64, 79, 0.38);
    background: var(--paper-raised);
    color: var(--bwl-primary);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(32, 64, 79, 0.16);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .bio-reopen:hover {
    background: var(--bwl-primary);
    color: #fff;
    border-color: var(--bwl-primary);
  }
  .bio-reopen[hidden] { display: none; }

  /* -------- markers -------- */
  .bwc-markers { position: absolute; inset: 0; }

  .bwc-marker {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--hit, 4.2%);
    aspect-ratio: 1/1;
    transform: translate(-50%, -50%);
    display: block;
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    z-index: 3;
  }
  .bwc-marker:hover,
  .bwc-marker:focus-within { z-index: 60; }

  /* the marker: the bioregion's photo in a ringed circle (or a plain dot
     when no image is available). Hovering only animates it — no pop-up. */
  .bwc-ring-img {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.9),
      0 0 0 6px var(--ring, #c9762b),
      0 3px 10px rgba(32, 64, 79, 0.4);
    transition: transform 0.25s ease;
  }
  .bwc-ring-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bwc-marker:hover .bwc-ring-img,
  .bwc-marker:focus-visible .bwc-ring-img {
    transform: scale(1.15);
  }

  .bwc-dot {
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    background: var(--ring, #c9762b);
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.35),
      0 2px 8px rgba(32, 64, 79, 0.35);
    transition: transform 0.25s ease;
  }
  .bwc-marker:hover .bwc-dot,
  .bwc-marker:focus-visible .bwc-dot {
    transform: scale(1.18);
  }

  /* name label pill under each marker */
  .bwc-label {
    position: absolute;
    top: calc(100% + 3px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--bwc-font-body);
    font-size: clamp(8px, 0.62vw, 11px);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bwc-label-text, #fffff0);
    background: var(--ring, #c9762b);
    padding: 4px 7px;
    border-radius: 5px;
    box-shadow: 0 3px 8px var(--bwc-shadow);
    pointer-events: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .bwc-marker:hover .bwc-label,
  .bwc-marker:focus-visible .bwc-label {
    box-shadow: 0 6px 14px var(--bwc-shadow);
    transform: translateX(-50%) translateY(1px);
  }

  /* -------- entrance animations (fade only — the map never scales, so the
     markers stay glued to the land at every zoom level) -------- */
  .bwc-hero.is-loaded .bwc-map {
    animation: bwc-map-in 1.2s ease forwards;
  }
  .bwc-hero.is-loaded .bwc-marker {
    animation: bwc-pop 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.4) forwards;
    animation-delay: calc(0.8s + var(--i) * 0.12s);
  }
  @keyframes bwc-map-in { to { opacity: 1; } }
  @keyframes bwc-pop {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
    70% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bwc-hero * { animation: none !important; }
    .bwc-map, .bwc-marker { opacity: 1 !important; }
    .bwc-marker { transform: translate(-50%, -50%) !important; }
  }

  /* -------- responsive -------- */
  @media (max-width: 1100px) {
    .bwc-hero { min-height: auto; display: block; }
    .bwc-layout { flex-direction: column; gap: 20px; padding: 0 0 20px; }
    .bwc-stage-col { flex: none; width: 100%; }
    .bio-panel { flex: none; max-width: none; width: 100%; }
    .bwc-marker { width: var(--hit-m, 6%); }
  }
</style>
