---
/**
 * BWL map landing — w1-style Europe map with clickable region markers and a
 * permanent left side panel holding the brand block (eyebrow + title) and
 * the bioregion list.
 *
 * Map framing: the projection canvas (europe-map.json) covers all of Europe;
 * we show a WINDOW of it (viewBox "110 180 620 470") that frames the six
 * bioregion markers with sea/padding and an aspect ratio (~1.32) close to
 * the typical stage column. The stage fills its column completely and the
 * SVG uses "slice" — so any cropping happens at the page borders, like a
 * normal map.
 *
 * Markers are the ORIGINAL HTML overlay version (photo in a ringed circle,
 * region-coloured rings, name pill, pop-in entrance). Because the slice
 * crop shifts the visible part of the map, a small script converts each
 * marker's map-window coordinates (data-wx/data-wy) into stage percentages
 * on load and resize — they stay glued to the land at every screen size.
 * The base style is "visible": the entrance animation lives in keyframes
 * only (fill-mode both), so markers can never disappear.
 *
 * On narrow screens (<1480px) the layout stacks (map first, panel below):
 * the stage switches to the window's own aspect ratio — no crop, and the
 * positioning script degrades to the plain percentages.
 */
import europeMap from "../data/europe-map.json";
import { notionImageUrl } from "../lib/images";
import type { MapRegion } from "../lib/map-regions";

interface Props {
  regions: MapRegion[];
}

const { regions } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const W = europeMap.width; // 1000 — projection canvas width
const H = europeMap.height; // 691.4 — projection canvas height
// Deduplicate path strings: several countries share land paths in the 50m
// set (e.g. San Marino is a hole in Italy) — a Set shrinks the SVG.
const paths = [...new Set(europeMap.countries.flatMap((c) => c.d))];

/** The visible map window inside the projection canvas (viewBox). Chosen so
 *  the six markers sit mid-frame with generous sea margins: at any desktop
 *  aspect wider than ~1.05 the slice-crop stays outside the marker band
 *  (Orne 16%..Oltenia 88%), and screens below 1480px stack (no crop at all). */
const VIEW = { x: 110, y: 180, w: 620, h: 470 };

// Markers: window-relative coordinates (0..VIEW.w / 0..VIEW.h), used by the
// positioning script to place them on top of the slice-fitted map.
const markers = regions.map((r) => ({
  ...r,
  wx: (r.x / 100) * W - VIEW.x,
  wy: (r.y / 100) * H - VIEW.y,
}));
---

<div class="bwc-hero" id="bwcHero">
  <div class="bwc-layout">
    <aside class="bio-panel">
      <p class="bio-eyebrow">Bioregional Weaving Labs</p>
      <h1 class="bio-hero-title">
        Weaving Communities of Action,<br />
        Rooted in Place
      </h1>
      <p class="bio-hero-subtitle">Explore a bioregion by clicking on the map</p>
      <div class="bio-divider"></div>
      <h2 class="bio-title">Bioregions</h2>
      <div class="bio-list-wrap">
        <div class="bio-list">
          {regions.map((r) => (
            <a class="bio-row" href={`${base}bioregions/${r.slug}/`}>
              <span class="bio-name">{r.name}</span>
              <span class="bio-country">{r.country}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>

    <div class="bwc-stage-col">
      <div class="bwc-stage" data-view-w={VIEW.w} data-view-h={VIEW.h}>
        <svg
          class="bwc-map"
          viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`}
          role="img"
          aria-label="Map of Europe with bioregion markers"
          preserveAspectRatio="xMidYMid slice"
        >
          <g class="land">
            {paths.map((d) => <path d={d} />)}
          </g>
        </svg>

        <div class="bwc-markers">
          {markers.map((r, i) => {
            const img = notionImageUrl(r.imageFile) ?? r.imageUrl ?? undefined;
            return (
              <a
                class="bwc-marker"
                href={`${base}bioregions/${r.slug}/`}
                style={`--ring:${r.ring};--i:${i}`}
                data-wx={r.wx.toFixed(1)}
                data-wy={r.wy.toFixed(1)}
                aria-label={r.name}
              >
                {img ? (
                  <span class="bwc-ring-img"><img src={img} alt="" loading="lazy" /></span>
                ) : (
                  <span class="bwc-dot"></span>
                )}
                <span class="bwc-label">{r.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const hero = document.getElementById("bwcHero");

  function play() {
    hero?.classList.add("is-loaded");
  }
  if (document.readyState === "complete") requestAnimationFrame(play);
  else window.addEventListener("load", () => requestAnimationFrame(play));

  // ---- marker glue: place the HTML markers on the slice-fitted map ----
  // The SVG viewBox is the map window (VIEW); the stage fills its column and
  // the SVG slice-crops to cover it. The visible portion of the window is a
  // centred sub-rectangle whose size depends on the stage's live aspect:
  //   stage aspect >= window aspect -> full width, vertical crop
  //   stage aspect <  window aspect -> full height, horizontal crop
  // We convert each marker's window coordinates into stage percentages.
  const stage = hero?.querySelector<HTMLElement>(".bwc-stage");
  const markers = hero?.querySelectorAll<HTMLElement>(".bwc-marker");
  const viewW = Number(stage?.dataset.viewW ?? 620);
  const viewH = Number(stage?.dataset.viewH ?? 470);
  const viewAspect = viewW / viewH;

  function placeMarkers() {
    if (!stage || !markers || !markers.length) return;
    const rect = stage.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const sAspect = rect.width / rect.height;
    let cropL = 0;
    let cropT = 0;
    let visW = viewW;
    let visH = viewH;
    if (sAspect >= viewAspect) {
      visH = viewW / sAspect; // vertical crop
      cropT = (viewH - visH) / 2;
    } else {
      visW = viewH * sAspect; // horizontal crop
      cropL = (viewW - visW) / 2;
    }
    markers.forEach((m) => {
      const wx = parseFloat(m.dataset.wx || "0");
      const wy = parseFloat(m.dataset.wy || "0");
      m.style.setProperty("--x", (((wx - cropL) / visW) * 100).toFixed(3) + "%");
      m.style.setProperty("--y", (((wy - cropT) / visH) * 100).toFixed(3) + "%");
    });
  }
  placeMarkers();
  window.addEventListener("resize", placeMarkers);
  window.addEventListener("load", placeMarkers);
</script>

<style>
  /* ================================================================
     Palette (w1-derived) — kept local to the hero.
     ================================================================ */
  .bwc-hero {
    --bwc-ocean: #8da5af;      /* light blue-grey sea            */
    --bwc-land: #e9e6d5;       /* warm cream land                */
    --bwc-title: #20404f;      /* headline colour                */
    --bwc-subtitle: #0a1419;
    --bwc-card-bg: #f9f9f3;
    --bwc-shadow: rgba(20, 40, 30, 0.28);
    --bwc-font-head: "Besley", Georgia, "Times New Roman", serif;
    --bwc-font-body: "Lato", Helvetica, Arial, sans-serif;
  }

  .bwc-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow: hidden;
    font-family: var(--bwc-font-body);
    background: var(--bwc-ocean);
  }

  /* side panel (left) + map (right): the map fills the whole column. */
  .bwc-layout {
    display: flex;
    align-items: stretch;
    gap: 24px;
    width: 100%;
    padding: 24px;
  }
  .bwc-stage-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
  }
  .bwc-stage {
    position: relative;
    width: 100%;
    height: 100%;
  }
  /* the ocean is the page background; the SVG sea is transparent, so any
     slice-crop beyond the land reads as open sea right up to the border */
  .bwc-map {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .land path { fill: var(--bwc-land); }

  /* -------- side panel (left): brand block + bioregion list -------- */
  /* Mirrors the critical-shifts panel (CriticalShiftsMap.astro): same width
     (max 520px), 32px panel sides, 14px list container, 8px row gap — the
     cards sit close to the panel border, like the eyebrow's own inset. */
  .bio-panel {
    flex: 1.4 1 0;
    max-width: 520px;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--bwc-card-bg);
    border: 1px solid rgba(32, 64, 79, 0.18);
    border-radius: 18px;
    padding: 28px 32px 32px;
    box-shadow: 0 18px 40px var(--bwc-shadow);
  }
  .bio-eyebrow {
    font-family: var(--bwc-font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6d7a6b;
  }
  .bio-hero-title {
    font-family: var(--bwc-font-head);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.18;
    color: var(--bwc-title);
    margin-top: 6px;
  }
  .bio-hero-subtitle {
    margin-top: 10px;
    font-family: var(--bwc-font-body);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    color: #0a1419;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 6px;
    /* left padding 0: the sentence starts exactly under the title */
    padding: 8px 12px 8px 0;
  }
  .bio-divider {
    height: 1px;
    background: rgba(32, 64, 79, 0.14);
    margin: 18px 0 16px;
  }
  .bio-title {
    font-family: var(--bwc-font-head);
    font-weight: 700;
    font-size: 19px;
    color: var(--bwc-title);
    margin-bottom: 12px;
  }

  /* the list sits in its own inset container; it scrolls internally so the
     panel always fits the screen height (and the map can fill the rest) */
  .bio-list-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    background: rgba(32, 64, 79, 0.05);
    border: 1px solid rgba(32, 64, 79, 0.08);
    border-radius: 14px;
    padding: 14px;
  }
  .bio-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bio-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 10px 12px;
    background: #fffff0;
    border: 1px solid rgba(32, 64, 79, 0.12);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .bio-row:hover {
    border-color: var(--bwl-secondary);
    background: #fff;
  }
  .bio-name {
    font-family: var(--bwc-font-head);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: var(--bwc-title);
  }
  .bio-country {
    flex-shrink: 0;
    font-family: var(--bwc-font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6d7a6b;
    border: 1px solid rgba(32, 64, 79, 0.15);
    border-radius: 999px;
    padding: 5px 12px;
  }

  /* -------- markers: the ORIGINAL overlay version (photo in a ringed
     circle, region ring, name pill). The base style is VISIBLE — the
     entrance animation only lives inside keyframes (fill both), so the
     markers can never disappear even if the animation never runs. -------- */
  .bwc-markers { position: absolute; inset: 0; }

  .bwc-marker {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--hit, 4.2%);
    aspect-ratio: 1/1;
    transform: translate(-50%, -50%);
    display: block;
    text-decoration: none;
    cursor: pointer;
    opacity: 1;
    z-index: 3;
  }
  .bwc-marker:hover,
  .bwc-marker:focus-within { z-index: 60; }

  .bwc-ring-img {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.9),
      0 0 0 6px var(--ring, #c9762b),
      0 3px 10px rgba(32, 64, 79, 0.4);
    transition: transform 0.25s ease;
  }
  .bwc-ring-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bwc-marker:hover .bwc-ring-img,
  .bwc-marker:focus-visible .bwc-ring-img {
    transform: scale(1.15);
  }

  .bwc-dot {
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    background: var(--ring, #c9762b);
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.35),
      0 2px 8px rgba(32, 64, 79, 0.35);
    transition: transform 0.25s ease;
  }
  .bwc-marker:hover .bwc-dot,
  .bwc-marker:focus-visible .bwc-dot {
    transform: scale(1.18);
  }

  /* name label pill under each marker */
  .bwc-label {
    position: absolute;
    top: calc(100% + 3px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--bwc-font-body);
    font-size: clamp(8px, 0.62vw, 11px);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bwc-label-text, #fffff0);
    background: var(--ring, #c9762b);
    padding: 4px 7px;
    border-radius: 5px;
    box-shadow: 0 3px 8px var(--bwc-shadow);
    pointer-events: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .bwc-marker:hover .bwc-label,
  .bwc-marker:focus-visible .bwc-label {
    box-shadow: 0 6px 14px var(--bwc-shadow);
    transform: translateX(-50%) translateY(1px);
  }

  /* -------- entrance animations (fade for the map, pop for markers).
     Base styles are visible; the is-loaded rules only ADD the animation,
     and `both` holds the final keyframe — no disappearance possible. -------- */
  .bwc-hero.is-loaded .bwc-map {
    animation: bwc-map-in 1.2s ease forwards;
  }
  .bwc-hero.is-loaded .bwc-marker {
    animation: bwc-pop 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.4) both;
    animation-delay: calc(0.8s + var(--i) * 0.12s);
  }
  @keyframes bwc-map-in { to { opacity: 1; } }
  @keyframes bwc-pop {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
    70% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bwc-hero * { animation: none !important; }
    .bwc-map, .bwc-marker { opacity: 1 !important; }
    .bwc-marker { transform: translate(-50%, -50%) !important; }
  }

  /* -------- responsive -------- */
  /* below 1480px: stack — MAP FIRST (mobile preference), panel below; the
     stage keeps the window's own aspect ratio so the full map shows */
  @media (max-width: 1480px) {
    .bwc-hero { min-height: auto; display: block; }
    .bwc-layout { flex-direction: column-reverse; gap: 20px; padding: 20px; }
    .bwc-stage-col { flex: none; width: 100%; }
    .bwc-stage { aspect-ratio: 620 / 470; height: auto; max-height: none; }
    .bio-panel { flex: none; max-width: none; width: 100%; }
    .bwc-marker { width: var(--hit-m, 6%); }
  }
</style>
