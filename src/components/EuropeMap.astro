---
/**
 * BWL map landing — an interactive MapLibre map of Europe with clickable
 * bioregion markers and a permanent left side panel holding the brand block
 * (eyebrow + title) and the bioregion list.
 *
 * Map: MapLibre GL JS + a free, keyless vector basemap (CARTO Positron —
 * no account/token needed), pulled toward this page's own sea/land palette.
 * `fitBounds()` frames all 6 bioregions with a capped max zoom, so the map
 * always shows Europe-wide context instead of a tight crop.
 *
 * Markers are plain HTML (photo in a ringed circle, region-coloured ring,
 * name pill) handed to MapLibre as custom marker elements — MapLibre owns
 * their on-map position (via lat/lng), our CSS only styles their contents
 * and hover/entrance states.
 *
 * Sidebar rows and map markers share `data-slug`; a small script wires
 * bidirectional hover highlighting between them (see the script below).
 */
import { notionImageUrl } from "../lib/images";
import type { MapRegion } from "../lib/map-regions";

interface Props {
  regions: MapRegion[];
}

const { regions } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";

// Payload handed to the client script via a data-* attribute (same
// props-to-DOM-to-script bridge the old crop-glue script used).
const mapRegions = regions.map((r) => ({
  slug: r.slug,
  name: r.name,
  lat: r.lat,
  lng: r.lng,
  ring: r.ring,
  img: notionImageUrl(r.imageFile) ?? r.imageUrl ?? null,
}));
---

<div class="bwc-hero" id="bwcHero">
  <div class="bwc-layout">
    <div class="bio-hero-block">
      <p class="bio-eyebrow">Bioregional Weaving Labs</p>
      <h1 class="bio-hero-title hero-title">
        Weaving Communities of Action,<br />
        Rooted in Place
      </h1>
      <p class="hero-intro">
        We weave resilient Communities of Action rooted in their <strong>bioregions</strong>, helping them drive
        <strong>Critical Shifts</strong> — the systemic changes that strengthen the ecological, social, cultural,
        and economic fabric of a place.
      </p>
    </div>

    <div class="bio-toggle-block">
      <div class="bio-divider"></div>
      <nav class="view-toggle-big" aria-label="Views">
        <a class="active" href={base}>Bioregions</a>
        <a href={`${base}critical-shifts/`}>Critical shifts</a>
      </nav>
    </div>

    <div class="bwc-stage-col">
      <div class="bwc-stage">
        <div
          id="bwcMapCanvas"
          class="bwc-canvas"
          data-regions={JSON.stringify(mapRegions)}
          data-base={base}
          role="img"
          aria-label="Map of Europe with bioregion markers"
        ></div>
      </div>
    </div>

    <div class="bio-list-block">
      <div class="bio-list-wrap">
        <div class="bio-list">
          {regions.map((r) => {
            const img = notionImageUrl(r.imageFile) ?? r.imageUrl ?? null;
            return (
              <a class="bio-row" href={`${base}bioregions/${r.slug}/`} data-slug={r.slug}>
                {img ? (
                  <img class="bio-row-thumb" src={img} alt="" loading="lazy" />
                ) : (
                  <span class="bio-row-thumb bio-row-thumb-empty" aria-hidden="true"></span>
                )}
                <span class="bio-row-body">
                  <span class="bio-name">{r.name}</span>
                  <span class="bio-country">{r.country}</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // maplibre-gl v6 ships only named exports (no default export) — MapLibreMap
  // is their own alias for Map, avoiding a collision with the built-in JS Map
  // we use below for the slug lookups.
  import { MapLibreMap, Marker, LngLatBounds } from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  const hero = document.getElementById("bwcHero");

  function play() {
    hero?.classList.add("is-loaded");
  }
  if (document.readyState === "complete") requestAnimationFrame(play);
  else window.addEventListener("load", () => requestAnimationFrame(play));

  interface RegionData {
    slug: string;
    name: string;
    lat: number;
    lng: number;
    ring: string;
    img: string | null;
  }

  const canvas = document.getElementById("bwcMapCanvas");
  if (canvas) {
    const regions: RegionData[] = JSON.parse(canvas.dataset.regions || "[]");
    const base = canvas.dataset.base || "/";

    // Default framing — hand-picked (not auto-fitBounds) so the map always
    // opens on this exact view regardless of how the region list changes.
    // On mobile the stage is much shorter (see the 1480px breakpoint below),
    // so the hand-picked view would crop several bioregions out of frame —
    // there we fit the actual bounds of every region instead, zoomed out
    // enough that all of them stay visible.
    const DEFAULT_CENTER: [number, number] = [13.6633, 47.4381];
    const DEFAULT_ZOOM = 4.15;
    const isMobile = window.matchMedia("(max-width: 1480px)").matches;
    const bounds = regions.reduce((b, r) => b.extend([r.lng, r.lat]), new LngLatBounds());

    const map = new MapLibreMap({
      container: canvas,
      style: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
      attributionControl: { compact: true },
      ...(isMobile
        ? { bounds, fitBoundsOptions: { padding: 36, maxZoom: 5 } }
        : { center: DEFAULT_CENTER, zoom: DEFAULT_ZOOM }),
    });

    // MapLibre sizes its internal WebGL canvas from the container's measured
    // size at construction time; if that measurement happens before the
    // flex layout / entrance animation has settled, the canvas locks to a
    // too-small size and never grows to match its CSS box. Force a resize
    // once things settle, and keep it correct across layout changes
    // (breakpoint switches, font-load reflow) via ResizeObserver.
    requestAnimationFrame(() => map.resize());
    window.addEventListener("load", () => map.resize());
    new ResizeObserver(() => map.resize()).observe(canvas);

    // CARTO Positron's own layer ids (checked against its published style.json).
    const RECOLOR_LAND = ["landcover", "landuse", "landuse_residential", "park_national_park", "park_nature_reserve"];
    const RECOLOR_WATER = ["water", "water_shadow"];
    const HIDE_LAYERS = [
      "building", "building-top",
      "aeroway-runway", "aeroway-taxiway",
      "poi_stadium", "poi_park",
      "roadname_minor", "roadname_sec",
      "housenumber",
      "waterway_label", "watername_lake_line",
      "rail", "rail_dash",
    ];

    map.on("load", () => {
      // Pull the stock light basemap toward this page's own sea/land
      // palette and quiet down layers that would clutter an editorial map
      // (POIs, transit, road labels). "background" is the base fill for
      // everywhere with no water polygon — i.e. dry land, not ocean. No
      // country/city names either — this map speaks through the bioregion
      // markers, not the basemap's own place labels, so hide every
      // "place_*" layer (countries, states, cities, towns, villages...).
      try { map.setPaintProperty("background", "background-color", "#e9e6d5"); } catch {}
      RECOLOR_WATER.forEach((id) => {
        try { map.setPaintProperty(id, "fill-color", "#8da5af"); } catch {}
      });
      RECOLOR_LAND.forEach((id) => {
        try { map.setPaintProperty(id, "fill-color", "#e9e6d5"); } catch {}
      });
      HIDE_LAYERS.forEach((id) => {
        try { map.setLayoutProperty(id, "visibility", "none"); } catch {}
      });
      map.getStyle()?.layers?.forEach((layer: any) => {
        if (String(layer.id).startsWith("place_")) {
          try { map.setLayoutProperty(layer.id, "visibility", "none"); } catch {}
        }
      });

      map.resize();
    });

    const markersBySlug = new Map<string, InstanceType<typeof Marker>>();
    regions.forEach((r, i) => {
      const el = document.createElement("a");
      el.className = "bwc-marker";
      el.href = `${base}bioregions/${r.slug}/`;
      el.style.setProperty("--ring", r.ring);
      el.style.setProperty("--i", String(i));
      el.dataset.slug = r.slug;
      el.setAttribute("aria-label", r.name);

      const visual = r.img
        ? `<span class="bwc-ring-img"><img src="${r.img}" alt="" loading="lazy" /></span>`
        : `<span class="bwc-dot"></span>`;
      el.innerHTML = `<span class="bwc-marker-inner">${visual}<span class="bwc-label">${r.name}</span></span>`;

      const marker = new Marker({ element: el, anchor: "center" }).setLngLat([r.lng, r.lat]).addTo(map);
      markersBySlug.set(r.slug, marker);
    });

    // ---- sidebar <-> marker bidirectional hover sync ----
    const rowsBySlug = new Map<string, HTMLElement>();
    hero?.querySelectorAll<HTMLElement>(".bio-row").forEach((row) => {
      const slug = row.dataset.slug;
      if (slug) rowsBySlug.set(slug, row);
    });

    markersBySlug.forEach((marker, slug) => {
      const markerEl = marker.getElement();
      const row = rowsBySlug.get(slug);
      if (!row) return;
      const activate = () => {
        markerEl.classList.add("is-active");
        row.classList.add("is-active");
      };
      const deactivate = () => {
        markerEl.classList.remove("is-active");
        row.classList.remove("is-active");
      };
      markerEl.addEventListener("mouseenter", activate);
      markerEl.addEventListener("mouseleave", deactivate);
      row.addEventListener("mouseenter", activate);
      row.addEventListener("mouseleave", deactivate);
    });
  }
</script>

<style>
  /* ================================================================
     Palette (w1-derived) — kept local to the hero.
     ================================================================ */
  .bwc-hero {
    --bwc-ocean: #8da5af;      /* light blue-grey sea            */
    --bwc-land: #e9e6d5;       /* warm cream land                */
    --bwc-title: #20404f;      /* headline colour                */
    --bwc-subtitle: #0a1419;
    --bwc-card-bg: #f9f9f3;
    --bwc-shadow: rgba(20, 40, 30, 0.28);
    --bwc-font-head: "Besley", Georgia, "Times New Roman", serif;
    --bwc-font-body: "Lato", Helvetica, Arial, sans-serif;
  }

  .bwc-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow: hidden;
    font-family: var(--bwc-font-body);
    background: var(--bwc-ocean);
  }

  /* side panel (left) + map (right): both flush to the viewport edges, the
     map fills the whole remaining column. No explicit height here — .bwc-hero
     only has a min-height (100dvh), not a definite height, so a child
     `height:100%` would resolve to auto and collapse to content size; being
     the sole child of .bwc-hero (a flex container), .bwc-layout gets a
     definite height for free from flex's own default stretch, which its
     own grid rows below can then distribute. Desktop: a 2-column grid — the
     hero block, the view toggle and the bioregion list stack in the left
     column (hero on top, list filling the rest and scrolling internally),
     the map spans all three rows on the right. Using grid (not flex) here,
     specifically so the hero, toggle and list can become independent grid
     areas: on mobile the layout switches to a single flex column and
     re-orders hero → toggle → map → list, which needs them to be
     separable in the first place. */
  .bwc-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 4fr);
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "hero stage" "toggle stage" "list stage";
    width: 100%;
  }
  .bwc-stage-col {
    grid-area: stage;
    min-width: 0;
    display: flex;
  }
  .bwc-stage {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .bwc-canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  /* -------- side panel (left): brand block, then the view toggle, then the
     bioregion list — split into three grid areas (see .bwc-layout) so
     mobile can put the map between them. Mirrors the critical-shifts panel
     (CriticalShiftsMap.astro): same width (max 520px), 32px panel sides,
     14px list container, 8px row gap — the cards sit close to the panel
     border, like the eyebrow's own inset. */
  .bio-hero-block {
    grid-area: hero;
    max-width: 520px;
    background: var(--bwc-card-bg);
    border-right: 1px solid rgba(32, 64, 79, 0.18);
    padding: 28px 32px 0;
  }
  .bio-toggle-block {
    grid-area: toggle;
    max-width: 520px;
    background: var(--bwc-card-bg);
    border-right: 1px solid rgba(32, 64, 79, 0.18);
    padding: 0 32px;
  }
  .bio-list-block {
    grid-area: list;
    max-width: 520px;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--bwc-card-bg);
    border-right: 1px solid rgba(32, 64, 79, 0.18);
    padding: 0 32px 32px;
  }
  .bio-eyebrow {
    font-family: var(--bwc-font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6d7a6b;
  }
  .bio-hero-title {
    margin-top: 6px;
  }
  /* left padding 0 (from the shared .hero-subtitle): the sentence starts
     exactly under the title */
  .bio-divider {
    height: 1px;
    background: rgba(32, 64, 79, 0.14);
    margin: 18px 0 16px;
  }
  /* the list sits in its own inset container; it scrolls internally so the
     panel always fits the screen height (and the map can fill the rest) */
  .bio-list-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    background: rgba(32, 64, 79, 0.05);
    border: 1px solid rgba(32, 64, 79, 0.08);
    border-radius: 14px;
    padding: 14px;
  }
  .bio-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bio-row {
    display: flex;
    align-items: stretch;
    gap: 12px;
    min-height: 52px;
    /* no padding here — the thumb sits flush against the row's own edges;
       .bio-row-body carries the text's own padding instead. overflow:hidden
       + the row's own border-radius clips the flush thumb to match: its
       outer (left) corners round with the row, its inner (right) edge —
       well inside the row, nowhere near a rounded corner — stays sharp. */
    padding: 0;
    background: #fff;
    border: 1px solid rgba(32, 64, 79, 0.12);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .bio-row:hover,
  .bio-row.is-active {
    border-color: var(--bwl-primary);
    /* opaque, not translucent — a translucent fill here would let the
       .bio-list-wrap background behind it bleed through instead of giving
       a subtle wash on top of the row's own white */
    background: #f5f6f7;
  }
  .bio-row-thumb {
    flex-shrink: 0;
    width: 52px;
    object-fit: cover;
    background: rgba(32, 64, 79, 0.08);
  }
  .bio-row-thumb-empty {
    display: block;
  }
  .bio-row-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px 8px 0;
  }
  .bio-name {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--bwc-font-head);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: var(--bwc-title);
  }
  .bio-country {
    flex-shrink: 0;
    font-family: var(--bwc-font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6d7a6b;
    border: 1px solid rgba(32, 64, 79, 0.15);
    border-radius: 999px;
    padding: 5px 12px;
  }

  /* -------- entrance animation (fade for the map). Marker entrance/hover
     styles live in the GLOBAL style block below, since MapLibre markers are
     created with document.createElement — they never receive Astro's
     scoped-style attribute, so scoped selectors would silently never match
     them. -------- */
  .bwc-hero.is-loaded .bwc-canvas {
    animation: bwc-map-in 1.2s ease forwards;
  }
  @keyframes bwc-map-in { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .bwc-hero * { animation: none !important; }
    .bwc-canvas { opacity: 1 !important; }
  }

  /* -------- responsive -------- */
  /* below 1480px: stack — hero first, then the view toggle, then the map,
     then the list — a single flex column with explicit order, so the map
     can sit between the pieces of what's one continuous panel on desktop.
     The divider is dropped entirely on mobile — the toggle sits close
     enough under the paragraph that it doesn't need one. The map's
     aspect-ratio matches the critical-shifts landscape image exactly, so
     both maps render at the same height on mobile (this value must stay in
     sync with CriticalShiftsMap.astro's own mobile .cs-stage aspect-ratio).
     The map itself also switches to a fitBounds view at this width (see the
     script above) so the tighter box still shows every bioregion. */
  @media (max-width: 1480px) {
    .bwc-hero { min-height: auto; display: block; }
    .bwc-layout { display: flex; flex-direction: column; }
    .bio-hero-block {
      order: 1;
      max-width: none;
      width: 100%;
      border-right: none;
      padding: 20px 24px 0;
    }
    .bio-toggle-block {
      order: 2;
      max-width: none;
      width: 100%;
      border-right: none;
      border-bottom: 1px solid rgba(32, 64, 79, 0.18);
      padding: 12px 24px 4px;
    }
    .bio-divider { display: none; }
    .bwc-stage-col { order: 3; flex: none; width: 100%; }
    .bwc-stage { aspect-ratio: 956 / 572; height: auto; max-height: none; }
    .bio-list-block {
      order: 4;
      flex: none;
      max-width: none;
      width: 100%;
      border-right: none;
      border-top: 1px solid rgba(32, 64, 79, 0.18);
      padding: 16px 24px 24px;
    }
  }
</style>

<style is:global>
  /* -------- markers: photo in a ringed circle, region ring, name pill.
     GLOBAL (not scoped) — MapLibre markers are plain document.createElement
     nodes handed to Marker({ element }), so they never get Astro's
     data-astro-cid scoping attribute; scoped selectors here would never
     match them. MapLibre owns each marker's on-map position (it sets its
     own inline transform for that) — this CSS only sizes/styles the
     element and its contents, and animates the INNER wrapper (never the
     marker root's own transform, which would fight MapLibre's
     positioning). Class names are bwc-* prefixed and specific enough not
     to collide with anything else on the site. -------- */
  .bwc-marker {
    display: block;
    width: 44px;
    height: 44px;
    text-decoration: none;
    cursor: pointer;
    z-index: 3;
  }
  .bwc-marker:hover,
  .bwc-marker:focus-within,
  .bwc-marker.is-active {
    z-index: 60;
  }

  .bwc-marker-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 1;
  }

  .bwc-ring-img {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.9),
      0 0 0 6px var(--ring, #c9762b),
      0 3px 10px rgba(32, 64, 79, 0.4);
    transition: transform 0.25s ease;
  }
  .bwc-ring-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bwc-marker:hover .bwc-ring-img,
  .bwc-marker:focus-visible .bwc-ring-img,
  .bwc-marker.is-active .bwc-ring-img {
    transform: scale(1.15);
  }

  .bwc-dot {
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    background: var(--ring, #c9762b);
    box-shadow:
      inset 0 2px 3px rgba(255, 255, 255, 0.35),
      0 2px 8px rgba(32, 64, 79, 0.35);
    transition: transform 0.25s ease;
  }
  .bwc-marker:hover .bwc-dot,
  .bwc-marker:focus-visible .bwc-dot,
  .bwc-marker.is-active .bwc-dot {
    transform: scale(1.18);
  }

  /* name label pill under each marker */
  .bwc-label {
    position: absolute;
    top: calc(100% + 3px);
    left: 50%;
    transform: translateX(-50%);
    font-family: "Lato", Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fffff0;
    background: var(--ring, #c9762b);
    padding: 4px 7px;
    border-radius: 5px;
    box-shadow: 0 3px 8px rgba(20, 40, 30, 0.28);
    pointer-events: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .bwc-marker:hover .bwc-label,
  .bwc-marker:focus-visible .bwc-label,
  .bwc-marker.is-active .bwc-label {
    box-shadow: 0 6px 14px rgba(20, 40, 30, 0.28);
    transform: translateX(-50%) translateY(1px);
  }

  /* entrance pop, staggered by --i. Base style is visible; is-loaded only
     ADDS the animation, and `both` holds the final keyframe — the marker
     can never disappear even if the animation never runs. Animates the
     INNER wrapper's transform only, never the marker root's (MapLibre owns
     that one for on-map positioning). */
  .bwc-hero.is-loaded .bwc-marker-inner {
    animation: bwc-pop 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.4) both;
    animation-delay: calc(0.8s + var(--i) * 0.12s);
  }
  @keyframes bwc-pop {
    0% { opacity: 0; transform: scale(0.4); }
    70% { opacity: 1; transform: scale(1.1); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bwc-marker-inner { animation: none !important; opacity: 1 !important; transform: scale(1) !important; }
  }

  /* on mobile, labels hide and only the ringed photo/dot remains — same
     treatment as the critical-shifts map's markers, so the (now much
     shorter) map stays readable instead of crowded with overlapping pills */
  @media (max-width: 1480px) {
    .bwc-marker { width: 52px; height: 52px; }
    .bwc-label { display: none; }
  }
</style>
