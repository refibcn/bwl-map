---
/**
 * BWL map landing — w1-style Europe map with clickable region markers (photo
 * circles, no pop-ups) and a permanent left side panel holding the brand
 * block (eyebrow + title) and the bioregion list.
 *
 * Map framing: the projection canvas (europe-map.json) covers all of Europe;
 * we show a WINDOW of it (viewBox "110 180 620 470") that frames the six
 * bioregion markers with sea/padding and an aspect ratio (~1.32) close to
 * the typical stage column. The stage fills its column completely and the
 * SVG uses "slice" — so any cropping happens at the page borders, like a
 * normal map, and the markers (drawn inside the SVG, in the same projected
 * coordinates as the land) are always glued to their spots.
 *
 * On narrow screens (<1480px) the layout stacks (map first, panel below,
 * per mobile preference): the stage switches to the window's own aspect
 * ratio, so the full framed map is shown without cropping.
 */
import europeMap from "../data/europe-map.json";
import { notionImageUrl } from "../lib/images";
import type { MapRegion } from "../lib/map-regions";

interface Props {
  regions: MapRegion[];
}

const { regions } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const W = europeMap.width; // 1000 — projection canvas width
const H = europeMap.height; // 691.4 — projection canvas height
// Deduplicate path strings: several countries share land paths in the 50m
// set (e.g. San Marino is a hole in Italy) — a Set shrinks the SVG.
const paths = [...new Set(europeMap.countries.flatMap((c) => c.d))];

/** The visible map window inside the projection canvas (viewBox). Chosen so
 *  the six markers sit mid-frame with generous sea margins: at any desktop
 *  aspect wider than ~1.05 the slice-crop stays outside the marker band
 *  (Orne 16%..Oltenia 88%), and screens below 1480px stack (no crop at all). */
const VIEW = { x: 110, y: 180, w: 620, h: 470 };

// Markers keep their projected canvas coordinates (r.x/r.y are percentages
// of the canvas) — they render inside the SVG, so slice-cropping the map
// crops them exactly with the land.
const markers = regions.map((r) => ({
  ...r,
  cx: (r.x / 100) * W,
  cy: (r.y / 100) * H,
}));
const labelFont = 11.5; // canvas units — pill text height
const labelPad = 8;
const labelW = (name: string) => name.length * labelFont * 0.62 + labelPad * 2;
---

<div class="bwc-hero" id="bwcHero">
  <div class="bwc-layout">
    <aside class="bio-panel">
      <p class="bio-eyebrow">Bioregional Weaving Labs</p>
      <h1 class="bio-hero-title">
        Weaving Communities of Action,<br />
        Rooted in Place
      </h1>
      <p class="bio-hero-subtitle">Explore a bioregion by clicking on the map</p>
      <div class="bio-divider"></div>
      <h2 class="bio-title">Bioregions</h2>
      <div class="bio-list-wrap">
        <div class="bio-list">
          {regions.map((r) => (
            <a class="bio-row" href={`${base}bioregions/${r.slug}/`}>
              <span class="bio-name">{r.name}</span>
              <span class="bio-country">{r.country}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>

    <div class="bwc-stage-col">
      <div class="bwc-stage">
        <svg
          class="bwc-map"
          viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`}
          role="img"
          aria-label="Map of Europe with bioregion markers"
          preserveAspectRatio="xMidYMid slice"
        >
          <defs>
            {/* no land shadow: the map runs edge-to-edge, and a drop shadow
                at the cropped window edges reads as a border line */}
          </defs>
          <g class="land">
            {paths.map((d) => <path d={d} />)}
          </g>

          {markers.map((r, i) => {
            const img = notionImageUrl(r.imageFile) ?? r.imageUrl ?? undefined;
            return (
              <a
                class="bwc-marker"
                href={`${base}bioregions/${r.slug}/`}
                style={`--ring:${r.ring};--i:${i}`}
                aria-label={r.name}
              >
                {/* outer group: static position ONLY (attribute transform —
                    never touched by CSS, so markers stay glued to the land) */}
                <g transform={`translate(${r.cx.toFixed(1)} ${r.cy.toFixed(1)})`}>
                  {/* inner group: CSS animations/hover only (no attribute
                      transform — a CSS transform would override it) */}
                  <g class="bwc-marker-inner">
                    {img ? (
                      <g class="bwc-ring">
                        <clipPath id={`clip-${r.slug}`}>
                          <circle r="17" />
                        </clipPath>
                        <image
                          href={img}
                          x="-17"
                          y="-17"
                          width="34"
                          height="34"
                          clip-path={`url(#clip-${r.slug})`}
                          preserveAspectRatio="xMidYMid slice"
                        />
                        {/* previous-marker look: white band around the photo,
                            then the region-coloured ring outside it */}
                        <circle r="17" fill="none" stroke="rgba(255,255,255,0.92)" stroke-width="3.5" />
                        <circle r="20.8" fill="none" stroke="var(--ring, #c9762b)" stroke-width="5" />
                      </g>
                    ) : (
                      <g class="bwc-dot">
                        <circle r="15" fill="var(--ring, #c9762b)" />
                        <circle r="18.5" fill="none" stroke="rgba(255,255,255,0.92)" stroke-width="3.5" />
                      </g>
                    )}
                    <g class="bwc-label" transform={`translate(${-labelW(r.name) / 2} ${30})`}>
                      <rect width={labelW(r.name)} height={labelFont + labelPad * 1.4} rx={labelFont / 2 + 4} fill="var(--ring, #c9762b)" />
                      <text
                        x={labelW(r.name) / 2}
                        y={labelFont + labelPad * 0.72}
                        text-anchor="middle"
                        font-size={labelFont}
                        font-weight="700"
                        letter-spacing="0.05em"
                        fill="#fffff0"
                      >{r.name}</text>
                    </g>
                  </g>
                </g>
              </a>
            );
          })}
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  const hero = document.getElementById("bwcHero");

  function play() {
    hero?.classList.add("is-loaded");
  }
  if (document.readyState === "complete") requestAnimationFrame(play);
  else window.addEventListener("load", () => requestAnimationFrame(play));
</script>

<style>
  /* ================================================================
     Palette (w1-derived) — kept local to the hero.
     ================================================================ */
  .bwc-hero {
    --bwc-ocean: #8da5af;      /* light blue-grey sea            */
    --bwc-land: #e9e6d5;       /* warm cream land                */
    --bwc-title: #20404f;      /* headline colour                */
    --bwc-subtitle: #0a1419;
    --bwc-card-bg: #f9f9f3;
    --bwc-shadow: rgba(20, 40, 30, 0.28);
    --bwc-font-head: "Besley", Georgia, "Times New Roman", serif;
    --bwc-font-body: "Lato", Helvetica, Arial, sans-serif;
  }

  .bwc-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    overflow: hidden;
    font-family: var(--bwc-font-body);
    background: var(--bwc-ocean);
  }

  /* side panel (left) + map (right): the map fills the whole column. */
  .bwc-layout {
    display: flex;
    align-items: stretch;
    gap: 24px;
    width: 100%;
    padding: 24px;
  }
  .bwc-stage-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
  }
  .bwc-stage {
    position: relative;
    width: 100%;
    height: 100%;
  }
  /* the ocean is the page background; the SVG sea is transparent, so any
     slice-crop beyond the land reads as open sea right up to the border */
  .bwc-map {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .land path { fill: var(--bwc-land); }

  /* -------- side panel (left): brand block + bioregion list -------- */
  /* Mirrors the critical-shifts panel (CriticalShiftsMap.astro): same width
     (max 520px), 32px panel sides, 14px list container, 8px row gap — the
     cards sit close to the panel border, like the eyebrow's own inset. */
  .bio-panel {
    flex: 1.4 1 0;
    max-width: 520px;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--bwc-card-bg);
    border: 1px solid rgba(32, 64, 79, 0.18);
    border-radius: 18px;
    padding: 28px 32px 32px;
    box-shadow: 0 18px 40px var(--bwc-shadow);
  }
  .bio-eyebrow {
    font-family: var(--bwc-font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6d7a6b;
  }
  .bio-hero-title {
    font-family: var(--bwc-font-head);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.18;
    color: var(--bwc-title);
    margin-top: 6px;
  }
  .bio-hero-subtitle {
    margin-top: 10px;
    font-family: var(--bwc-font-body);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    color: #0a1419;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 6px;
    /* left padding 0: the sentence starts exactly under the title */
    padding: 8px 12px 8px 0;
  }
  .bio-divider {
    height: 1px;
    background: rgba(32, 64, 79, 0.14);
    margin: 18px 0 16px;
  }
  .bio-title {
    font-family: var(--bwc-font-head);
    font-weight: 700;
    font-size: 19px;
    color: var(--bwc-title);
    margin-bottom: 12px;
  }

  /* the list sits in its own inset container; it scrolls internally so the
     panel always fits the screen height (and the map can fill the rest) */
  .bio-list-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    background: rgba(32, 64, 79, 0.05);
    border: 1px solid rgba(32, 64, 79, 0.08);
    border-radius: 14px;
    padding: 14px;
  }
  .bio-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .bio-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 10px 12px;
    background: #fffff0;
    border: 1px solid rgba(32, 64, 79, 0.12);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .bio-row:hover {
    border-color: var(--bwl-secondary);
    background: #fff;
  }
  .bio-name {
    font-family: var(--bwc-font-head);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: var(--bwc-title);
  }
  .bio-country {
    flex-shrink: 0;
    font-family: var(--bwc-font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6d7a6b;
    border: 1px solid rgba(32, 64, 79, 0.15);
    border-radius: 999px;
    padding: 5px 12px;
  }

  .bwc-marker {
    cursor: pointer;
    z-index: 3;
    outline: none;
  }
  .bwc-marker:hover,
  .bwc-marker:focus-visible { z-index: 60; }

  .bwc-ring {
    transition: transform 0.25s ease;
  }
  .bwc-dot {
    transition: transform 0.25s ease;
  }
  .bwc-marker:hover .bwc-ring,
  .bwc-marker:focus-visible .bwc-ring,
  .bwc-marker:hover .bwc-dot,
  .bwc-marker:focus-visible .bwc-dot {
    transform: scale(1.12);
  }

  .bwc-label {
    pointer-events: none;
  }
  .bwc-label text {
    font-family: var(--bwc-font-body);
    text-transform: uppercase;
  }

  /* -------- entrance animations: pop-in like the previous marker version -------- */
  .bwc-hero.is-loaded .bwc-map {
    animation: bwc-map-in 1.2s ease forwards;
  }
  .bwc-marker-inner {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: bwc-pop 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.4) backwards;
    animation-delay: calc(0.7s + var(--i, 0) * 0.12s);
  }
  @keyframes bwc-map-in { to { opacity: 1; } }
  @keyframes bwc-pop {
    0% { opacity: 0; transform: scale(0.4); }
    70% { opacity: 1; transform: scale(1.08); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bwc-hero * { animation: none !important; }
    .bwc-map { opacity: 1 !important; }
    .bwc-marker { opacity: 1 !important; }
    .bwc-marker-inner { opacity: 1 !important; transform: none !important; }
  }

  /* -------- responsive -------- */
  /* below 1480px: stack — MAP FIRST (mobile preference), panel below; the
     stage keeps the window's own aspect ratio so the full map shows */
  @media (max-width: 1480px) {
    .bwc-hero { min-height: auto; display: block; }
    .bwc-layout { flex-direction: column-reverse; gap: 20px; padding: 20px; }
    .bwc-stage-col { flex: none; width: 100%; }
    .bwc-stage { aspect-ratio: 620 / 470; height: auto; max-height: none; }
    .bio-panel { flex: none; max-width: none; width: 100%; }
  }
</style>
