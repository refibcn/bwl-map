---
import SVGTextBlock from "./SVGTextBlock.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth, capLines } from "../lib/text";
import { shiftColor } from "../lib/shift-pages";
import { roundedRectPath } from "../lib/shapes";

interface Shift {
  slug: string;
  name: string;
  emoji: string | null;
  shift: string;
  leveragePoint: string;
  systemicBarrier: string;
}

interface Innovation {
  slug: string;
  name: string;
  description: string;
  tags: string[];
  depth: string;
  notionUrl: string | null;
  externalUrl: string | null;
  imageUrl: string | null;
  imageFile: string | null;
}

interface Props {
  shifts: Shift[];
  innovations: Innovation[];
  bioregionName: string;
  bioregionSlug: string;
  bioregionDescription: string;
  bioregionImageUrl?: string | null;
  bioregionImageFile?: string | null;
  bioregionCountry?: string | null;
}

const {
  shifts,
  innovations,
  bioregionName,
  bioregionSlug,
  bioregionDescription,
  bioregionImageUrl = null,
  bioregionImageFile = null,
  bioregionCountry = "",
} = Astro.props as Props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

// Prefer the build-time downloaded file (emitted by Vite into dist/_astro/);
// fall back to the original remote URL (fixture data, external links).
function resolveImageSource(
  file: string | null | undefined,
  url: string | null | undefined
): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

const COLUMN_GAP = 190; // space between the three columns
const margin = { top: 40, right: 150, bottom: 40, left: 150 };
const bioW = 320;
const csW = 200;
const sisW = 320;
// Total canvas width is derived from the parts, so tuning the gap or margins
// re-flows the whole diagram.
const width = margin.left + bioW + COLUMN_GAP + csW + COLUMN_GAP + sisW + margin.right;
const bioX = margin.left + bioW / 2;
const csX = margin.left + bioW + COLUMN_GAP;
const sisX = csX + csW + COLUMN_GAP;

const csTextWidth = csW - 52;
const sisTextWidth = sisW - 80;

const csNameLineHeight = 14;
const csLeverageLineHeight = 12;
const sisNameLineHeight = 14;
const sisDescLineHeight = 12;
// Top-aligned text blocks: every card title starts at the same padding from
// the card top, so titles line up across the column and text fills the card
// from the top (instead of floating centered).
const CS_TEXT_TOP = 12;
const SIS_TEXT_TOP = 12;
const NAME_DESC_GAP = 6;

function wrapLines(text: string, maxChars: number) {
  const words = text.split(" ");
  const lines: string[] = [];
  let current = "";
  for (const w of words) {
    if ((current + " " + w).trim().length > maxChars && current) {
      lines.push(current.trim());
      current = w;
    } else {
      current = (current + " " + w).trim();
    }
  }
  if (current) lines.push(current);
  return lines;
}

// --- Bioregion card: image strip on top, title + country + description below ---
const BIO_TEXT_INSET = 20;
const BIO_TEXT_PAD = 24; // vertical padding of the text section inside the card (roomier below the description)
const bioTextWidth = bioW - BIO_TEXT_INSET * 2;
const bioTextX = bioX - bioW / 2 + BIO_TEXT_INSET;
const bioImageH = 160; // full-width image strip on top (larger container, no white borders)
const bioNameFont = 18; // bigger title
const bioCountryFont = 10;
const bioDescFont = 9;
const bioImageSrc = resolveImageSource(bioregionImageFile, bioregionImageUrl);

const bioNameRaw = wrapToWidth(bioregionName || "", bioTextWidth, bioNameFont, "display");
const bioCountryLines = wrapToWidth(bioregionCountry || "", bioTextWidth, bioCountryFont, "display");
const bioDescRaw = wrapToWidth(bioregionDescription || "", bioTextWidth, bioDescFont, "body");
if (bioNameRaw.length > 2 || bioDescRaw.length > 6) {
  console.warn(
    `[bwl-map] "${bioregionName}": title wraps to ${bioNameRaw.length} line(s), description to ${bioDescRaw.length} (max recommended: 2 / 6)`
  );
}
const bioNameLines = capLines(bioNameRaw, 2);
const bioDescLines = capLines(bioDescRaw, 6);

const bioNameLineHeight = 21; // 18px display font
const bioCountryLineHeight = 12;
const bioDescLineHeight = 12;
const bioCountryGap = bioCountryLines.length ? 5 : 0;
const bioDescGap = bioDescLines.length ? 8 : 0;
const bioTextHeight =
  bioNameLines.length * bioNameLineHeight +
  bioCountryGap + bioCountryLines.length * bioCountryLineHeight +
  bioDescGap + bioDescLines.length * bioDescLineHeight;
const bioH = bioImageH + bioTextHeight + BIO_TEXT_PAD * 2;

const csGap = 16;
const sisGap = 16;

const csCards = shifts.map((s) => {
  const emoji = s.emoji || "";
  // Full database text: names and leverage points are wrapped to the card
  // width but never truncated with an ellipsis.
  const nameLines = wrapToWidth(`${emoji} ${s.name}`.trim(), csW - 48, 12, "display");
  const leverageLines = wrapToWidth(s.leveragePoint || "", csW - 48, 9.5, "body");
  const textHeight = nameLines.length * csNameLineHeight + 4 + leverageLines.length * csLeverageLineHeight;
  const cardHeight = Math.max(64, textHeight + 32);
  return { ...s, nameLines, leverageLines, cardHeight, color: shiftColor(s.slug) };
});

// SIS cards: a FIXED image square on the left, so the text column keeps a
// stable width even with full descriptions (the previous square-=-card-height
// layout squeezed the text to nothing as cards grew). Cards size themselves
// to their content with the full database text.
const SIS_IMG = 150; // fixed square image side
const SIS_TEXT_GAP = 18; // space between the image square and the text
const SIS_TEXT_RIGHT = 12; // space between the text and the card's right border
const SIS_MIN_IMG = 104; // minimum card height

// Cards must ALWAYS be at least as tall as their image (150px) — with the
// old min (104) short-text cards were shorter than their own image, which
// hung out below the card border (this was the real 'image beyond the
// borders' bug; the clip rect followed the image box, so it contained
// nothing).
const SIS_IMG_PAD = 18;
const sisCards: any[] = innovations.map((inv) => {
  const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
  const leftInset = hasImage ? SIS_IMG + SIS_TEXT_GAP : 16;
  const textX = sisX + leftInset;
  const textWidth = sisW - leftInset - SIS_TEXT_RIGHT;
  const nameLines = wrapToWidth(inv.name || "", textWidth, 12, "display");
  const descLines = wrapToWidth(inv.description || "", textWidth, 9.5, "body");
  const textHeight = nameLines.length * sisNameLineHeight + 4 + descLines.length * sisDescLineHeight;
  const cardHeight = Math.max(hasImage ? SIS_IMG + SIS_IMG_PAD : SIS_MIN_IMG, textHeight + 36);
  return { ...inv, hasImage, nameLines, descLines, textHeight, textX, cardHeight };
});

const csHeight = csCards.reduce((sum, c, i) => sum + c.cardHeight + (i < csCards.length - 1 ? csGap : 0), 0);
const sisHeight = sisCards.reduce((sum, c, i) => sum + c.cardHeight + (i < sisCards.length - 1 ? sisGap : 0), 0);
// The canvas must always fit the bioregion card, even when a page has no
// shifts/innovations yet (otherwise the card overflows above the viewBox).
const contentHeight = Math.max(csHeight, sisHeight, bioH);
const height = contentHeight + margin.top + margin.bottom + 28;

const bioY = height / 2;
const bioTop = bioY - bioH / 2; // top of the card (and of the image strip)
const bioBoxY = bioY; // card vertical center (connector target)
// Text block, vertically centered in the section below the image strip.
const bioTextTop = bioTop + bioImageH + (bioH - bioImageH - bioTextHeight) / 2;
const bioNameStartY = bioTextTop + bioNameLineHeight * 0.8;
const bioCountryStartY = bioNameStartY + bioNameLines.length * bioNameLineHeight + bioCountryGap;
const bioDescStartY = bioCountryStartY + bioCountryLines.length * bioCountryLineHeight + bioDescGap;

function stackPositions(cards: { cardHeight: number }[], startY: number, gap: number) {
  const positions: number[] = [];
  let y = startY;
  cards.forEach((c, i) => {
    positions.push(y + c.cardHeight / 2);
    y += c.cardHeight + gap;
  });
  return positions;
}

const csStartY = (height - csHeight) / 2;
const sisStartY = (height - sisHeight) / 2;

const csPositions = stackPositions(csCards, csStartY, csGap);
const sisPositions = stackPositions(sisCards, sisStartY, sisGap);

const shiftPositions = csCards.map((s, i) => ({ ...s, y: csPositions[i] }));
const innovPositions = sisCards.map((inv, i) => ({ ...inv, y: sisPositions[i] }));
// Positioned shifts (with y) so connector paths get real coordinates.
const shiftBySlug = new Map(shiftPositions.map((s) => [s.slug, s]));

const maxLinked = Math.max(
  ...shiftPositions.map((s) => innovations.filter((i) => i.tags.includes(s.slug)).length),
  1
);

function curve(x1: number, y1: number, x2: number, y2: number, strength = 0.5) {
  const dx = x2 - x1;
  const mx = x1 + dx * strength;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width={width}
    height="auto"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Flow diagram of {bioregionName}'s systemic innovations feeding critical shifts</title>
    <desc>
      {innovations.length} systemic innovations connect through {shifts.length} critical shifts toward {bioregionName}'s overall regenerative change.
    </desc>

    <defs>
      <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#20404f" flood-opacity="0.08" />
      </filter>
      {/* explicit clip paths keep every card image inside its own card —
          only the corners on the card's own outer edge are rounded (image
          on top -> top corners; image on left -> left corners), so the
          image reads as flush-cut against the text, not a floating rect */}
      <clipPath id="clip-bio">
        <path d={roundedRectPath(bioX - bioW / 2, bioTop, bioW, bioImageH, 18, true, true, false, false)} />
      </clipPath>
      {innovPositions.map((inv) => (
        <clipPath id={`clip-${inv.slug}`}>
          <path d={roundedRectPath(sisX, inv.y - inv.cardHeight / 2, SIS_IMG, inv.cardHeight, 10, true, false, false, true)} />
        </clipPath>
      ))}
    </defs>

    {/* SIS → CS lines */}
    {innovPositions.map((inv) =>
      inv.tags.map((tagSlug) => {
        const s = shiftBySlug.get(tagSlug);
        if (!s) return null;
        return (
          <path
            class={`conn conn-sis-cs conn-cs-${s.slug}`}
            data-from={`sis:${inv.slug}`}
            data-to={`cs:${s.slug}`}
            d={curve(sisX, inv.y, csX + csW, s.y)}
            fill="none"
            stroke={s.color}
            stroke-width="2.5"
            opacity="0.45"
          />
        );
      })
    )}

    {/* CS → Bioregion lines */}
    {shiftPositions.map((s) => {
      const count = innovations.filter((i) => i.tags.includes(s.slug)).length;
      const strength = count / maxLinked;
      return (
        <path
          class={`conn conn-cs-bio conn-cs-${s.slug}`}
          data-from={`cs:${s.slug}`}
          data-to="bio"
          d={curve(csX, s.y, bioX + bioW / 2, bioBoxY)}
          fill="none"
          stroke={s.color}
          stroke-width={2 + strength * 5}
          opacity={0.35 + strength * 0.45}
        />
      );
    })}

    {/* Bioregion card: image strip on top, text below. This is the page's
        own subject, so it was never a link before — send it to the real
        bioregion page on the BWL website (external), same convention used
        for the systemic-innovation image links. */}
    <a class="card-link" href={`https://bioregionalweavinglabs.org/bioregions/${bioregionSlug}/`} target="_blank" rel="noopener">
    <g class="card bio-card" data-el="bio" data-root="bio" tabindex="0">
      <rect
        class="card-bg"
        x={bioX - bioW / 2}
        y={bioTop}
        width={bioW}
        height={bioH}
        rx="18"
        fill="#ffffff"
        stroke="var(--bwl-primary)"
        stroke-width="2"
        filter="url(#softShadow)"
      />
      {bioImageSrc && (
        <image
          x={bioX - bioW / 2}
          y={bioTop}
          width={bioW}
          height={bioImageH}
          href={bioImageSrc}
          clip-path="url(#clip-bio)"
          preserveAspectRatio="xMidYMid slice"
        />
      )}
      {/* Redraw the card border over the image edge */}
      <rect
        x={bioX - bioW / 2}
        y={bioTop}
        width={bioW}
        height={bioH}
        rx="18"
        fill="none"
        stroke="var(--bwl-primary)"
        stroke-width="2"
      />

      <SVGTextBlock
        lines={bioNameLines}
        x={bioTextX}
        y={bioNameStartY}
        lineHeight="1.2em"
        anchor="start"
        style={`font-family:var(--font-display);font-size:${bioNameFont}px;font-weight:bold;fill:var(--bwl-primary);`}
      />
      {bioCountryLines.length > 0 && (
        <SVGTextBlock
          lines={bioCountryLines}
          x={bioTextX}
          y={bioCountryStartY}
          lineHeight="1.2em"
          anchor="start"
          style={`font-family:var(--font-display);font-size:${bioCountryFont}px;font-weight:bold;fill:var(--bwl-secondary);letter-spacing:0.1em;text-transform:uppercase;`}
        />
      )}
      <SVGTextBlock
        lines={bioDescLines}
        x={bioTextX}
        y={bioDescStartY}
        lineHeight="1.3em"
        anchor="start"
        style={`font-family:var(--font-body);font-size:${bioDescFont}px;fill:var(--bwl-text);opacity:0.85;`}
      />
    </g>
    </a>

    {/* Critical Shifts */}
    {shiftPositions.map((s) => {
      const textHeight = s.nameLines.length * csNameLineHeight + 4 + s.leverageLines.length * csLeverageLineHeight;
      const cardTop = s.y - s.cardHeight / 2;
      const nameY = cardTop + CS_TEXT_TOP + csNameLineHeight * 0.8;
      const leverageY = nameY + s.nameLines.length * csNameLineHeight + 4;
      return (
        <a class="card-link" href={`${base}critical-shifts/${s.slug}/`}>
          <g class={`card cs-card cs-${s.slug}`} data-el={`cs:${s.slug}`} tabindex="0">
            <rect
              class="card-bg"
              x={csX}
              y={s.y - s.cardHeight / 2}
              width={csW}
              height={s.cardHeight}
              rx="12"
              fill="#ffffff"
              stroke={s.color}
              stroke-width="2"
              filter="url(#softShadow)"
            />
            <SVGTextBlock
              lines={s.nameLines}
              x={csX + 24}
              y={nameY}
              lineHeight="1.2em"
              style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
            />
            <SVGTextBlock
              lines={s.leverageLines}
              x={csX + 24}
              y={leverageY}
              lineHeight="1.3em"
              style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
            />
          </g>
        </a>
      );
    })}

    {/* Systemic Innovations */}
    {innovPositions.map((inv) => {
      const untagged = inv.tags.length === 0;
      const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
      const imgY = inv.y - inv.cardHeight / 2;
      const nameY = imgY + SIS_TEXT_TOP + sisNameLineHeight * 0.8;
      const descY = nameY + inv.nameLines.length * sisNameLineHeight + NAME_DESC_GAP;
      return (
        <g
          class={`card sis-card sis-${inv.slug}`}
          data-el={`sis:${inv.slug}`}
          tabindex="0"
        >
          <rect
            class="card-bg"
            x={sisX}
            y={imgY}
            width={sisW}
            height={inv.cardHeight}
            rx="10"
            fill="#ffffff"
            stroke={untagged ? "var(--bwl-muted)" : "var(--line-strong)"}
            stroke-width="1.5"
            filter="url(#softShadow)"
          />
          {/* image + external-link badge share one clickable region: the
              whole image is the hit area (not just the small badge), so
              there's a generous margin of error. The badge sits in the
              image's own top-right corner, inset by the same padding used
              elsewhere on the card, with an opaque background so it reads
              clearly over any photo without covering the text below. */}
          {inv.externalUrl ? (
            <a href={inv.externalUrl} target="_blank" rel="noopener" aria-label={`Open ${inv.name} — external link`}>
              {sisImageSrc && (
                <image
                  x={sisX}
                  y={imgY}
                  width={SIS_IMG}
                  height={inv.cardHeight}
                  href={sisImageSrc}
                  clip-path={`url(#clip-${inv.slug})`}
                  preserveAspectRatio="xMidYMid slice"
                />
              )}
              <circle
                cx={sisImageSrc ? sisX + SIS_IMG - 16 : sisX + sisW - 16}
                cy={imgY + 16}
                r="10"
                fill="var(--paper-raised)"
                filter="url(#softShadow)"
              />
              <text
                x={sisImageSrc ? sisX + SIS_IMG - 16 : sisX + sisW - 16}
                y={imgY + 20}
                text-anchor="middle"
                font-size="11"
                fill="var(--bwl-primary)"
                font-family="var(--font-body)"
                font-weight="bold"
              >↗</text>
            </a>
          ) : (
            sisImageSrc && (
              <image
                x={sisX}
                y={imgY}
                width={SIS_IMG}
                height={inv.cardHeight}
                href={sisImageSrc}
                clip-path={`url(#clip-${inv.slug})`}
                preserveAspectRatio="xMidYMid slice"
              />
            )
          )}
          {sisImageSrc && (
            <rect
              x={sisX}
              y={imgY}
              width={sisW}
              height={inv.cardHeight}
              rx="10"
              fill="none"
              stroke={untagged ? "var(--bwl-muted)" : "var(--line-strong)"}
              stroke-width="1.5"
            />
          )}
          <SVGTextBlock
            lines={inv.nameLines}
            x={inv.textX}
            y={nameY}
            lineHeight="1.15em"
            style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={inv.descLines}
            x={inv.textX}
            y={descY}
            lineHeight="1.3em"
            style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
          />
        </g>
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    /**
     * Highlight one card plus everything directly connected to it (one hop):
     * a connector is active when BOTH its endpoints are highlighted, so
     * hovering any card lights up exactly its own connections and the cards
     * at the far end of each.
     */
    function activateEl(elId: string) {
      svg!.classList.add("has-active");
      const match = new Set([elId]);
      svg!.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
        const from = path.dataset.from;
        const to = path.dataset.to;
        if (from === elId || to === elId) {
          if (from) match.add(from);
          if (to) match.add(to);
        }
      });
      // Hovering a systemic innovation also highlights the diagram's root card
      // (the bioregion card here), so the innovation -> shift -> root chain
      // lights up end to end.
      if (elId.startsWith("sis:")) {
        const root = svg!.querySelector<SVGElement>("[data-root]");
        if (root?.dataset.el) match.add(root.dataset.el);
      }
      svg!.querySelectorAll<SVGElement>(".card, .conn").forEach((el) => {
        if (el.classList.contains("conn")) {
          const from = el.dataset.from;
          const to = el.dataset.to;
          el.classList.toggle("active", !!from && !!to && match.has(from) && match.has(to));
        } else {
          el.classList.toggle("active", !!el.dataset.el && match.has(el.dataset.el));
        }
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    svg.querySelectorAll<SVGGElement>(".cs-card, .sis-card, .bio-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activateEl(g.dataset.el!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activateEl(g.dataset.el!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activateEl(path.dataset.from!));
      path.addEventListener("mouseleave", deactivate);
    });

    // On long pages the diagram is taller than the viewport: open with the
    // bioregion card vertically centred, so the top/bottom systemic
    // innovations are reachable by scrolling up/down.
    function centerOnBio() {
      const bio = svg!.querySelector<SVGGElement>(".bio-card");
      if (!bio) return;
      const r = bio.getBoundingClientRect();
      const y = window.scrollY + r.top - (window.innerHeight - r.height) / 2;
      window.scrollTo(0, Math.max(0, y));
    }
    if (document.readyState === "complete") requestAnimationFrame(centerOnBio);
    else window.addEventListener("load", () => requestAnimationFrame(centerOnBio));
  })();
</script>

<style>
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* short diagrams (few cards) are centred vertically on the page */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flow-wrap svg {
    display: block;
    width: auto; /* fixed px width from the width attribute: browser zoom scales it */
    height: auto;
    margin: 0 auto;
    background: var(--paper-raised);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
