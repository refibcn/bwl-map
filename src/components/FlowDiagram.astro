---
import SVGTextBlock from "./SVGTextBlock.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth } from "../lib/text";

interface Shift {
  slug: string;
  name: string;
  emoji: string | null;
  shift: string;
  leveragePoint: string;
  systemicBarrier: string;
}

interface Innovation {
  slug: string;
  name: string;
  description: string;
  tags: string[];
  depth: string;
  notionUrl: string | null;
  imageUrl: string | null;
  imageFile: string | null;
}

interface Props {
  shifts: Shift[];
  innovations: Innovation[];
  bioregionName: string;
  bioregionDescription: string;
  bioregionImageUrl?: string | null;
  bioregionImageFile?: string | null;
  bioregionCountry?: string | null;
}

const {
  shifts,
  innovations,
  bioregionName,
  bioregionDescription,
  bioregionImageUrl = null,
  bioregionImageFile = null,
  bioregionCountry = "",
} = Astro.props as Props;

const base = import.meta.env.BASE_URL || "";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

// Prefer the build-time downloaded file (emitted by Vite into dist/_astro/);
// fall back to the original remote URL (fixture data, external links).
function resolveImageSource(
  file: string | null | undefined,
  url: string | null | undefined
): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

const PALETTE = [
  "#20404F", // BWL primary
  "#E2AD4F", // BWL secondary
  "#5C8A7A", // muted teal
  "#C78A1D", // darker gold
  "#4A7C6F", // sage
  "#8B5A2B", // warm brown
  "#3D6B66", // deep sage
  "#D4A84B", // light gold
];

const width = 1440; // broader diagram, fits full-screen on typical laptops
const margin = { top: 40, right: 150, bottom: 40, left: 150 };
const COLUMN_GAP = 150; // space between the three columns

const bioW = 320;
const bioX = margin.left + bioW / 2;
const csX = margin.left + bioW + COLUMN_GAP;
const csW = 200;
const sisX = csX + csW + COLUMN_GAP;
const sisW = 320;

const csTextWidth = csW - 52;
const sisTextWidth = sisW - 80;

const csNameLineHeight = 14;
const csLeverageLineHeight = 12;
const sisNameLineHeight = 14;
const sisDescLineHeight = 12;

function wrapLines(text: string, maxChars: number) {
  const words = text.split(" ");
  const lines: string[] = [];
  let current = "";
  for (const w of words) {
    if ((current + " " + w).trim().length > maxChars && current) {
      lines.push(current.trim());
      current = w;
    } else {
      current = (current + " " + w).trim();
    }
  }
  if (current) lines.push(current);
  return lines;
}

// --- Bioregion card: image strip on top, title + country + description below ---
const BIO_TEXT_INSET = 20;
const BIO_TEXT_PAD = 14; // vertical padding of the text section inside the card
const bioTextWidth = bioW - BIO_TEXT_INSET * 2;
const bioTextX = bioX - bioW / 2 + BIO_TEXT_INSET;
const bioImageH = 110; // full-width image strip on top (≈ same height as the text section)
const bioNameFont = 18; // bigger title
const bioCountryFont = 10;
const bioDescFont = 9;
const bioImageSrc = resolveImageSource(bioregionImageFile, bioregionImageUrl);

const bioNameLines = wrapToWidth(bioregionName || "", bioTextWidth, bioNameFont, "display");
const bioCountryLines = wrapToWidth(bioregionCountry || "", bioTextWidth, bioCountryFont, "display");
const bioDescLines = wrapToWidth(bioregionDescription || "", bioTextWidth, bioDescFont, "body");
if (bioNameLines.length > 2 || bioDescLines.length > 6) {
  console.warn(
    `[bwl-map] "${bioregionName}": title wraps to ${bioNameLines.length} line(s), description to ${bioDescLines.length} (max recommended: 2 / 6)`
  );
}

const bioNameLineHeight = 21; // 18px display font
const bioCountryLineHeight = 12;
const bioDescLineHeight = 12;
const bioCountryGap = bioCountryLines.length ? 5 : 0;
const bioDescGap = bioDescLines.length ? 8 : 0;
const bioTextHeight =
  bioNameLines.length * bioNameLineHeight +
  bioCountryGap + bioCountryLines.length * bioCountryLineHeight +
  bioDescGap + bioDescLines.length * bioDescLineHeight;
const bioH = bioImageH + bioTextHeight + BIO_TEXT_PAD * 2;

const csGap = 16;
const sisGap = 16;

const csCards = shifts.map((s, i) => {
  const emoji = s.emoji || "";
  const nameLines = wrapLines(`${emoji} ${s.name}`.trim(), 24);
  const leverageLines = wrapLines(s.leveragePoint || "", 30);
  const textHeight = nameLines.length * csNameLineHeight + 4 + leverageLines.length * csLeverageLineHeight;
  const cardHeight = Math.max(64, textHeight + 26);
  return { ...s, nameLines, leverageLines, cardHeight, color: PALETTE[i % PALETTE.length] };
});

const SIS_IMG = 104; // fixed square side for EVERY SIS image (same size on all cards)
const SIS_TEXT_GAP = 18; // space between the image square and the text
const SIS_TEXT_RIGHT = 12; // space between the text and the card's right border

const sisCards = innovations.map((inv) => {
  const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
  const leftInset = hasImage ? SIS_IMG + SIS_TEXT_GAP : 16;
  const textX = sisX + leftInset;
  const textWidth = sisW - leftInset - SIS_TEXT_RIGHT;
  const nameLines = wrapToWidth(inv.name || "", textWidth, 12, "display");
  const descLines = wrapToWidth(inv.description || "", textWidth, 9.5, "body");
  const textHeight = nameLines.length * sisNameLineHeight + 4 + descLines.length * sisDescLineHeight;
  // Text drives the card height; the image size stays constant. Cards with an
  // image keep at least the image side + padding so it always fits.
  const cardHeight = Math.max(textHeight + 28, hasImage ? SIS_IMG + 12 : 84);
  return { ...inv, hasImage, nameLines, descLines, textHeight, textX, imgSide: SIS_IMG, cardHeight };
});

const csHeight = csCards.reduce((sum, c, i) => sum + c.cardHeight + (i < csCards.length - 1 ? csGap : 0), 0);
const sisHeight = sisCards.reduce((sum, c, i) => sum + c.cardHeight + (i < sisCards.length - 1 ? sisGap : 0), 0);
const contentHeight = Math.max(csHeight, sisHeight);
const height = contentHeight + margin.top + margin.bottom + 28;

const bioY = height / 2;
const bioTop = bioY - bioH / 2; // top of the card (and of the image strip)
const bioBoxY = bioY; // card vertical center (connector target)
// Text block, vertically centered in the section below the image strip.
const bioTextTop = bioTop + bioImageH + (bioH - bioImageH - bioTextHeight) / 2;
const bioNameStartY = bioTextTop + bioNameLineHeight * 0.8;
const bioCountryStartY = bioNameStartY + bioNameLines.length * bioNameLineHeight + bioCountryGap;
const bioDescStartY = bioCountryStartY + bioCountryLines.length * bioCountryLineHeight + bioDescGap;

function stackPositions(cards: { cardHeight: number }[], startY: number, gap: number) {
  const positions: number[] = [];
  let y = startY;
  cards.forEach((c, i) => {
    positions.push(y + c.cardHeight / 2);
    y += c.cardHeight + gap;
  });
  return positions;
}

const csStartY = (height - csHeight) / 2;
const sisStartY = (height - sisHeight) / 2;

const csPositions = stackPositions(csCards, csStartY, csGap);
const sisPositions = stackPositions(sisCards, sisStartY, sisGap);

const shiftPositions = csCards.map((s, i) => ({ ...s, y: csPositions[i] }));
const innovPositions = sisCards.map((inv, i) => ({ ...inv, y: sisPositions[i] }));
// Positioned shifts (with y) so connector paths get real coordinates.
const shiftBySlug = new Map(shiftPositions.map((s) => [s.slug, s]));

const maxLinked = Math.max(
  ...shiftPositions.map((s) => innovations.filter((i) => i.tags.includes(s.slug)).length),
  1
);

function curve(x1: number, y1: number, x2: number, y2: number, strength = 0.5) {
  const dx = x2 - x1;
  const mx = x1 + dx * strength;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width="100%"
    height="auto"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Flow diagram of {bioregionName}'s systemic innovations feeding critical shifts</title>
    <desc>
      {innovations.length} systemic innovations connect through {shifts.length} critical shifts toward {bioregionName}'s overall regenerative change.
    </desc>

    <defs>
      <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#20404f" flood-opacity="0.08" />
      </filter>
    </defs>

    {/* SIS → CS lines */}
    {innovPositions.map((inv) =>
      inv.tags.map((tagSlug) => {
        const s = shiftBySlug.get(tagSlug);
        if (!s) return null;
        return (
          <path
            class={`conn conn-sis-cs conn-cs-${s.slug}`}
            data-cs={s.slug}
            data-sis={inv.slug}
            d={curve(sisX, inv.y, csX + csW, s.y)}
            fill="none"
            stroke={s.color}
            stroke-width="2.5"
            opacity="0.45"
          />
        );
      })
    )}

    {/* CS → Bioregion lines */}
    {shiftPositions.map((s) => {
      const count = innovations.filter((i) => i.tags.includes(s.slug)).length;
      const strength = count / maxLinked;
      return (
        <path
          class={`conn conn-cs-bio conn-cs-${s.slug}`}
          data-cs={s.slug}
          d={curve(csX, s.y, bioX + bioW / 2, bioBoxY)}
          fill="none"
          stroke={s.color}
          stroke-width={2 + strength * 5}
          opacity={0.35 + strength * 0.45}
        />
      );
    })}

    {/* Bioregion card: image strip on top, text below */}
    <rect
      x={bioX - bioW / 2}
      y={bioTop}
      width={bioW}
      height={bioH}
      rx="18"
      fill="var(--paper-raised)"
      stroke="var(--bwl-primary)"
      stroke-width="2"
      filter="url(#softShadow)"
    />
    {bioImageSrc && (
      <image
        x={bioX - bioW / 2}
        y={bioTop}
        width={bioW}
        height={bioImageH}
        href={bioImageSrc}
        clip-path="inset(0px round 18px 18px 0 0)"
        preserveAspectRatio="xMidYMid slice"
      />
    )}
    {/* Redraw the card border over the image edge */}
    <rect
      x={bioX - bioW / 2}
      y={bioTop}
      width={bioW}
      height={bioH}
      rx="18"
      fill="none"
      stroke="var(--bwl-primary)"
      stroke-width="2"
    />

    <SVGTextBlock
      lines={bioNameLines}
      x={bioTextX}
      y={bioNameStartY}
      lineHeight="1.2em"
      anchor="start"
      style={`font-family:var(--font-display);font-size:${bioNameFont}px;font-weight:bold;fill:var(--bwl-primary);`}
    />
    {bioCountryLines.length > 0 && (
      <SVGTextBlock
        lines={bioCountryLines}
        x={bioTextX}
        y={bioCountryStartY}
        lineHeight="1.2em"
        anchor="start"
        style={`font-family:var(--font-display);font-size:${bioCountryFont}px;font-weight:bold;fill:var(--bwl-secondary);letter-spacing:0.1em;text-transform:uppercase;`}
      />
    )}
    <SVGTextBlock
      lines={bioDescLines}
      x={bioTextX}
      y={bioDescStartY}
      lineHeight="1.3em"
      anchor="start"
      style={`font-family:var(--font-body);font-size:${bioDescFont}px;fill:var(--bwl-text);opacity:0.85;`}
    />

    {/* Critical Shifts */}
    {shiftPositions.map((s) => {
      const textHeight = s.nameLines.length * csNameLineHeight + 4 + s.leverageLines.length * csLeverageLineHeight;
      const nameY = s.y - textHeight / 2 + csNameLineHeight * 0.8;
      const leverageY = nameY + s.nameLines.length * csNameLineHeight + 4;
      return (
        <g class={`card cs-card cs-${s.slug}`} data-cs={s.slug} tabindex="0">
          <rect
            x={csX}
            y={s.y - s.cardHeight / 2}
            width={csW}
            height={s.cardHeight}
            rx="12"
            fill="var(--paper-raised)"
            stroke={s.color}
            stroke-width="2"
            filter="url(#softShadow)"
          />
          <SVGTextBlock
            lines={s.nameLines}
            x={csX + 24}
            y={nameY}
            lineHeight="1.2em"
            style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={s.leverageLines}
            x={csX + 24}
            y={leverageY}
            lineHeight="1.3em"
            style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
          />
        </g>
      );
    })}

    {/* Systemic Innovations */}
    {innovPositions.map((inv) => {
      const untagged = inv.tags.length === 0;
      const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
      const nameY = inv.y - inv.textHeight / 2 + sisNameLineHeight * 0.8;
      const descY = nameY + inv.nameLines.length * sisNameLineHeight + 4;
      const imgY = inv.y - inv.cardHeight / 2;
      return (
        <g
          class={`card sis-card sis-${inv.slug}`}
          data-sis={inv.slug}
          data-cs={inv.tags.join(" ")}
          tabindex="0"
        >
          <rect
            x={sisX}
            y={imgY}
            width={sisW}
            height={inv.cardHeight}
            rx="10"
            fill={untagged ? "var(--paper-raised)" : "#ffffff"}
            stroke={untagged ? "var(--bwl-muted)" : "var(--line-strong)"}
            stroke-width="1.5"
            stroke-dasharray={untagged ? "4,3" : "none"}
            filter="url(#softShadow)"
          />
          {sisImageSrc && (
            <image
              x={sisX}
              y={inv.y - inv.imgSide / 2}
              width={inv.imgSide}
              height={inv.imgSide}
              href={sisImageSrc}
              clip-path="inset(0px round 10px 0 0 10px)"
              preserveAspectRatio="xMidYMid slice"
            />
          )}
          {sisImageSrc && (
            <rect
              x={sisX}
              y={imgY}
              width={sisW}
              height={inv.cardHeight}
              rx="10"
              fill="none"
              stroke={untagged ? "var(--bwl-muted)" : "var(--line-strong)"}
              stroke-width="1.5"
              stroke-dasharray={untagged ? "4,3" : "none"}
            />
          )}
          <SVGTextBlock
            lines={inv.nameLines}
            x={inv.textX}
            y={nameY}
            lineHeight="1.15em"
            style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={inv.descLines}
            x={inv.textX}
            y={descY}
            lineHeight="1.3em"
            style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
          />
          {inv.notionUrl && (
            <a href={inv.notionUrl} target="_blank" rel="noopener">
              <g>
                <circle cx={sisX + sisW - 15} cy={inv.y + 22} r="8" fill="var(--bwl-secondary)" opacity="0.15" />
                <text
                  x={sisX + sisW - 15}
                  y={inv.y + 25}
                  text-anchor="middle"
                  font-size="10"
                  fill="var(--bwl-primary)"
                  font-family="var(--font-body)"
                  font-weight="bold"
                >↗</text>
              </g>
            </a>
          )}
        </g>
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    function activate(csSlug: string) {
      svg!.classList.add("has-active");
      svg!.querySelectorAll<SVGElement>(".card, .conn").forEach((el) => {
        const cs = el.dataset.cs;
        const match = cs === csSlug || (cs && cs.split(" ").includes(csSlug));
        el.classList.toggle("active", match);
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    svg.querySelectorAll<SVGGElement>(".cs-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activate(g.dataset.cs!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activate(g.dataset.cs!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activate(path.dataset.cs!));
      path.addEventListener("mouseleave", deactivate);
    });
  })();
</script>

<style>
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .flow-wrap svg {
    display: block;
    width: 100%;
    min-width: 600px;
    height: auto;
    max-width: 1600px;
    max-height: 92vh;
    margin: 0 auto;
    background: var(--paper);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
