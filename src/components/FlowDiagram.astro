---
import SVGTextBlock from "./SVGTextBlock.astro";

interface Shift {
  slug: string;
  name: string;
  emoji: string | null;
  shift: string;
  leveragePoint: string;
  systemicBarrier: string;
}

interface Innovation {
  slug: string;
  name: string;
  description: string;
  tags: string[];
  depth: string;
  notionUrl: string | null;
  imageUrl: string | null;
}

interface Props {
  shifts: Shift[];
  innovations: Innovation[];
  bioregionName: string;
  bioregionDescription: string;
  bioregionImageUrl?: string | null;
}

const {
  shifts,
  innovations,
  bioregionName,
  bioregionDescription,
  bioregionImageUrl = null,
} = Astro.props as Props;

const PALETTE = [
  "#20404F", // BWL primary
  "#E2AD4F", // BWL secondary
  "#5C8A7A", // muted teal
  "#C78A1D", // darker gold
  "#4A7C6F", // sage
  "#8B5A2B", // warm brown
  "#3D6B66", // deep sage
  "#D4A84B", // light gold
];

const width = 1000;
const margin = { top: 48, right: 48, bottom: 48, left: 48 };

const bioW = 170;
const bioX = margin.left + bioW / 2;
const csX = margin.left + bioW + 110;
const csW = 230;
const sisX = csX + csW + 110;
const sisW = 280;

const rowHeight = 72;
const csGap = 16;
const sisGap = 12;

const csHeight = shifts.length * rowHeight + (shifts.length - 1) * csGap;
const sisHeight = innovations.length * rowHeight + (innovations.length - 1) * sisGap;
const contentHeight = Math.max(csHeight, sisHeight);
const height = contentHeight + margin.top + margin.bottom + 32;

const bioY = height / 2;

function shorten(text: string, max: number) {
  return text.length > max ? text.slice(0, max - 1).trim() + "\u2026" : text;
}

function wrapLines(text: string, maxChars: number) {
  const words = text.split(" ");
  const lines: string[] = [];
  let current = "";
  for (const w of words) {
    if ((current + " " + w).trim().length > maxChars && current) {
      lines.push(current.trim());
      current = w;
    } else {
      current = (current + " " + w).trim();
    }
  }
  if (current) lines.push(current);
  return lines;
}

const bioNameLines = wrapLines(bioregionName, 16);
const bioDescLines = wrapLines(shorten(bioregionDescription || "", 80), 28).slice(0, 2);

const bioNameLineHeight = 19;
const bioDescLineHeight = 14;
const bioDescGap = 8;
const bioTextHeight =
  bioNameLines.length * bioNameLineHeight + bioDescGap + bioDescLines.length * bioDescLineHeight;
const bioH = Math.max(118, bioTextHeight + 44);

// Bioregion image sits above the bio box.
const bioImageW = 130;
const bioImageH = 88;
const bioImageGap = 16;
const bioBlockHeight = bioImageH + bioImageGap + bioH;
const bioImageY = bioY - bioBlockHeight / 2;
const bioBoxY = bioImageY + bioImageH + bioImageGap + bioH / 2;
const bioNameStartY = bioBoxY - bioTextHeight / 2 + bioNameLineHeight * 0.75;
const bioDescStartY = bioNameStartY + bioNameLines.length * bioNameLineHeight + bioDescGap;

const csStartY = (height - csHeight) / 2;
const sisStartY = (height - sisHeight) / 2;

const shiftPositions = shifts.map((s, i) => ({
  ...s,
  y: csStartY + i * (rowHeight + csGap) + rowHeight / 2,
  color: PALETTE[i % PALETTE.length],
}));

const shiftBySlug = new Map(shiftPositions.map((s) => [s.slug, s]));

const innovPositions = innovations.map((inv, i) => ({
  ...inv,
  y: sisStartY + i * (rowHeight + sisGap) + rowHeight / 2,
}));

const maxLinked = Math.max(
  ...shiftPositions.map((s) => innovations.filter((i) => i.tags.includes(s.slug)).length),
  1
);

function curve(x1: number, y1: number, x2: number, y2: number, strength = 0.5) {
  const dx = x2 - x1;
  const mx = x1 + dx * strength;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width="100%"
    height="auto"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Flow diagram of {bioregionName}'s systemic innovations feeding critical shifts</title>
    <desc>
      {innovations.length} systemic innovations connect through {shifts.length} critical shifts toward {bioregionName}'s overall regenerative change.
    </desc>

    <defs>
      <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#20404f" flood-opacity="0.08" />
      </filter>
      <clipPath id="sisImgClip">
        <rect width="44" height="44" rx="8" />
      </clipPath>
      <clipPath id="bioImgClip">
        <rect width={bioImageW} height={bioImageH} rx="16" />
      </clipPath>
    </defs>

    {/* SIS → CS lines */}
    {innovPositions.map((inv) =>
      inv.tags.map((tagSlug) => {
        const s = shiftBySlug.get(tagSlug);
        if (!s) return null;
        return (
          <path
            class={`conn conn-sis-cs conn-cs-${s.slug}`}
            data-cs={s.slug}
            data-sis={inv.slug}
            d={curve(sisX, inv.y, csX + csW, s.y)}
            fill="none"
            stroke={s.color}
            stroke-width="3"
            opacity="0.45"
          />
        );
      })
    )}

    {/* CS → Bioregion lines */}
    {shiftPositions.map((s) => {
      const count = innovations.filter((i) => i.tags.includes(s.slug)).length;
      const strength = count / maxLinked;
      return (
        <path
          class={`conn conn-cs-bio conn-cs-${s.slug}`}
          data-cs={s.slug}
          d={curve(csX, s.y, bioX + bioW / 2, bioBoxY)}
          fill="none"
          stroke={s.color}
          stroke-width={2.5 + strength * 5.5}
          opacity={0.35 + strength * 0.45}
        />
      );
    })}

    {/* Bioregion image (above the card) */}
    {bioregionImageUrl && (
      <image
        x={bioX - bioImageW / 2}
        y={bioImageY}
        width={bioImageW}
        height={bioImageH}
        href={bioregionImageUrl}
        clip-path="url(#bioImgClip)"
        preserveAspectRatio="xMidYMid slice"
      />
    )}

    {/* Bioregion rounded square */}
    <rect
      x={bioX - bioW / 2}
      y={bioBoxY - bioH / 2}
      width={bioW}
      height={bioH}
      rx="20"
      fill="var(--paper-raised)"
      stroke="var(--bwl-primary)"
      stroke-width="2"
      filter="url(#softShadow)"
    />
    <rect
      x={bioX - bioW / 2 + 6}
      y={bioBoxY - bioH / 2 + 6}
      width={bioW - 12}
      height={bioH - 12}
      rx="16"
      fill="none"
      stroke="var(--bwl-secondary)"
      stroke-width="1"
      opacity="0.35"
    />

    <SVGTextBlock
      lines={bioNameLines}
      x={bioX}
      y={bioNameStartY}
      lineHeight="1.25em"
      anchor="middle"
      style="font-family:var(--font-display);font-size:15px;font-weight:bold;fill:var(--bwl-primary);"
    />
    <SVGTextBlock
      lines={bioDescLines}
      x={bioX}
      y={bioDescStartY}
      lineHeight="1.35em"
      anchor="middle"
      style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
    />

    {/* Critical Shifts */}
    {shiftPositions.map((s) => {
      const emoji = s.emoji || "";
      const nameLines = wrapLines(shorten(`${emoji} ${s.name}`.trim(), 34), 24);
      const leverageLines = wrapLines(shorten(s.leveragePoint || "", 55), 32);
      const blockHeight = nameLines.length * 14.5 + 3 + leverageLines.length * 12.5;
      const nameY = s.y - blockHeight / 2 + 11;
      const leverageY = nameY + nameLines.length * 14.5 + 3;
      return (
        <g class={`card cs-card cs-${s.slug}`} data-cs={s.slug} tabindex="0">
          <rect
            x={csX}
            y={s.y - 30}
            width={csW}
            height="60"
            rx="30"
            fill="var(--paper-raised)"
            stroke={s.color}
            stroke-width="2"
            filter="url(#softShadow)"
          />
          <circle cx={csX + 24} cy={s.y} r="4" fill={s.color} />
          <SVGTextBlock
            lines={nameLines}
            x={csX + 42}
            y={nameY}
            lineHeight="1.2em"
            style="font-family:var(--font-display);font-size:12px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={leverageLines}
            x={csX + 42}
            y={leverageY}
            lineHeight="1.3em"
            style="font-family:var(--font-body);font-size:9.5px;fill:var(--bwl-text);opacity:0.85;"
          />
        </g>
      );
    })}

    {/* Systemic Innovations */}
    {innovPositions.map((inv) => {
      const untagged = inv.tags.length === 0;
      const nameLines = wrapLines(shorten(inv.name || "", 34), 24);
      const descLines = wrapLines(shorten(inv.description || "", 60), 34);
      const blockHeight = nameLines.length * 13.5 + 3 + descLines.length * 11.5;
      const nameY = inv.y - blockHeight / 2 + 10.5;
      const descY = nameY + nameLines.length * 13.5 + 3;
      const textX = sisX + 60;
      return (
        <g
          class={`card sis-card sis-${inv.slug}`}
          data-sis={inv.slug}
          data-cs={inv.tags.join(" ")}
          tabindex="0"
        >
          <rect
            x={sisX}
            y={inv.y - 30}
            width={sisW}
            height="60"
            rx="10"
            fill={untagged ? "var(--paper-raised)" : "#ffffff"}
            stroke={untagged ? "var(--bwl-muted)" : "var(--line-strong)"}
            stroke-width="1.5"
            stroke-dasharray={untagged ? "4,3" : "none"}
            filter="url(#softShadow)"
          />
          {inv.imageUrl && (
            <image
              x={sisX + 8}
              y={inv.y - 22}
              width="44"
              height="44"
              href={inv.imageUrl}
              clip-path="url(#sisImgClip)"
              preserveAspectRatio="xMidYMid slice"
            />
          )}
          <SVGTextBlock
            lines={nameLines}
            x={textX}
            y={nameY}
            lineHeight="1.2em"
            style="font-family:var(--font-display);font-size:11.5px;font-weight:bold;fill:var(--bwl-primary);"
          />
          <SVGTextBlock
            lines={descLines}
            x={textX}
            y={descY}
            lineHeight="1.3em"
            style="font-family:var(--font-body);font-size:9px;fill:var(--bwl-text);opacity:0.85;"
          />
          {inv.notionUrl && (
            <a href={inv.notionUrl} target="_blank" rel="noopener">
              <g>
                <circle cx={sisX + sisW - 15} cy={inv.y + 15} r="8" fill="var(--bwl-secondary)" opacity="0.15" />
                <text
                  x={sisX + sisW - 15}
                  y={inv.y + 18}
                  text-anchor="middle"
                  font-size="10"
                  fill="var(--bwl-primary)"
                  font-family="var(--font-body)"
                  font-weight="bold"
                >↗</text>
              </g>
            </a>
          )}
        </g>
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    function activate(csSlug: string) {
      svg!.classList.add("has-active");
      svg!.querySelectorAll<SVGElement>(".card, .conn").forEach((el) => {
        const cs = el.dataset.cs;
        const match = cs === csSlug || (cs && cs.split(" ").includes(csSlug));
        el.classList.toggle("active", match);
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    svg.querySelectorAll<SVGGElement>(".cs-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activate(g.dataset.cs!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activate(g.dataset.cs!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activate(path.dataset.cs!));
      path.addEventListener("mouseleave", deactivate);
    });
  })();
</script>

<style>
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .flow-wrap svg {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
    margin: 0 auto;
    background: var(--paper);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4.5px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
