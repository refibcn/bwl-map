---
import FlowCard from "./FlowCard.astro";
import { notionImageUrl } from "../lib/images";
import { wrapToWidth } from "../lib/text";
import { shiftColor } from "../lib/shift-pages";

interface Shift {
  slug: string;
  name: string;
  emoji: string | null;
  shift: string;
  leveragePoint: string;
  systemicBarrier: string;
}

interface Innovation {
  slug: string;
  name: string;
  description: string;
  tags: string[];
  depth: string;
  notionUrl: string | null;
  externalUrl: string | null;
  imageUrl: string | null;
  imageFile: string | null;
}

interface Props {
  shifts: Shift[];
  innovations: Innovation[];
  bioregionName: string;
  bioregionSlug: string;
  bioregionDescription: string;
  bioregionImageUrl?: string | null;
  bioregionImageFile?: string | null;
  bioregionCountry?: string | null;
}

const {
  shifts,
  innovations,
  bioregionName,
  bioregionSlug,
  bioregionDescription,
  bioregionImageUrl = null,
  bioregionImageFile = null,
  bioregionCountry = "",
} = Astro.props as Props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
function withBase(path: string | null): string | null {
  if (!path) return null;
  if (/^(https?:|data:)/i.test(path)) return path;
  if (base && base !== "/") return `${base}${path}`;
  return path;
}

// Prefer the build-time downloaded file (emitted by Vite into dist/_astro/);
// fall back to the original remote URL (fixture data, external links).
function resolveImageSource(
  file: string | null | undefined,
  url: string | null | undefined
): string | null {
  const local = notionImageUrl(file);
  if (local) return local;
  return withBase(url || null);
}

const COLUMN_GAP = 190; // space between the three columns
const margin = { top: 40, right: 150, bottom: 40, left: 150 };
const bioW = 320;
const csW = 200;
const sisW = 320;
// Total canvas width is derived from the parts, so tuning the gap or margins
// re-flows the whole diagram.
const width = margin.left + bioW + COLUMN_GAP + csW + COLUMN_GAP + sisW + margin.right;
const bioX = margin.left + bioW / 2;
const csX = margin.left + bioW + COLUMN_GAP;
const sisX = csX + csW + COLUMN_GAP;

// These line-heights only feed the sizing budget below now — text
// positioning inside the rendered card is plain CSS flexbox (FlowCard.astro).
const csNameLineHeight = 14;
const csLeverageLineHeight = 12;
const sisNameLineHeight = 14;
const sisDescLineHeight = 12;

// --- Bioregion card: image strip on top, title + country + description below ---
const bioImageH = 160; // full-width image strip on top (larger container, no white borders)
const bioNameFont = 18; // bigger title
const bioCountryFont = 10;
const bioDescFont = 9;
const bioImageSrc = resolveImageSource(bioregionImageFile, bioregionImageUrl);

// The card's box still has to be sized ahead of time (SVG has no
// auto-layout) — so we keep an ESTIMATED line count per field via
// wrapToWidth, but ONLY for that sizing budget. The text actually shown is
// the raw string, wrapped for real by the browser inside FlowCard, and
// capped at the same max-lines number via CSS line-clamp — so the box this
// produces is always a safe upper bound, never a cause of overflow, while
// each line itself now fills to its true available width.
const BIO_TEXT_INSET = 20;
const BIO_TEXT_PAD = 24; // vertical padding of the text section inside the card (roomier below the description)
const bioTextWidth = bioW - BIO_TEXT_INSET * 2;
const BIO_NAME_MAX_LINES = 2;
const BIO_COUNTRY_MAX_LINES = 1;
const BIO_DESC_MAX_LINES = 6;
const bioNameLineCount = Math.min(
  wrapToWidth(bioregionName || "", bioTextWidth, bioNameFont, "display").length,
  BIO_NAME_MAX_LINES
);
const bioCountryLineCount = bioregionCountry
  ? Math.min(wrapToWidth(bioregionCountry, bioTextWidth, bioCountryFont, "display").length, BIO_COUNTRY_MAX_LINES)
  : 0;
const bioDescLineCount = Math.min(
  wrapToWidth(bioregionDescription || "", bioTextWidth, bioDescFont, "body").length,
  BIO_DESC_MAX_LINES
);

const bioNameLineHeight = 21; // 18px display font
const bioCountryLineHeight = 12;
const bioDescLineHeight = 12;
const bioCountryGap = bioCountryLineCount ? 5 : 0;
const bioDescGap = bioDescLineCount ? 8 : 0;
const bioTextHeight =
  bioNameLineCount * bioNameLineHeight +
  bioCountryGap + bioCountryLineCount * bioCountryLineHeight +
  bioDescGap + bioDescLineCount * bioDescLineHeight;
const bioH = bioImageH + bioTextHeight + BIO_TEXT_PAD * 2;

const csGap = 16;
const sisGap = 16;

// Card height still has to be decided ahead of time (SVG has no
// auto-layout). The line count that budget is based on still comes from
// wrapToWidth — its word-boundary-aware wrap simulation is the only estimate
// here that's SAFE to build a height off (a naive "chars ÷ average width"
// division was tried and under-predicted real line counts, because real
// text wraps at word boundaries — less space-efficient than a flat
// character average — which caused actual overflow, not just wasted
// space). What wrapToWidth over-predicts, if anything, is a rare extra
// line for one string but not a very similar one, which is what made
// heights look inconsistent and content-unrelated before this. The fix for
// THAT is a STANDARD line count every card floors to by default (matching
// a typical card's real content) — only text long enough to genuinely need
// more than the standard grows the card past it.
function estimateLineCount(lines: string[], standardLines: number, maxLines: number): number {
  return Math.min(Math.max(standardLines, lines.length), maxLines);
}

// These two fields had no max-lines cap at all before this migration
// ("never truncated" — see the git history) — real names/leverage points
// are short enough in practice that it rarely mattered, but an unbounded
// field can't have a predictable card height, which every other field
// here relies on. Generous caps (ellipsis only if truly exceeded).
const CS_NAME_MAX_LINES = 3;
const CS_LEVERAGE_MAX_LINES = 5;
const CS_NAME_STANDARD_LINES = 2;
const CS_LEVERAGE_STANDARD_LINES = 3;

const csCards = shifts.map((s) => {
  const emoji = s.emoji || "";
  const nameLineCount = estimateLineCount(
    wrapToWidth(`${emoji} ${s.name}`.trim(), csW - 48, 12, "display"),
    CS_NAME_STANDARD_LINES,
    CS_NAME_MAX_LINES
  );
  const leverageLineCount = estimateLineCount(
    wrapToWidth(s.leveragePoint || "", csW - 48, 9.5, "body"),
    CS_LEVERAGE_STANDARD_LINES,
    CS_LEVERAGE_MAX_LINES
  );
  const textHeight = nameLineCount * csNameLineHeight + 4 + leverageLineCount * csLeverageLineHeight;
  const cardHeight = Math.max(64, textHeight + 32);
  return { ...s, nameLineCount, leverageLineCount, cardHeight, color: shiftColor(s.slug) };
});

// SIS cards: a FIXED image square on the left, so the text column keeps a
// stable width even with full descriptions (the previous square-=-card-height
// layout squeezed the text to nothing as cards grew). Cards size themselves
// to their content with the full database text.
const SIS_IMG = 150; // fixed square image side — also the card's min height,
// so a short-text card's image renders as a true square by default.
const SIS_TEXT_GAP = 18; // space between the image square and the text
const SIS_TEXT_RIGHT = 12; // space between the text and the card's right border
const SIS_MIN_IMG = 104; // minimum card height when there's no image at all
// Same "was never capped" situation as the cs-card fields above.
const SIS_NAME_MAX_LINES = 3;
const SIS_DESC_MAX_LINES = 6;
const SIS_NAME_STANDARD_LINES = 1;
const SIS_DESC_STANDARD_LINES = 3;
const sisCards: any[] = innovations.map((inv) => {
  const hasImage = !!resolveImageSource(inv.imageFile, inv.imageUrl);
  const leftInset = hasImage ? SIS_IMG + SIS_TEXT_GAP : 16;
  const textWidth = sisW - leftInset - SIS_TEXT_RIGHT;
  const nameLineCount = estimateLineCount(
    wrapToWidth(inv.name || "", textWidth, 12, "display"),
    SIS_NAME_STANDARD_LINES,
    SIS_NAME_MAX_LINES
  );
  const descLineCount = estimateLineCount(
    wrapToWidth(inv.description || "", textWidth, 9.5, "body"),
    SIS_DESC_STANDARD_LINES,
    SIS_DESC_MAX_LINES
  );
  const textHeight = nameLineCount * sisNameLineHeight + 4 + descLineCount * sisDescLineHeight;
  const cardHeight = Math.max(hasImage ? SIS_IMG : SIS_MIN_IMG, textHeight + 36);
  return { ...inv, hasImage, nameLineCount, descLineCount, textHeight, cardHeight };
});

const csHeight = csCards.reduce((sum, c, i) => sum + c.cardHeight + (i < csCards.length - 1 ? csGap : 0), 0);
const sisHeight = sisCards.reduce((sum, c, i) => sum + c.cardHeight + (i < sisCards.length - 1 ? sisGap : 0), 0);
// The canvas must always fit the bioregion card, even when a page has no
// shifts/innovations yet (otherwise the card overflows above the viewBox).
const contentHeight = Math.max(csHeight, sisHeight, bioH);
const height = contentHeight + margin.top + margin.bottom + 28;

const bioY = height / 2;
const bioTop = bioY - bioH / 2; // top of the card (and of the image strip)
const bioBoxY = bioY; // card vertical center (connector target)
// Text positioning inside the card is now plain CSS flexbox (see
// FlowCard.astro) — no manual per-line baseline math needed here anymore.

function stackPositions(cards: { cardHeight: number }[], startY: number, gap: number) {
  const positions: number[] = [];
  let y = startY;
  cards.forEach((c, i) => {
    positions.push(y + c.cardHeight / 2);
    y += c.cardHeight + gap;
  });
  return positions;
}

const csStartY = (height - csHeight) / 2;
const sisStartY = (height - sisHeight) / 2;

const csPositions = stackPositions(csCards, csStartY, csGap);
const sisPositions = stackPositions(sisCards, sisStartY, sisGap);

const shiftPositions = csCards.map((s, i) => ({ ...s, y: csPositions[i] }));
const innovPositions = sisCards.map((inv, i) => ({ ...inv, y: sisPositions[i] }));
// Positioned shifts (with y) so connector paths get real coordinates.
const shiftBySlug = new Map(shiftPositions.map((s) => [s.slug, s]));

const maxLinked = Math.max(
  ...shiftPositions.map((s) => innovations.filter((i) => i.tags.includes(s.slug)).length),
  1
);

function curve(x1: number, y1: number, x2: number, y2: number, strength = 0.5) {
  const dx = x2 - x1;
  const mx = x1 + dx * strength;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
}
---

<div class="flow-wrap">
  <svg
    width={width}
    height="auto"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Flow diagram of {bioregionName}'s systemic innovations feeding critical shifts</title>
    <desc>
      {innovations.length} systemic innovations connect through {shifts.length} critical shifts toward {bioregionName}'s overall regenerative change.
    </desc>

    {/* SIS → CS lines */}
    {innovPositions.map((inv) =>
      inv.tags.map((tagSlug) => {
        const s = shiftBySlug.get(tagSlug);
        if (!s) return null;
        return (
          <path
            class={`conn conn-sis-cs conn-cs-${s.slug}`}
            data-from={`sis:${inv.slug}`}
            data-to={`cs:${s.slug}`}
            d={curve(sisX, inv.y, csX + csW, s.y)}
            fill="none"
            stroke={s.color}
            stroke-width="2.5"
            opacity="0.45"
          />
        );
      })
    )}

    {/* CS → Bioregion lines */}
    {shiftPositions.map((s) => {
      const count = innovations.filter((i) => i.tags.includes(s.slug)).length;
      const strength = count / maxLinked;
      return (
        <path
          class={`conn conn-cs-bio conn-cs-${s.slug}`}
          data-from={`cs:${s.slug}`}
          data-to="bio"
          d={curve(csX, s.y, bioX + bioW / 2, bioBoxY)}
          fill="none"
          stroke={s.color}
          stroke-width={2 + strength * 5}
          opacity={0.35 + strength * 0.45}
        />
      );
    })}

    {/* Bioregion card: image strip on top, text below. This is the page's
        own subject, so it was never a link before — send it to the real
        bioregion page on the BWL website (external), same convention used
        for the systemic-innovation image links. */}
    <FlowCard
      x={bioX - bioW / 2}
      y={bioTop}
      width={bioW}
      height={bioH}
      kind="bio"
      imagePosition="top"
      imageSrc={bioImageSrc}
      imageSize={bioImageH}
      title={bioregionName}
      titleMaxLines={BIO_NAME_MAX_LINES}
      subtitle={bioregionCountry || null}
      subtitleMaxLines={BIO_COUNTRY_MAX_LINES}
      body={bioregionDescription}
      bodyMaxLines={BIO_DESC_MAX_LINES}
      href={`https://bioregionalweavinglabs.org/bioregions/${bioregionSlug}/`}
      external
      dataEl="bio"
      dataRoot
    />

    {/* Critical Shifts */}
    {shiftPositions.map((s) => (
      <FlowCard
        x={csX}
        y={s.y - s.cardHeight / 2}
        width={csW}
        height={s.cardHeight}
        kind="cs"
        imagePosition="none"
        title={`${s.emoji || ""} ${s.name}`.trim()}
        titleMaxLines={CS_NAME_MAX_LINES}
        body={s.leveragePoint || null}
        bodyMaxLines={CS_LEVERAGE_MAX_LINES}
        href={`${base}critical-shifts/${s.slug}/`}
        dataEl={`cs:${s.slug}`}
        borderColor={s.color}
      />
    ))}

    {/* Systemic Innovations — image + external-link badge share one
        clickable region (the whole image, not just the small badge), so
        there's a generous margin of error; the text below is deliberately
        NOT part of that link, matching how this card has always worked. */}
    {innovPositions.map((inv) => {
      const untagged = inv.tags.length === 0;
      const sisImageSrc = resolveImageSource(inv.imageFile, inv.imageUrl);
      return (
        <FlowCard
          x={sisX}
          y={inv.y - inv.cardHeight / 2}
          width={sisW}
          height={inv.cardHeight}
          kind="sis"
          imagePosition={sisImageSrc ? "left" : "none"}
          imageSrc={sisImageSrc}
          imageSize={SIS_IMG}
          imageHref={inv.externalUrl}
          imageExternal
          title={inv.name}
          titleMaxLines={SIS_NAME_MAX_LINES}
          body={inv.description || null}
          bodyMaxLines={SIS_DESC_MAX_LINES}
          dataEl={`sis:${inv.slug}`}
          borderColor={untagged ? "var(--bwl-muted)" : "var(--line-strong)"}
        />
      );
    })}
  </svg>
</div>

<script>
  (function () {
    const svg = document.querySelector<SVGSVGElement>(".flow-wrap svg");
    if (!svg) return;

    /**
     * Highlight one card plus everything directly connected to it (one hop):
     * a connector is active when BOTH its endpoints are highlighted, so
     * hovering any card lights up exactly its own connections and the cards
     * at the far end of each.
     */
    function activateEl(elId: string) {
      svg!.classList.add("has-active");
      const match = new Set([elId]);
      svg!.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
        const from = path.dataset.from;
        const to = path.dataset.to;
        if (from === elId || to === elId) {
          if (from) match.add(from);
          if (to) match.add(to);
        }
      });
      // Hovering a systemic innovation also highlights the diagram's root card
      // (the bioregion card here), so the innovation -> shift -> root chain
      // lights up end to end.
      if (elId.startsWith("sis:")) {
        const root = svg!.querySelector<HTMLElement>("[data-root]");
        if (root?.dataset.el) match.add(root.dataset.el);
      }
      // Cards are now real HTML elements (rendered via <foreignObject>, not
      // raw SVG <g>) — this selector still matches both them and the SVG
      // .conn <path> lines, so the type here covers both (plain `Element`
      // doesn't have `.dataset`, only the HTML/SVG-specific interfaces do).
      svg!.querySelectorAll<HTMLElement | SVGElement>(".card, .conn").forEach((el) => {
        if (el.classList.contains("conn")) {
          const from = el.dataset.from;
          const to = el.dataset.to;
          el.classList.toggle("active", !!from && !!to && match.has(from) && match.has(to));
        } else {
          el.classList.toggle("active", !!el.dataset.el && match.has(el.dataset.el));
        }
      });
    }

    function deactivate() {
      svg!.classList.remove("has-active");
      svg!.querySelectorAll<HTMLElement | SVGElement>(".active").forEach((el) => el.classList.remove("active"));
    }

    // Cards are real HTML (an <a> when the whole card links, a <div>
    // otherwise) rendered inside <foreignObject> — HTMLElement covers both.
    svg.querySelectorAll<HTMLElement>(".cs-card, .sis-card, .bio-card").forEach((g) => {
      g.addEventListener("mouseenter", () => activateEl(g.dataset.el!));
      g.addEventListener("mouseleave", deactivate);
      g.addEventListener("focus", () => activateEl(g.dataset.el!));
      g.addEventListener("blur", deactivate);
    });

    svg.querySelectorAll<SVGPathElement>(".conn").forEach((path) => {
      path.addEventListener("mouseenter", () => activateEl(path.dataset.from!));
      path.addEventListener("mouseleave", deactivate);
    });

    // On long pages the diagram is taller than the viewport: open with the
    // bioregion card vertically centred, so the top/bottom systemic
    // innovations are reachable by scrolling up/down.
    function centerOnBio() {
      const bio = svg!.querySelector<HTMLElement>(".bio-card");
      if (!bio) return;
      const r = bio.getBoundingClientRect();
      const y = window.scrollY + r.top - (window.innerHeight - r.height) / 2;
      window.scrollTo(0, Math.max(0, y));
    }
    if (document.readyState === "complete") requestAnimationFrame(centerOnBio);
    else window.addEventListener("load", () => requestAnimationFrame(centerOnBio));
  })();
</script>

<style is:global>
  /* is:global (not scoped): the .card elements this CSS targets are now
     rendered by the separate FlowCard.astro component (inside a
     <foreignObject>), so they carry FlowCard's own scoping attribute, not
     this file's — a normal scoped selector here would silently never match
     them, the same class of bug already hit once this session with
     MapLibre's JS-created markers needing is:global for the same reason. */
  .flow-wrap {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* short diagrams (few cards) are centred vertically on the page */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flow-wrap svg {
    display: block;
    width: auto; /* fixed px width from the width attribute: browser zoom scales it */
    height: auto;
    margin: 0 auto;
    background: var(--paper-raised);
  }

  .flow-wrap svg .conn {
    transition: opacity 0.25s ease, stroke-width 0.25s ease;
    cursor: pointer;
  }
  .flow-wrap svg .card {
    transition: opacity 0.25s ease;
  }
  .flow-wrap svg .card:focus {
    outline: none;
  }

  .flow-wrap svg.has-active .conn:not(.active) {
    opacity: 0.08 !important;
  }
  .flow-wrap svg.has-active .card:not(.active) {
    opacity: 0.25;
  }

  .flow-wrap svg.has-active .conn.active {
    opacity: 0.95 !important;
    stroke-width: 4px;
  }
  .flow-wrap svg.has-active .card.active {
    opacity: 1;
  }
</style>
